msgstr "Launching Counter-Strike 2 via Steam with optimized profile..."

msgid "CENTRAL DE OTIMIZAÇÕES"
msgstr "OPTIMIZATIONS CENTER"

msgid "Afinidade CPU"
msgstr "CPU Affinity"

msgid "Afinidade de CPU: Desativa o Núcleo 0 para o CS2 mitigando interrupções do SO."
msgstr "CPU Affinity: Disables Core 0 for CS2 mitigating OS interrupts."

msgid "Temporizador do Sistema: Define resolução de alta precisão de 0.5ms."
msgstr "System Timer: Sets high precision resolution to 0.5ms."

msgid "Timer: Restaurado ao padrão do Windows."
msgstr "Timer: Restored to Windows default."

msgid "Prioridade de Processo: Eleva a prioridade do executável cs2.exe para Tempo Real."
msgstr "Process Priority: Sets cs2.exe executable priority to Realtime."

msgid "Empty Standby List: Libera páginas de cache em standby na memória RAM."
msgstr "Empty Standby List: Clears standby cache pages in RAM."

msgid "GPU Apps Off"
msgstr "GPU Apps Off"

msgid "VRAM & Apps"
msgstr "VRAM & Apps"

msgid "Aceleração GPU: Desativa aceleração de hardware em Discord, Steam e navegadores."
msgstr "GPU Acceleration: Disables hardware acceleration in Discord, Steam and browsers."

msgid "GPU em apps desativada (mais VRAM para CS2)."
msgstr "GPU in apps disabled (more VRAM for CS2)."

msgid "GPU em apps reativada."
msgstr "GPU in apps re-enabled."

msgid "Otimização DPI"
msgstr "DPI Optimization"

msgid "Tela Cheia CS2"
msgstr "Fullscreen CS2"

msgid "Otimização DPI: Aplica flags de tela cheia exclusiva e reduz input lag no CS2."
msgstr "DPI Optimization: Applies exclusive fullscreen flags and reduces CS2 input lag."

msgid "DPI & Tela cheia: Flags de baixa latência aplicadas."
msgstr "DPI & Fullscreen: Low latency flags applied."

msgid "DPI: Configuração de compatibilidade removida."
msgstr "DPI: Compatibility configuration removed."

msgid "Compactar RAM"
msgstr "Compress RAM"

msgid "MMAgent Off"
msgstr "MMAgent Off"

