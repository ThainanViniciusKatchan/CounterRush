msgstr "Power Saving: Disables PCIe ASPM and USB selective suspend."

msgid "Economia de energia desativada (PCIe ASPM e Suspensão USB)."
msgstr "Power saving disabled (PCIe ASPM and USB Suspend)."

msgid "Economia de energia restaurada ao padrão."
msgstr "Power saving restored to default."

msgid "Render Queue"
msgstr "Render Queue"

msgid "Flip & Persist"
msgstr "Flip & Persist"

