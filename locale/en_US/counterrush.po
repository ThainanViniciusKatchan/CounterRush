msgstr "MMCSS: Gaming profile optimized in Windows registry."

msgid "MMCSS: Restaurado ao padrão do Windows."
msgstr "MMCSS: Restored to Windows default."

msgid "HPET Off"
msgstr "HPET Off"

msgid "Timer BCD"
msgstr "BCD Timer"

msgid "Desativar HPET: Desativa o relógio de plataforma no BCD priorizando o TSC da CPU."
msgstr "Disable HPET: Disables platform clock in BCD prioritizing CPU TSC."

msgid "HPET desativado no BCD (usando TSC da CPU)."
msgstr "HPET disabled in BCD (using CPU TSC)."

msgid "HPET restaurado ao padrão de boot."
msgstr "HPET restored to boot default."

msgid "Game Bar Off"
