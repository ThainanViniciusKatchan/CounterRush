msgid "Modo MSI ativado para GPU (Alta prioridade), Rede e USB."
msgstr "MSI Mode enabled for GPU (High priority), Network and USB."

msgid "Modo MSI desativado (retornado para INTx)."
msgstr "MSI Mode disabled (returned to INTx)."

msgid "Power Save Off"
msgstr "Power Save Off"

msgid "PCIe & USB"
msgstr "PCIe & USB"

