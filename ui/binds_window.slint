import { ScrollView } from "std-widgets.slint";
import { CS2Theme } from "theme.slint";

export struct BindCatalogRow {
    // 0 = Categoria, 1 = Subcategoria, 2 = Comando com checkbox
    row-kind: int,
    command-index: int,
    title: string,
    subtitle: string,
    command-value: string,
    checked: bool,
}

component VectorCheckmark inherits Rectangle {
    in property <bool> checked: false;

    width: 16px;
    height: 16px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.checked ? CS2Theme.accent-ct-blue : CS2Theme.border-hover;
    background: root.checked ? CS2Theme.accent-ct-blue : CS2Theme.bg-main;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    if root.checked : Path {
        width: 10px;
        height: 8px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        viewbox-width: 12;
        viewbox-height: 10;
        stroke: #ffffff;
        stroke-width: 2.2px;
        commands: "M 1.5 5.2 L 4.6 8.3 L 10.5 1.8";
    }
}

