import { ScrollView } from "std-widgets.slint";
import { CS2Theme } from "theme.slint";
import { BindCommandCard } from "components/bind_command_card.slint";

export struct BindCategoryTab {
    index: int,
    tab-label: string,
    title: string,
    subtitle: string,
    total-count: int,
    selected-count: int,
    match-count: int,
}

export struct BindCatalogRow {
    // 0 = Categoria, 1 = Subcategoria, 2 = Comando em lista, 3 = Par de comandos em grade
    row-kind: int,
    command-index: int,
    title: string,
    subtitle: string,
    command-value: string,
    checked: bool,
    has-second: bool,
    second-command-index: int,
    second-title: string,
    second-subtitle: string,
    second-command-value: string,
    second-checked: bool,
}

export component BindsTestWindow inherits Window {
    title: "CounterRush — Configuração de Binds CS2 (Janela Isolada de Testes)";
    icon: @image-url("assets/icons/cfg.svg");
    min-width: 960px;
    preferred-width: 1120px;
    min-height: 620px;
    preferred-height: 740px;
    background: CS2Theme.bg-main;

    // Estado da barra superior fixa
    in-out property <string> file-name-input: "";
    in-out property <string> selected-existing-file: "";
    in-out property <[string]> existing-cfg-files: ["autoexec.cfg", "meuexec.cfg"];
    in-out property <bool> selector-dropdown-open: false;
    in-out property <string> bound-key: "";
    in-out property <bool> is-listening-key: false;
    in-out property <string> save-mode-badge: "NOVO ARQUIVO";
    in-out property <bool> is-creating-new-file: true;

    // Estado da listagem, navegação, visualização, pesquisa e prévia
    in-out property <bool> backend-connected: false;
    in-out property <int> active-category-index: 1;
    in-out property <bool> is-grid-view: false;
    in-out property <string> search-query: "";
    in-out property <int> filtered-commands-count: 5;
    in-out property <int> selected-commands-count: 0;
    in-out property <string> bind-preview-line: "";
    in-out property <string> status-message: "Selecione ou digite um arquivo .cfg, capture uma tecla e marque os comandos desejados.";
    in-out property <string> status-kind: "info";
    in-out property <bool> show-conflict-prompt: false;
    in-out property <string> conflict-message: "";

    in-out property <[BindCategoryTab]> category-tabs: [
        { index: 0, tab-label: "Movimentação", title: "1. Movimentação", subtitle: "Deslocamento, saltos, postura e controle de câmera (Source 2)", total-count: 13, selected-count: 0, match-count: 0 },
        { index: 1, tab-label: "Treinamento", title: "2. Treinamento", subtitle: "Exigem sv_cheats 1", total-count: 23, selected-count: 0, match-count: 0 },
        { index: 2, tab-label: "Jogabilidade", title: "3. Jogabilidade", subtitle: "Permitidos em partidas competitivas", total-count: 18, selected-count: 0, match-count: 0 },
        { index: 3, tab-label: "Comunicação", title: "4. Comunicação", subtitle: "Voz, clutch binds, pings 3D, rodas e rádio", total-count: 33, selected-count: 0, match-count: 0 },
        { index: 4, tab-label: "Armas e Granadas", title: "5. Armas e Granadas", subtitle: "Seleção via slots e compras rápidas Source 2", total-count: 64, selected-count: 0, match-count: 0 },
        { index: 5, tab-label: "Monitoramento", title: "6. Monitoramento (FPS, Telemetria e Rede)", subtitle: "Telemetria nativa do HUD CS2 e diagnósticos", total-count: 10, selected-count: 0, match-count: 0 },
        { index: 6, tab-label: "Outros", title: "7. Outros (Áudio, Demos/Replays, HUD e Sistema)", subtitle: "Som, análise de demos GOTV, HUD e manutenção", total-count: 25, selected-count: 0, match-count: 0 },
    ];

    in-out property <[BindCatalogRow]> catalog-rows: [
        { row-kind: 0, command-index: -1, title: "2. Treinamento", subtitle: "Exigem sv_cheats 1", command-value: "", checked: false, has-second: false, second-command-index: -1, second-title: "", second-subtitle: "", second-command-value: "", second-checked: false },
        { row-kind: 1, command-index: -1, title: "Movimentação Livre e Teleporte de Precisão", subtitle: "", command-value: "", checked: false, has-second: false, second-command-index: -1, second-title: "", second-subtitle: "", second-command-value: "", second-checked: false },
        { row-kind: 2, command-index: 13, title: "noclip", subtitle: "Liga/desliga o voo livre atravessando paredes e objetos.", command-value: "noclip", checked: false, has-second: false, second-command-index: -1, second-title: "", second-subtitle: "", second-command-value: "", second-checked: false },
        { row-kind: 2, command-index: 14, title: "getpos", subtitle: "Imprime no console as coordenadas exatas (setpos e setang) da posição e mira atuais.", command-value: "getpos", checked: false, has-second: false, second-command-index: -1, second-title: "", second-subtitle: "", second-command-value: "", second-checked: false },
        { row-kind: 1, command-index: -1, title: "Treino Avançado de Granadas", subtitle: "", command-value: "", checked: false, has-second: false, second-command-index: -1, second-title: "", second-subtitle: "", second-command-value: "", second-checked: false },
        { row-kind: 2, command-index: 16, title: "sv_rethrow_last_grenade", subtitle: "Arremessa novamente a última granada jogada no servidor.", command-value: "sv_rethrow_last_grenade", checked: false, has-second: false, second-command-index: -1, second-title: "", second-subtitle: "", second-command-value: "", second-checked: false },
        { row-kind: 2, command-index: 19, title: "ent_fire smokegrenade_projectile kill; ent_fire molotov_projectile kill; ent_fire inferno kill; ent_fire flashbang_projectile kill; ent_fire hegrenade_projectile kill; ent_fire decoy_projectile kill; stopsound", subtitle: "Apaga instantaneamente todas as smokes, Molotovs, granadas no ar e corta efeitos sonoros ativos.", command-value: "ent_fire smokegrenade_projectile kill; ent_fire molotov_projectile kill; ent_fire inferno kill; ent_fire flashbang_projectile kill; ent_fire hegrenade_projectile kill; ent_fire decoy_projectile kill; stopsound", checked: false, has-second: false, second-command-index: -1, second-title: "", second-subtitle: "", second-command-value: "", second-checked: false },
        { row-kind: 2, command-index: 20, title: "bot_place", subtitle: "Posiciona um bot imediatamente no local onde sua mira aponta.", command-value: "bot_place", checked: false, has-second: false, second-command-index: -1, second-title: "", second-subtitle: "", second-command-value: "", second-checked: false },
    ];

    // Callbacks para integração com o backend Rust
    pure callback resolve-cs2-key(string) -> string;
    callback existing-file-selected(string);
    callback file-name-edited(string);
    callback key-captured(string);
    callback category-tab-selected(int);
    callback view-mode-changed(bool);
    callback search-query-changed(string);
    callback command-toggled(int, bool);
    callback clear-selected-commands();
    callback save-bind-clicked();
    callback confirm-conflict-overwrite();
    callback cancel-conflict-overwrite();

    // Função dedicada de ativação da escuta da próxima tecla
    public function activate-key-listener() {
        root.selector-dropdown-open = false;
        root.show-conflict-prompt = false;
        root.is-listening-key = true;
        key-listener-scope.focus();
    }

    pure function fallback-resolve-key(text: string) -> string {
        if text == Key.Space || text == " " {
            return "space";
        }
        if text == Key.Return {
            return "enter";
        }
        if text == Key.Escape {
            return "escape";
        }
        if text == Key.Tab {
            return "tab";
        }
        if text == Key.Backspace {
            return "backspace";
        }
        if text == Key.Delete {
            return "del";
        }
        if text == Key.Insert {
            return "ins";
        }
        if text == Key.Home {
            return "home";
        }
        if text == Key.End {
            return "end";
        }
        if text == Key.PageUp {
            return "pgup";
        }
        if text == Key.PageDown {
            return "pgdn";
        }
        if text == Key.UpArrow {
            return "uparrow";
        }
        if text == Key.DownArrow {
            return "downarrow";
        }
        if text == Key.LeftArrow {
            return "leftarrow";
        }
        if text == Key.RightArrow {
            return "rightarrow";
        }
        if text == Key.Shift {
            return "shift";
        }
        if text == Key.ShiftR {
            return "rshift";
        }
        if text == Key.Control {
            return "ctrl";
        }
        if text == Key.ControlR {
            return "rctrl";
        }
        if text == Key.Alt {
            return "alt";
        }
        if text == Key.AltGr {
            return "ralt";
        }
        if text == Key.CapsLock {
            return "capslock";
        }
        if text == Key.F1 { return "f1"; }
        if text == Key.F2 { return "f2"; }
        if text == Key.F3 { return "f3"; }
        if text == Key.F4 { return "f4"; }
        if text == Key.F5 { return "f5"; }
        if text == Key.F6 { return "f6"; }
        if text == Key.F7 { return "f7"; }
        if text == Key.F8 { return "f8"; }
        if text == Key.F9 { return "f9"; }
        if text == Key.F10 { return "f10"; }
        if text == Key.F11 { return "f11"; }
        if text == Key.F12 { return "f12"; }
        if text == ";" {
            return "semicolon";
        }
        if text == "" || text == "\"" {
            return "";
        }
        return text;
    }

    function apply-captured-key(key-name: string) {
        root.bound-key = key-name;
        root.is-listening-key = false;
        root.key-captured(root.bound-key);
    }

    function sync-local-save-mode() {
        if root.selected-existing-file == "" {
            root.is-creating-new-file = true;
            root.save-mode-badge = "NOVO ARQUIVO";
        } else if root.file-name-input == "" {
            root.is-creating-new-file = true;
            root.save-mode-badge = "DIGITE O NOME";
        } else if root.file-name-input == root.selected-existing-file {
            root.is-creating-new-file = false;
            root.save-mode-badge = "ATUALIZAR ATUAL";
        } else {
            root.is-creating-new-file = true;
            root.save-mode-badge = "CRIAR NOVO";
        }
    }

    // Função dedicada que escuta e associa automaticamente a próxima tecla pressionada
    function capture-next-key(event: KeyEvent) -> EventResult {
        if !root.is-listening-key {
            return reject;
        }

        let mapped-from-backend = root.resolve-cs2-key(event.text);
        let mapped-key = mapped-from-backend != "" ? mapped-from-backend : root.fallback-resolve-key(event.text);
        if mapped-key == "" {
            return accept;
        }

        root.apply-captured-key(mapped-key);
        return accept;
    }

    VerticalLayout {
        // =====================================================================
        // 1. BARRA SUPERIOR FIXA (HEADER)
        // =====================================================================
        Rectangle {
            background: CS2Theme.bg-surface;

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 12px;
                spacing: 10px;

                // Linha superior: título enxuto + badge de ambiente isolado
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;

                        Image {
                            source: @image-url("assets/icons/cfg.svg");
                            width: 18px;
                            height: 18px;
                            colorize: CS2Theme.accent-ct-cyan;
                            y: (parent.height - self.height) / 2;
                        }

                        Text {
                            text: "GERADOR DE BINDS CS2";
                            font-size: 14px;
                            font-weight: 900;
                            letter-spacing: 0.7px;
                            color: CS2Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: CS2Theme.radius-xs;
                        background: CS2Theme.accent-ct-soft;
                        border-width: 1px;
                        border-color: CS2Theme.border-accent-cyan;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "JANELA ISOLADA DE TESTES";
                                font-size: 9px;
                                font-weight: 800;
                                letter-spacing: 0.6px;
                                color: CS2Theme.text-cyan;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Controles do Header lado a lado
                HorizontalLayout {
                    spacing: 10px;

                    // 1.1 Input Fixo para Nome do Arquivo (.cfg)
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 2;
                        min-width: 220px;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "ARQUIVO (.CFG)";
                                font-size: 10px;
                                font-weight: 800;
                                letter-spacing: 0.5px;
                                color: CS2Theme.text-muted;
                            }

                            Rectangle {
                                height: 15px;
                                border-radius: CS2Theme.radius-xs;
                                background: root.is-creating-new-file ? CS2Theme.accent-t-soft : CS2Theme.accent-ct-soft;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: root.save-mode-badge;
                                        font-size: 8px;
                                        font-weight: 900;
                                        letter-spacing: 0.5px;
                                        color: root.is-creating-new-file ? CS2Theme.text-gold : CS2Theme.text-cyan;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            background: CS2Theme.bg-main;
                            border-radius: CS2Theme.radius-sm;
                            border-width: file-name-field.has-focus ? 2px : 1px;
                            border-color: file-name-field.has-focus ? CS2Theme.accent-ct-cyan : CS2Theme.border;
                            animate border-color { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;

                                file-name-field := TextInput {
                                    text <=> root.file-name-input;
                                    color: CS2Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    edited => {
                                        root.show-conflict-prompt = false;
                                        root.sync-local-save-mode();
                                        root.file-name-edited(self.text);
                                    }
                                }
                            }

                            if root.file-name-input == "" : Text {
                                x: 10px;
                                y: (parent.height - self.height) / 2;
                                text: "Digite um nome (ex: minhas_binds.cfg)";
                                color: CS2Theme.text-muted;
                                font-size: 11px;
                                opacity: 0.75;
                            }
                        }
                    }

                    // 1.2 Seletor de Arquivo Existente (lado a lado com o Input)
                    VerticalLayout {
                        spacing: 4px;
                        width: 215px;

                        Text {
                            text: "CARREGAR EXISTENTE";
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            color: CS2Theme.text-muted;
                        }

                        selector-anchor := Rectangle {
                            height: 36px;
                            background: selector-touch.has-hover || root.selector-dropdown-open ? CS2Theme.bg-card-hover : CS2Theme.bg-main;
                            border-radius: CS2Theme.radius-sm;
                            border-width: root.selector-dropdown-open ? 2px : 1px;
                            border-color: root.selector-dropdown-open ? CS2Theme.accent-ct-cyan : (selector-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border);
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: space-between;

                                Text {
                                    text: root.selected-existing-file != "" ? root.selected-existing-file : "Selecionar .cfg...";
                                    font-size: 12px;
                                    font-weight: root.selected-existing-file != "" ? 700 : 500;
                                    color: root.selected-existing-file != "" ? CS2Theme.text-primary : CS2Theme.text-muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 10px;
                                        height: 6px;
                                        viewbox-width: 10;
                                        viewbox-height: 6;
                                        stroke: root.selector-dropdown-open ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                        stroke-width: 1.8px;
                                        commands: root.selector-dropdown-open ? "M 1 5 L 5 1 L 9 5" : "M 1 1 L 5 5 L 9 1";
                                    }
                                }
                            }

                            selector-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.is-listening-key = false;
                                    root.selector-dropdown-open = !root.selector-dropdown-open;
                                }
                            }
                        }
                    }

                    // 1.3 Captura de Tecla (Key Listener) ao lado do bloco de arquivo
                    VerticalLayout {
                        spacing: 4px;
                        width: 235px;

                        Text {
                            text: "TECLA DA BIND (KEY LISTENER)";
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            color: root.is-listening-key ? CS2Theme.text-cyan : CS2Theme.text-muted;
                        }

                        key-listener-box := Rectangle {
                            height: 36px;
                            background: root.is-listening-key
                                ? CS2Theme.accent-ct-soft
                                : (key-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-main);
                            border-radius: CS2Theme.radius-sm;
                            border-width: root.is-listening-key ? 2px : 1px;
                            border-color: root.is-listening-key
                                ? CS2Theme.accent-ct-cyan
                                : (root.bound-key != "" ? CS2Theme.accent-ct-blue : (key-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border));
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            key-listener-scope := FocusScope {
                                changed has-focus => {
                                    if !self.has-focus && root.is-listening-key {
                                        root.is-listening-key = false;
                                    }
                                }
                                key-pressed(event) => {
                                    return root.capture-next-key(event);
                                }
                            }

                            key-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.activate-key-listener();
                                }
                                pointer-event(ev) => {
                                    if root.is-listening-key && ev.kind == PointerEventKind.down {
                                        if ev.button == PointerEventButton.right {
                                            root.apply-captured-key("mouse2");
                                        } else if ev.button == PointerEventButton.middle {
                                            root.apply-captured-key("mouse3");
                                        } else if ev.button == PointerEventButton.back {
                                            root.apply-captured-key("mouse4");
                                        } else if ev.button == PointerEventButton.forward {
                                            root.apply-captured-key("mouse5");
                                        }
                                    }
                                }
                                scroll-event(ev) => {
                                    if root.is-listening-key {
                                        if ev.delta-y > 0px {
                                            root.apply-captured-key("mwheelup");
                                            return accept;
                                        } else if ev.delta-y < 0px {
                                            root.apply-captured-key("mwheeldown");
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    horizontal-stretch: 1;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            border-radius: 3.5px;
                                            background: root.is-listening-key
                                                ? CS2Theme.accent-ct-cyan
                                                : (root.bound-key != "" ? CS2Theme.status-success : CS2Theme.text-dim);
                                        }
                                    }

                                    Text {
                                        text: root.is-listening-key
                                            ? "Pressione uma tecla..."
                                            : (root.bound-key != "" ? root.bound-key : "Clique p/ capturar tecla");
                                        font-size: 12px;
                                        font-weight: root.is-listening-key || root.bound-key != "" ? 800 : 500;
                                        color: root.is-listening-key
                                            ? CS2Theme.text-cyan
                                            : (root.bound-key != "" ? CS2Theme.text-primary : CS2Theme.text-muted);
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }

                                if root.bound-key != "" && !root.is-listening-key : Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: CS2Theme.radius-xs;
                                    background: clear-key-touch.has-hover ? CS2Theme.bg-card-selected : transparent;

                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-width: 10;
                                        viewbox-height: 10;
                                        stroke: clear-key-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted;
                                        stroke-width: 1.8px;
                                        commands: "M 1.5 1.5 L 8.5 8.5 M 8.5 1.5 L 1.5 8.5";
                                    }

                                    clear-key-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.bound-key = "";
                                            root.key-captured("");
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 1.4 Botão de Ação Salvar Bind
                    VerticalLayout {
                        spacing: 4px;
                        width: 185px;

                        Text {
                            text: "AÇÃO";
                            font-size: 10px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            color: CS2Theme.text-muted;
                        }

                        Rectangle {
                            height: 36px;
                            background: save-touch.has-hover ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange;
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: save-touch.has-hover ? #fb923c : #c2410c;
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: center;

                                Image {
                                    source: @image-url("assets/icons/save.svg");
                                    width: 15px;
                                    height: 15px;
                                    colorize: #ffffff;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: root.selected-commands-count > 0
                                        ? "SALVAR BIND (" + root.selected-commands-count + ")"
                                        : "SALVAR BIND";
                                    font-size: 11px;
                                    font-weight: 900;
                                    letter-spacing: 0.6px;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }

                            save-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selector-dropdown-open = false;
                                    root.is-listening-key = false;
                                    root.save-bind-clicked();
                                }
                            }
                        }
                    }
                }

                // Linha secundária: Prévia em tempo real da bind + Status / Ação limpar seleção
                HorizontalLayout {
                    spacing: 12px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: root.status-kind == "success"
                                    ? CS2Theme.status-success
                                    : (root.status-kind == "warning"
                                        ? CS2Theme.accent-t-gold
                                        : (root.status-kind == "error" ? CS2Theme.status-danger : CS2Theme.accent-ct-cyan));
                            }
                        }

                        Text {
                            text: root.bind-preview-line != "" && root.status-kind == "info"
                                ? "Prévia: " + root.bind-preview-line
                                : root.status-message;
                            font-size: 11px;
                            font-weight: 600;
                            color: root.status-kind == "success"
                                ? CS2Theme.text-green
                                : (root.status-kind == "warning"
                                    ? CS2Theme.text-gold
                                    : (root.status-kind == "error" ? CS2Theme.status-danger : CS2Theme.text-muted));
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                    }

                    if root.selected-commands-count > 0 : Rectangle {
                        height: 22px;
                        border-radius: CS2Theme.radius-xs;
                        background: clear-cmds-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-main;
                        border-width: 1px;
                        border-color: clear-cmds-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "Limpar marcados (" + root.selected-commands-count + ")";
                                font-size: 10px;
                                font-weight: 700;
                                color: CS2Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        clear-cmds-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-commands-count = 0;
                                root.clear-selected-commands();
                            }
                        }
                    }
                }

                // Confirmação inline quando a tecla já existe no arquivo selecionado
                if root.show-conflict-prompt : Rectangle {
                    background: CS2Theme.accent-t-soft;
                    border-radius: CS2Theme.radius-sm;
                    border-width: 1px;
                    border-color: CS2Theme.accent-t-gold;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: root.conflict-message;
                            font-size: 11px;
                            font-weight: 700;
                            color: CS2Theme.text-primary;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            Rectangle {
                                height: 28px;
                                background: conflict-cancel-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-main;
                                border-radius: CS2Theme.radius-xs;
                                border-width: 1px;
                                border-color: CS2Theme.border-hover;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: "CANCELAR";
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: CS2Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }

                                conflict-cancel-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-conflict-prompt = false;
                                        root.cancel-conflict-overwrite();
                                    }
                                }
                            }

                            Rectangle {
                                height: 28px;
                                background: conflict-ok-touch.has-hover ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange;
                                border-radius: CS2Theme.radius-xs;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: "SUBSTITUIR TECLA";
                                        font-size: 10px;
                                        font-weight: 900;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                conflict-ok-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.show-conflict-prompt = false;
                                        root.confirm-conflict-overwrite();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Separador estrutural do Header Fixo
        Rectangle {
            height: 1px;
            background: CS2Theme.border;
        }

        // =====================================================================
        // 2. PESQUISA, VISUALIZAÇÃO (LISTA/GRADE) E ABAS DE CATEGORIAS
        // =====================================================================
        Rectangle {
            background: CS2Theme.bg-surface;

            VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 10px;
                padding-bottom: 0px;
                spacing: 10px;

                // Barra de ferramentas: Pesquisa + Alternador Lista/Grade
                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        horizontal-stretch: 1;
                        height: 34px;
                        background: CS2Theme.bg-main;
                        border-radius: CS2Theme.radius-sm;
                        border-width: search-field.has-focus ? 2px : 1px;
                        border-color: search-field.has-focus
                            ? CS2Theme.accent-ct-cyan
                            : (root.search-query != "" ? CS2Theme.accent-ct-blue : CS2Theme.border);
                        animate border-color { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;

                                Path {
                                    width: 14px;
                                    height: 14px;
                                    viewbox-width: 16;
                                    viewbox-height: 16;
                                    stroke: search-field.has-focus || root.search-query != ""
                                        ? CS2Theme.accent-ct-cyan
                                        : CS2Theme.text-muted;
                                    stroke-width: 1.7px;
                                    commands: "M 6.5 2 C 8.984 2 11 4.016 11 6.5 C 11 8.984 8.984 11 6.5 11 C 4.016 11 2 8.984 2 6.5 C 2 4.016 4.016 2 6.5 2 M 9.8 9.8 L 14 14";
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;

                                search-field := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    text <=> root.search-query;
                                    color: CS2Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    edited => {
                                        root.is-listening-key = false;
                                        root.selector-dropdown-open = false;
                                        catalog-scroll.content-y = 0px;
                                        root.search-query-changed(self.text);
                                    }
                                }

                                if root.search-query == "" : Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Pesquisar por comando ou descrição (ex: smoke, radar, +jump)...";
                                    color: CS2Theme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if root.search-query != "" : Text {
                                text: root.filtered-commands-count + (root.filtered-commands-count == 1 ? " resultado" : " resultados");
                                font-size: 10px;
                                font-weight: 700;
                                color: CS2Theme.text-cyan;
                                vertical-alignment: center;
                            }

                            if root.search-query != "" : Rectangle {
                                width: 22px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                border-radius: CS2Theme.radius-xs;
                                background: search-clear-touch.has-hover ? CS2Theme.bg-card-selected : transparent;

                                Path {
                                    width: 8px;
                                    height: 8px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    stroke: search-clear-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted;
                                    stroke-width: 1.8px;
                                    commands: "M 1.5 1.5 L 8.5 8.5 M 8.5 1.5 L 1.5 8.5";
                                }

                                search-clear-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is-listening-key = false;
                                        root.selector-dropdown-open = false;
                                        root.search-query = "";
                                        catalog-scroll.content-y = 0px;
                                        root.search-query-changed("");
                                    }
                                }
                            }
                        }
                    }

                    // Alternador Lista / Grade
                    Rectangle {
                        horizontal-stretch: 0;
                        height: 34px;
                        background: CS2Theme.bg-main;
                        border-radius: CS2Theme.radius-sm;
                        border-width: 1px;
                        border-color: CS2Theme.border;

                        HorizontalLayout {
                            padding: 3px;
                            spacing: 3px;

                            Rectangle {
                                height: 26px;
                                border-radius: CS2Theme.radius-xs;
                                background: !root.is-grid-view
                                    ? CS2Theme.accent-ct-soft
                                    : (list-mode-touch.has-hover ? CS2Theme.bg-card-hover : transparent);
                                border-width: 1px;
                                border-color: !root.is-grid-view ? CS2Theme.accent-ct-cyan : transparent;
                                animate background { duration: 100ms; }
                                animate border-color { duration: 100ms; }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Path {
                                            width: 12px;
                                            height: 10px;
                                            viewbox-width: 14;
                                            viewbox-height: 12;
                                            stroke: !root.is-grid-view ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                            stroke-width: 1.7px;
                                            commands: "M 1 2 L 13 2 M 1 6 L 13 6 M 1 10 L 13 10";
                                        }
                                    }

                                    Text {
                                        text: "Lista";
                                        font-size: 11px;
                                        font-weight: !root.is-grid-view ? 800 : 600;
                                        color: !root.is-grid-view ? #ffffff : CS2Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                list-mode-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is-listening-key = false;
                                        root.selector-dropdown-open = false;
                                        if root.is-grid-view {
                                            root.is-grid-view = false;
                                            catalog-scroll.content-y = 0px;
                                            root.view-mode-changed(false);
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 26px;
                                border-radius: CS2Theme.radius-xs;
                                background: root.is-grid-view
                                    ? CS2Theme.accent-ct-soft
                                    : (grid-mode-touch.has-hover ? CS2Theme.bg-card-hover : transparent);
                                border-width: 1px;
                                border-color: root.is-grid-view ? CS2Theme.accent-ct-cyan : transparent;
                                animate background { duration: 100ms; }
                                animate border-color { duration: 100ms; }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Path {
                                            width: 11px;
                                            height: 11px;
                                            viewbox-width: 12;
                                            viewbox-height: 12;
                                            stroke: root.is-grid-view ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                            stroke-width: 1.4px;
                                            fill: root.is-grid-view ? CS2Theme.accent-ct-cyan : transparent;
                                            commands: "M 1 1 L 4.5 1 L 4.5 4.5 L 1 4.5 Z M 7.5 1 L 11 1 L 11 4.5 L 7.5 4.5 Z M 1 7.5 L 4.5 7.5 L 4.5 11 L 1 11 Z M 7.5 7.5 L 11 7.5 L 11 11 L 7.5 11 Z";
                                        }
                                    }

                                    Text {
                                        text: "Grade";
                                        font-size: 11px;
                                        font-weight: root.is-grid-view ? 800 : 600;
                                        color: root.is-grid-view ? #ffffff : CS2Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                grid-mode-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.is-listening-key = false;
                                        root.selector-dropdown-open = false;
                                        if !root.is-grid-view {
                                            root.is-grid-view = true;
                                            catalog-scroll.content-y = 0px;
                                            root.view-mode-changed(true);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Abas de Categorias (1 aba por categoria)
                HorizontalLayout {
                    spacing: 4px;

                    for tab in root.category-tabs : Rectangle {
                        property <bool> is-searching: root.search-query != "";
                        property <bool> is-active: !is-searching && tab.index == root.active-category-index;

                        horizontal-stretch: 1;
                        height: 34px;
                        border-top-left-radius: CS2Theme.radius-sm;
                        border-top-right-radius: CS2Theme.radius-sm;
                        background: is-active
                            ? CS2Theme.bg-card
                            : (tab-touch.has-hover ? CS2Theme.bg-card-hover : transparent);
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            spacing: 5px;
                            alignment: center;

                            Text {
                                text: tab.tab-label;
                                font-size: 11px;
                                font-weight: is-active ? 800 : 600;
                                color: is-active
                                    ? #ffffff
                                    : (is-searching && tab.match-count == 0
                                        ? CS2Theme.text-dim
                                        : (tab-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted));
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            if !is-searching && tab.selected-count > 0 : Rectangle {
                                height: 16px;
                                min-width: 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: CS2Theme.radius-xs;
                                background: CS2Theme.accent-ct-soft;
                                border-width: 1px;
                                border-color: CS2Theme.accent-ct-blue;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: tab.selected-count;
                                        font-size: 9px;
                                        font-weight: 900;
                                        color: CS2Theme.text-cyan;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if is-searching && tab.match-count > 0 : Rectangle {
                                height: 16px;
                                min-width: 16px;
                                y: (parent.height - self.height) / 2;
                                border-radius: CS2Theme.radius-xs;
                                background: CS2Theme.bg-main;
                                border-width: 1px;
                                border-color: CS2Theme.border-hover;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    Text {
                                        text: tab.match-count;
                                        font-size: 9px;
                                        font-weight: 800;
                                        color: CS2Theme.text-primary;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        if is-active : Rectangle {
                            x: 0px;
                            y: parent.height - 2px;
                            width: parent.width;
                            height: 2px;
                            background: CS2Theme.accent-ct-cyan;
                        }

                        tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.is-listening-key = false;
                                root.selector-dropdown-open = false;
                                root.search-query = "";
                                root.active-category-index = tab.index;
                                catalog-scroll.content-y = 0px;
                                root.category-tab-selected(tab.index);
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: CS2Theme.border;
        }

        // =====================================================================
        // 3. LISTAGEM / GRADE ROLÁVEL DE COMANDOS
        // =====================================================================
        catalog-scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;

            VerticalLayout {
                width: catalog-scroll.visible-width;
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                padding-bottom: 24px;
                spacing: 8px;
                alignment: start;

                if root.search-query != "" && root.catalog-rows.length > 0 : Rectangle {
                    background: CS2Theme.bg-surface;
                    border-radius: CS2Theme.radius-sm;
                    border-width: 1px;
                    border-color: CS2Theme.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 10px;
                        alignment: space-between;

                        Text {
                            text: "Exibindo " + root.filtered-commands-count + (root.filtered-commands-count == 1 ? " comando" : " comandos") + " encontrados para \"" + root.search-query + "\" em todas as categorias";
                            font-size: 11px;
                            font-weight: 600;
                            color: CS2Theme.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: CS2Theme.radius-xs;
                            background: banner-clear-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-main;
                            border-width: 1px;
                            border-color: banner-clear-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: "Limpar pesquisa";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: CS2Theme.text-cyan;
                                    vertical-alignment: center;
                                }
                            }

                            banner-clear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.search-query = "";
                                    catalog-scroll.content-y = 0px;
                                    root.search-query-changed("");
                                }
                            }
                        }
                    }
                }

                if root.search-query != "" && root.catalog-rows.length == 0 : Rectangle {
                    vertical-stretch: 0;
                    background: CS2Theme.bg-surface;
                    border-radius: CS2Theme.radius-sm;
                    border-width: 1px;
                    border-color: CS2Theme.border;

                    VerticalLayout {
                        padding: 28px;
                        spacing: 10px;
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: CS2Theme.radius-sm;
                                background: CS2Theme.bg-card;
                                border-width: 1px;
                                border-color: CS2Theme.border;

                                Path {
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 16;
                                    viewbox-height: 16;
                                    stroke: CS2Theme.accent-ct-cyan;
                                    stroke-width: 1.7px;
                                    commands: "M 6.5 2 C 8.984 2 11 4.016 11 6.5 C 11 8.984 8.984 11 6.5 11 C 4.016 11 2 8.984 2 6.5 C 2 4.016 4.016 2 6.5 2 M 9.8 9.8 L 14 14";
                                }
                            }
                        }

                        Text {
                            text: "Nenhum comando encontrado para \"" + root.search-query + "\"";
                            font-size: 13px;
                            font-weight: 800;
                            color: CS2Theme.text-primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: "Tente buscar pelo nome do comando (ex: noclip, slot8, buy) ou por palavras da descrição (ex: fumaça, radar, recuo).";
                            font-size: 11px;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                height: 30px;
                                border-radius: CS2Theme.radius-xs;
                                background: empty-clear-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.accent-ct-soft;
                                border-width: 1px;
                                border-color: CS2Theme.accent-ct-cyan;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: "Limpar pesquisa";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                empty-clear-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.search-query = "";
                                        catalog-scroll.content-y = 0px;
                                        root.search-query-changed("");
                                    }
                                }
                            }
                        }
                    }
                }

                for row[idx] in root.catalog-rows : VerticalLayout {
                    // 3.1 Cabeçalho de Categoria (subtítulo abaixo do título, sem caixa)
                    if row.row-kind == 0 : VerticalLayout {
                        padding-top: idx == 0 ? 4px : 18px;
                        padding-bottom: 4px;
                        spacing: 6px;

                        VerticalLayout {
                            spacing: 3px;

                            Text {
                                text: row.title;
                                font-size: 16px;
                                font-weight: 800;
                                letter-spacing: 0.3px;
                                color: CS2Theme.text-primary;
                            }

                            if row.subtitle != "" : Text {
                                text: row.subtitle;
                                font-size: 12px;
                                font-weight: 400;
                                color: CS2Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: CS2Theme.border;
                        }
                    }

                    // 3.2 Cabeçalho de Subcategoria
                    if row.row-kind == 1 : VerticalLayout {
                        padding-top: 10px;
                        padding-bottom: 2px;

                        Text {
                            text: row.title;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 0.4px;
                            color: CS2Theme.text-cyan;
                        }
                    }

                    // 3.3 Item de Comando (Modo Lista)
                    if row.row-kind == 2 : BindCommandCard {
                        command-title: row.title;
                        description: row.subtitle;
                        checked: row.checked;
                        toggled(new-val) => {
                            root.selector-dropdown-open = false;
                            row.checked = new-val;
                            if !root.backend-connected {
                                if new-val {
                                    root.selected-commands-count += 1;
                                } else {
                                    root.selected-commands-count = max(0, root.selected-commands-count - 1);
                                }
                            }
                            root.command-toggled(row.command-index, new-val);
                        }
                    }

                    // 3.4 Par de Comandos (Modo Grade 2 colunas)
                    if row.row-kind == 3 : HorizontalLayout {
                        property <length> col-width: max(200px, (catalog-scroll.visible-width - 50px) / 2);
                        spacing: 10px;

                        BindCommandCard {
                            width: parent.col-width;
                            is-grid-card: true;
                            command-title: row.title;
                            description: row.subtitle;
                            checked: row.checked;
                            toggled(new-val) => {
                                root.selector-dropdown-open = false;
                                row.checked = new-val;
                                if !root.backend-connected {
                                    if new-val {
                                        root.selected-commands-count += 1;
                                    } else {
                                        root.selected-commands-count = max(0, root.selected-commands-count - 1);
                                    }
                                }
                                root.command-toggled(row.command-index, new-val);
                            }
                        }

                        if row.has-second : BindCommandCard {
                            width: parent.col-width;
                            is-grid-card: true;
                            command-title: row.second-title;
                            description: row.second-subtitle;
                            checked: row.second-checked;
                            toggled(new-val) => {
                                root.selector-dropdown-open = false;
                                row.second-checked = new-val;
                                if !root.backend-connected {
                                    if new-val {
                                        root.selected-commands-count += 1;
                                    } else {
                                        root.selected-commands-count = max(0, root.selected-commands-count - 1);
                                    }
                                }
                                root.command-toggled(row.second-command-index, new-val);
                            }
                        }

                        if !row.has-second : Rectangle {
                            width: parent.col-width;
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // 3. OVERLAY DO SELETOR DE ARQUIVOS EXISTENTES (.CFG)
    // =========================================================================
    if root.selector-dropdown-open : TouchArea {
        clicked => {
            root.selector-dropdown-open = false;
        }
    }

    if root.selector-dropdown-open : Rectangle {
        x: clamp(selector-anchor.absolute-position.x, 12px, root.width - self.width - 12px);
        y: selector-anchor.absolute-position.y + selector-anchor.height + 4px;
        width: 260px;
        height: min(260px, 46px + max(1, root.existing-cfg-files.length) * 32px);
        background: CS2Theme.bg-surface-elevated;
        border-radius: CS2Theme.radius-sm;
        border-width: 1px;
        border-color: CS2Theme.accent-ct-cyan;
        drop-shadow-color: rgba(0, 0, 0, 0.55);
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 6px;
        clip: true;

        // Bloqueia propagação de cliques no fundo do menu
        TouchArea { }

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            // Opção para limpar seleção e criar um novo arquivo
            Rectangle {
                height: 30px;
                border-radius: CS2Theme.radius-xs;
                background: clear-sel-touch.has-hover ? CS2Theme.bg-card-hover : transparent;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: "+ Novo arquivo (limpar seleção)";
                        font-size: 11px;
                        font-weight: 700;
                        color: CS2Theme.text-gold;
                        vertical-alignment: center;
                    }
                }

                clear-sel-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected-existing-file = "";
                        root.selector-dropdown-open = false;
                        root.sync-local-save-mode();
                        root.existing-file-selected("");
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: CS2Theme.border;
            }

            if root.existing-cfg-files.length == 0 : Rectangle {
                height: 32px;
                Text {
                    text: "Nenhum arquivo .cfg encontrado";
                    font-size: 11px;
                    color: CS2Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.existing-cfg-files.length > 0 : ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 2px;

                    for cfg-name in root.existing-cfg-files : Rectangle {
                        property <bool> is-current: cfg-name == root.selected-existing-file;
                        height: 30px;
                        border-radius: CS2Theme.radius-xs;
                        background: is-current
                            ? CS2Theme.accent-ct-soft
                            : (cfg-item-touch.has-hover ? CS2Theme.bg-card-hover : transparent);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;

                            Text {
                                text: cfg-name;
                                font-size: 11px;
                                font-weight: is-current ? 800 : 600;
                                color: is-current ? CS2Theme.text-cyan : CS2Theme.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            if is-current : Text {
                                text: "ATIVO";
                                font-size: 8px;
                                font-weight: 900;
                                color: CS2Theme.text-cyan;
                                vertical-alignment: center;
                            }
                        }

                        cfg-item-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-existing-file = cfg-name;
                                root.file-name-input = cfg-name;
                                root.selector-dropdown-open = false;
                                root.show-conflict-prompt = false;
                                root.sync-local-save-mode();
                                root.existing-file-selected(cfg-name);
                            }
                        }
                    }
                }
            }
        }
    }
}
