import { CS2Theme } from "theme.slint";
import { Sidebar } from "components/sidebar.slint";
import { TweakSwitch, MasterToggleSwitch } from "components/tweak_switch.slint";
import { TacticalButton } from "components/tactical_button.slint";
import { PresetButton } from "components/preset_button.slint";
import { AddPresetButton } from "components/add_preset_button.slint";
import { CreateProfileDialog, NewProfileData } from "components/create_profile_dialog.slint";
import { DeleteProfileDialog } from "components/delete_profile_dialog.slint";
import { NoProfileDialog } from "components/no_profile_dialog.slint";
import { InDevelopmentDialog } from "components/in_development_dialog.slint";
import { AutoOptimizeDialog } from "components/auto_optimize_dialog.slint";

export struct PresetModel {
    name: string,
    tag: string,
}

export struct LanguageItem {
    code: string,
    display_name: string,
}

export { NewProfileData }

export component MainWindow inherits Window {
    title: @tr("CounterRush - CS2 Performance");
    min-width: 980px;
    max-width: 980px;
    min-height: 620px;
    max-height: 620px;
    preferred-width: 980px;
    preferred-height: 620px;
    background: CS2Theme.bg-main;

    // Propriedades e estados reativos
    in-out property <int> active-tab: 0;
    in-out property <string> status-message: @tr("Pronto para iniciar o CS2 com taxa de polling de 0.5ms e afinidade de CPU otimizada.");
    in-out property <bool> is-launching: false;
    in-out property <bool> cpu-tweak-active: false;
    in-out property <bool> timer-tweak-active: false;
    in-out property <bool> priority-tweak-active: false;
    in-out property <bool> ram-tweak-active: false;
    in-out property <bool> gpu-accel-tweak-active: false;
    in-out property <bool> dpi-tweak-active: false;
    in-out property <bool> mem-compression-tweak-active: false;
    in-out property <bool> mmcss-tweak-active: false;
    in-out property <bool> hpet-tweak-active: false;
    in-out property <bool> game-bar-tweak-active: false;
    in-out property <bool> msi-tweak-active: false;
    in-out property <bool> power-saving-tweak-active: false;
    in-out property <bool> render-queue-tweak-active: false;
    in-out property <string> active-preset: "";
    in-out property <[PresetModel]> presets: [];
    in-out property <bool> show-create-modal: false;
    in-out property <string> create-modal-error: "";
    in-out property <string> launch-args-text: "";
    in-out property <bool> is-editing-launch-args: false;
    in-out property <bool> show-delete-modal: false;
    in-out property <string> target-delete-profile: "";
    in-out property <bool> show-no-profile-modal: false;
    in-out property <string> active-language: "pt_BR";
    in-out property <[LanguageItem]> available-languages: [
        { code: "pt_BR", display_name: "pt-BR" },
        { code: "ru_RU", display_name: "ru-RU" },
        { code: "en_US", display_name: "en-EUA" },
    ];
    in-out property <bool> show-in-development-modal: false;
    in-out property <string> in-development-feature-name: "";
    in-out property <bool> show-auto-optimize-modal: false;
    in-out property <float> auto-optimize-progress: 0.0;
    in-out property <string> auto-optimize-step-name: "";
    in-out property <bool> auto-optimize-finished: false;

    // Estado reativo geral para o botão mestre
    property <bool> is-all-tweaks-active: 
        root.cpu-tweak-active &&
        root.timer-tweak-active &&
        root.priority-tweak-active &&
        root.ram-tweak-active &&
        root.gpu-accel-tweak-active &&
        root.dpi-tweak-active &&
        root.mem-compression-tweak-active &&
        root.mmcss-tweak-active &&
        root.hpet-tweak-active &&
        root.game-bar-tweak-active &&
        root.msi-tweak-active &&
        root.power-saving-tweak-active &&
        root.render-queue-tweak-active;

    // Callbacks do backend Rust
    callback launch-cs2-clicked();
    callback card-action-clicked(string);
    callback tweak-toggled(string, bool);
    callback bulk-tweaks-action(string);
    callback auto-optimize-clicked();
    callback preset-selected(string);
    callback create-profile-confirmed(NewProfileData);
    callback save-launch-args-clicked(string);
    callback delete-profile-confirmed(string);
    callback language-selected(string);
    callback share-project-clicked();
    callback open-external-url(string);
    callback cancel-auto-optimize-clicked();

    HorizontalLayout {
        // 1. Barra Lateral Tática Sólida (Sem Bordas)
        Sidebar {
            active-tab <=> root.active-tab;
            tab-selected(idx) => {
                if idx == 0 {
                    root.status-message = @tr("Visualizando Painel Geral");
                } else if idx == 1 {
                    root.status-message = @tr("Ajustes Avançados de Hardware");
                } else if idx == 2 {
                    root.status-message = @tr("Configurações Gerais");
                } else {
                    root.status-message = @tr("Tabela de Classificação Valve");
                }
            }
        }

        // 2. Área Central com Distribuição Limpa e Sem Fundos Pesados
        if root.active-tab == 0 : VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 16px;
            spacing: 16px;
            alignment: space-between;

            // Cabeçalho Minimalista Direto
            Text {
                text: @tr("PAINEL DE CONTROLE");
                font-size: 16px;
                font-weight: 900;
                letter-spacing: 0.6px;
                color: CS2Theme.text-primary;
            }

            // Seção Superior: Ajustes de Hardware (Sem fundo envelopando, botões diretos no canvas com cor sólida)
            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: @tr("AJUSTES DE RÁPIDOS");
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        color: CS2Theme.text-muted;
                          }
                }

                HorizontalLayout {
                    spacing: 10px;

                    TweakSwitch {
                        label: @tr("Núcleo 0 Off");
                        info: @tr("Afinidade de CPU");
                        accent-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        checked <=> root.cpu-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Afinidade: Núcleo 0 desativado para o CS2.") : @tr("Afinidade: Restaurada ao padrão.");
                            root.tweak-toggled("cpu_core_0", val);
                        }
                    }

                    TweakSwitch {
                        label: @tr("Timer 0.5ms");
                        info: @tr("Temporizador");
                        accent-color: CS2Theme.status-success;
                        hover-color: #059669;
                        checked <=> root.timer-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Timer: Definido para 0.5ms de alta precisão.") : @tr("Timer: Restaurado.");
                            root.tweak-toggled("timer_resolution", val);
                        }
                    }

                    TweakSwitch {
                        label: @tr("Prioridade Alta");
                        info: @tr("Processo CS2");
                        accent-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        checked <=> root.priority-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Prioridade de processo definida para Alta.") : @tr("Prioridade de processo: Normal.");
                            root.tweak-toggled("process_priority", val);
                        }
                    }

                    TweakSwitch {
                        label: @tr("Limpar RAM");
                        info: @tr("Empty Standby");
                        accent-color: CS2Theme.accent-ct-blue;
                        hover-color: #0284c7;
                        checked <=> root.ram-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Memória: Páginas em standby liberadas.") : @tr("Limpeza de RAM desativada.");
                            root.tweak-toggled("empty_standby", val);
                        }
                    }
                }
            }

            // Seção Central: 3 Módulos de Recursos (Sem fundo, integrados diretamente com separação limpa)
            HorizontalLayout {
                spacing: 20px;
                min-height: 120px;
                preferred-height: 140px;

                // Módulo 1: Configs Pro (Ouro T-Side)
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("CONFIGS PRO");
                            font-size: 13px;
                            font-weight: 900;
                            color: CS2Theme.accent-t-amber;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: @tr("Miras, resolução esticada (4:3) e sensibilidade dos principais profissionais.");
                            font-size: 10px;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("EM BREVE");
                            font-size: 20px;
                            font-weight: 900;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    // Botão com Cor Sólida Ouro
                    Rectangle {
                        height: 36px;
                        background: touch1.has-hover ? #b45309 : CS2Theme.accent-t-gold;
                        border-radius: CS2Theme.radius-xs;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: @tr("BAIXAR .CFG PRO");
                                font-size: 10px;
                                font-weight: 900;
                                letter-spacing: 0.5px;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        touch1 := TouchArea {
                            clicked => {
                                root.status-message = @tr("Abrindo catálogo de configs profissionais...");
                                root.card-action-clicked("pro_cfg");
                            }
                        }
                    }
                }

                // Divisor Vertical Fino e Discreto
                Rectangle {
                    width: 1px;
                    background: rgba(36, 51, 74, 0.4);
                }

                // Módulo 2: Binds Táticas (Ciano CT)
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("BINDS TÁTICAS");
                            font-size: 13px;
                            font-weight: 900;
                            color: CS2Theme.accent-ct-cyan;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: @tr("Atalhos rápidos para utilitários e jumpthrow permitidos em servidores oficiais.");
                            font-size: 10px;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("EM BREVE");
                            font-size: 20px;
                            font-weight: 900;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    // Botão com Cor Sólida Ciano
                    Rectangle {
                        height: 36px;
                        background: touch2.has-hover ? #0369a1 : #0284c7;
                        border-radius: CS2Theme.radius-xs;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: @tr("GERENCIAR BINDS");
                                font-size: 10px;
                                font-weight: 900;
                                letter-spacing: 0.5px;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        touch2 := TouchArea {
                            clicked => {
                                root.status-message = @tr("Abrindo gerador de atalhos e binds táticas...");
                                root.card-action-clicked("binds");
                            }
                        }
                    }
                }

                // Divisor Vertical Fino e Discreto
                Rectangle {
                    width: 1px;
                    background: rgba(36, 51, 74, 0.4);
                }

                // Módulo 3: Treino & Oficina (Laranja CS2)
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("TREINO & MAPAS");
                            font-size: 13px;
                            font-weight: 900;
                            color: CS2Theme.accent-orange-bright;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: @tr("Mapas essenciais da Oficina Steam para treino de mira e teste de frametime.");
                            font-size: 10px;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("EM BREVE");
                            font-size: 20px;
                            font-weight: 900;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    // Botão com Cor Sólida Laranja
                    Rectangle {
                        height: 36px;
                        background: touch3.has-hover ? #c2410c : #ea580c;
                        border-radius: CS2Theme.radius-xs;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: @tr("ACESSAR TREINO");
                                font-size: 10px;
                                font-weight: 900;
                                letter-spacing: 0.5px;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        touch3 := TouchArea {
                            clicked => {
                                root.status-message = @tr("Abrindo oficina de mapas e teste de desempenho...");
                                root.card-action-clicked("workshop_maps");
                            }
                        }
                    }
                }
            }

            // Seção Inferior: Botão JOGAR CS2 Centralizado + Barra de Status HUD
            VerticalLayout {
                spacing: 6px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;
                    padding-bottom: 2px;

                    TacticalButton {
                        text: root.is-launching ? @tr("INICIANDO...") : @tr("JOGAR CS2");
                        badge: root.is-launching ? @tr("APLICANDO TWEAKS & STEAM") : @tr("INICIAR COM ALTA PERFORMANCE");
                        enabled: !root.is-launching;
                        background-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        custom-border-color: #c2410c;
                        custom-border-hover-color: #ff851b;
                        custom-border-width: 3px;
                        text-color: #ffffff;
                        icon-src: @image-url("assets/icons/play.svg");
                        clicked => {
                            if root.presets.length == 0 {
                                root.show-no-profile-modal = true;
                            } else {
                                root.is-launching = true;
                                root.status-message = @tr("Iniciando Counter-Strike 2 pela Steam com perfil otimizado...");
                                root.launch-cs2-clicked();
                            }
                        }
                    }
                }

                // Barra de Status HUD Tática
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - self.height) / 2;
                        background: root.is-launching ? CS2Theme.accent-orange : CS2Theme.status-success;
                    }

                    Text {
                        text: root.status-message;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 0.3px;
                        color: root.is-launching ? CS2Theme.accent-orange-bright : CS2Theme.text-dim;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // 3. Aba de Otimizações Completas (Todas as 13 Otimizações de Sistema e Hardware)
        if root.active-tab == 1 : VerticalLayout {
            padding-left: 19px;
            padding-right: 19px;
            padding-top: 18px;
            padding-bottom: 16px;
            alignment: space-between;

            // Seção Superior: Cabeçalho + Grade de Otimizações
            VerticalLayout {
                spacing: 16px;

                // Cabeçalho da Central de Otimizações
            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: @tr("CENTRAL DE OTIMIZAÇÕES");
                    font-size: 16px;
                    font-weight: 900;
                    letter-spacing: 0.6px;
                    color: CS2Theme.text-primary;
                }
            }

            // Grade de Otimizações (4 Colunas, Distância Ampliada e Largura Rigorosamente Igual à Aba Painel)
            VerticalLayout {
                spacing: 14px;

                // Linha 1: 4 Módulos de CPU, Timer, Prioridade e Memória
                HorizontalLayout {
                    spacing: 14px;

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 220px;
                        label: @tr("Núcleo 0 Off");
                        info: @tr("Afinidade CPU");
                        tooltip-text: @tr("Afinidade de CPU: Desativa o Núcleo 0 para o CS2 mitigando interrupções do SO.");
                        accent-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        checked <=> root.cpu-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Afinidade: Núcleo 0 desativado para o CS2.") : @tr("Afinidade: Restaurada ao padrão.");
                            root.tweak-toggled("cpu_core_0", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 215px;
                        label: @tr("Timer 0.5ms");
                        info: @tr("Temporizador");
                        tooltip-text: @tr("Temporizador do Sistema: Define resolução de alta precisão de 0.5ms.");
                        accent-color: CS2Theme.status-success;
                        hover-color: #059669;
                        checked <=> root.timer-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Timer: Definido para 0.5ms de alta precisão.") : @tr("Timer: Restaurado ao padrão do Windows.");
                            root.tweak-toggled("timer_resolution", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 220px;
                        label: @tr("Prioridade Alta");
                        info: @tr("Processo CS2");
                        tooltip-text: @tr("Prioridade de Processo: Eleva a prioridade do executável cs2.exe para Tempo Real.");
                        accent-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        checked <=> root.priority-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Prioridade de processo definida para Alta.") : @tr("Prioridade de processo: Normal.");
                            root.tweak-toggled("process_priority", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 215px;
                        label: @tr("Limpar RAM");
                        info: @tr("Empty Standby");
                        tooltip-text: @tr("Empty Standby List: Libera páginas de cache em standby na memória RAM.");
                        accent-color: CS2Theme.accent-ct-blue;
                        hover-color: #0284c7;
                        checked <=> root.ram-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Memória: Páginas em standby liberadas.") : @tr("Limpeza de RAM desativada.");
                            root.tweak-toggled("empty_standby", val);
                        }
                    }
                }

                // Linha 2: 4 Módulos de GPU, DPI, Compactação e Agendador
                HorizontalLayout {
                    spacing: 14px;

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 225px;
                        label: @tr("GPU Apps Off");
                        info: @tr("VRAM & Apps");
                        tooltip-text: @tr("Aceleração GPU: Desativa aceleração de hardware em Discord, Steam e navegadores.");
                        accent-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        checked <=> root.gpu-accel-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("GPU em apps desativada (mais VRAM para CS2).") : @tr("GPU em apps reativada.");
                            root.tweak-toggled("gpu_acceleration", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 220px;
                        label: @tr("Otimização DPI");
                        info: @tr("Tela Cheia CS2");
                        tooltip-text: @tr("Otimização DPI: Aplica flags de tela cheia exclusiva e reduz input lag no CS2.");
                        accent-color: CS2Theme.accent-ct-cyan;
                        hover-color: #0284c7;
                        checked <=> root.dpi-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("DPI & Tela cheia: Flags de baixa latência aplicadas.") : @tr("DPI: Configuração de compatibilidade removida.");
                            root.tweak-toggled("dpi_optimization", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 230px;
                        label: @tr("Compactar RAM");
                        info: @tr("MMAgent Off");
                        tooltip-text: @tr("Compactação de Memória: Desativa compressão de páginas do Windows (>16GB RAM).");
                        accent-color: CS2Theme.accent-ct-blue;
                        hover-color: #0284c7;
                        checked <=> root.mem-compression-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Compactação de RAM desativada (menor latência de CPU).") : @tr("Compactação de RAM reativada.");
                            root.tweak-toggled("memory_compression", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 235px;
                        label: @tr("Agendador MMCSS");
                        info: @tr("Agendador Win");
                        tooltip-text: @tr("MMCSS Games: Otimiza prioridade de rede, áudio e GPU para perfis de jogos.");
                        accent-color: CS2Theme.accent-t-gold;
                        hover-color: #b45309;
                        checked <=> root.mmcss-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("MMCSS: Perfil de jogos otimizado no registro do Windows.") : @tr("MMCSS: Restaurado ao padrão do Windows.");
                            root.tweak-toggled("mmcss", val);
                        }
                    }
                }

                // Linha 3: 4 Módulos de HPET, Game Bar, MSI e Economia de Energia
                HorizontalLayout {
                    spacing: 14px;

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 225px;
                        label: @tr("HPET Off");
                        info: @tr("Timer BCD");
                        tooltip-text: @tr("Desativar HPET: Desativa o relógio de plataforma no BCD priorizando o TSC da CPU.");
                        accent-color: CS2Theme.status-success;
                        hover-color: #059669;
                        checked <=> root.hpet-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("HPET desativado no BCD (usando TSC da CPU).") : @tr("HPET restaurado ao padrão de boot.");
                            root.tweak-toggled("hpet", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 225px;
                        label: @tr("Game Bar Off");
                        info: @tr("DVR & Overlay");
                        tooltip-text: @tr("Xbox Game Bar: Desativa sobreposições, modo Xbox e gravações de fundo GameDVR.");
                        accent-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        checked <=> root.game-bar-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Xbox Game Bar, GameDVR e capturas desativados.") : @tr("Xbox Game Bar e capturas restaurados.");
                            root.tweak-toggled("game_bar", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 230px;
                        label: @tr("Modo MSI");
                        info: @tr("PCIe IRQ Mode");
                        tooltip-text: @tr("Modo MSI: Ativa interrupções baseadas em mensagens para GPU, Rede e portas USB.");
                        accent-color: CS2Theme.accent-ct-cyan;
                        hover-color: #0284c7;
                        checked <=> root.msi-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Modo MSI ativado para GPU (Alta prioridade), Rede e USB.") : @tr("Modo MSI desativado (retornado para INTx).");
                            root.tweak-toggled("msi", val);
                        }
                    }

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 230px;
                        label: @tr("Power Save Off");
                        info: @tr("PCIe & USB");
                        tooltip-text: @tr("Economia de Energia: Desativa PCIe ASPM e suspensão seletiva de portas USB.");
                        accent-color: CS2Theme.accent-t-gold;
                        hover-color: #b45309;
                        checked <=> root.power-saving-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Economia de energia desativada (PCIe ASPM e Suspensão USB).") : @tr("Economia de energia restaurada ao padrão.");
                            root.tweak-toggled("power_saving", val);
                        }
                    }
                }

                // Linha 4: 13º Módulo (Render Queue) + Botão Único de Ativar/Desativar Tudo + Espaçadores
                HorizontalLayout {
                    spacing: 14px;

                    TweakSwitch {
                        button-width: 188px;
                        tooltip-width: 230px;
                        label: @tr("Render Queue");
                        info: @tr("Flip & Persist");
                        tooltip-text: @tr("Fila de Renderização: FlipQueue AMD = 1 e Persistence Mode em placas NVIDIA.");
                        accent-color: CS2Theme.status-success;
                        hover-color: #059669;
                        checked <=> root.render-queue-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Render Queue: FlipQueue AMD definido para 1 / NVIDIA PM ativo.") : @tr("Render Queue restaurada ao padrão de fábrica.");
                            root.tweak-toggled("render_queue", val);
                        }
                    }

                    MasterToggleSwitch {
                        button-width: 188px;
                        tooltip-width: 240px;
                        all-active: root.is-all-tweaks-active;
                        toggled(val) => {
                            root.cpu-tweak-active = val;
                            root.timer-tweak-active = val;
                            root.priority-tweak-active = val;
                            root.ram-tweak-active = val;
                            root.gpu-accel-tweak-active = val;
                            root.dpi-tweak-active = val;
                            root.mem-compression-tweak-active = val;
                            root.mmcss-tweak-active = val;
                            root.hpet-tweak-active = val;
                            root.game-bar-tweak-active = val;
                            root.msi-tweak-active = val;
                            root.power-saving-tweak-active = val;
                            root.render-queue-tweak-active = val;
                            root.status-message = val ? @tr("Todos os 13 módulos de otimização ativados.") : @tr("Todos os módulos desativados (Modo Padrão Windows).");
                            root.bulk-tweaks-action(val ? "activate_all" : "deactivate_all");
                        }
                    }

                    Rectangle {
                        min-width: 188px;
                        max-width: 188px;
                        height: 50px;
                        horizontal-stretch: 0;
                        background: transparent;
                    }

                    Rectangle {
                        min-width: 188px;
                        max-width: 188px;
                        height: 50px;
                        horizontal-stretch: 0;
                        background: transparent;
                    }
                }
            }
        }

            // Campo de Parâmetros de Inicialização e Botão de Edição/Salvamento (R3)
            if root.active-preset != "" : HorizontalLayout {
                alignment: center;
                spacing: 10px;

                Rectangle {
                    width: 722px;
                    height: 44px;
                    background: root.is-editing-launch-args ? CS2Theme.bg-surface : CS2Theme.bg-card;
                    border-radius: CS2Theme.radius-sm;
                    border-width: root.is-editing-launch-args ? (launch-input.has-focus ? 2px : 1px) : 1px;
                    border-color: root.is-editing-launch-args 
                        ? (launch-input.has-focus ? CS2Theme.accent-orange : CS2Theme.border-hover) 
                        : CS2Theme.border;
                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;

                        Rectangle {
                            width: 88px;
                            height: 22px;
                            border-radius: CS2Theme.radius-xs;
                            background: root.is-editing-launch-args 
                                ? CS2Theme.accent-orange-soft 
                                : CS2Theme.bg-surface;
                            border-width: 1px;
                            border-color: root.is-editing-launch-args 
                                ? CS2Theme.accent-orange 
                                : CS2Theme.border;
                            y: (parent.height - self.height) / 2;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }

                            Text {
                                text: @tr("PARÂMETROS");
                                font-size: 8px;
                                font-weight: 900;
                                letter-spacing: 0.6px;
                                color: root.is-editing-launch-args ? CS2Theme.accent-orange-bright : CS2Theme.text-dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        launch-input := TextInput {
                            text <=> root.launch-args-text;
                            read-only: !root.is-editing-launch-args;
                            color: root.is-editing-launch-args ? CS2Theme.text-primary : CS2Theme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            single-line: true;
                            vertical-alignment: center;
                            accepted => {
                                if root.is-editing-launch-args {
                                    root.is-editing-launch-args = false;
                                    root.status-message = @tr("Salvando parâmetros no perfil '{}'...", root.active-preset);
                                    root.save-launch-args-clicked(root.launch-args-text);
                                }
                            }
                        }
                    }

                    if root.launch-args-text == "" : Text {
                        x: 114px;
                        y: (parent.height - self.height) / 2;
                        text: root.is-editing-launch-args ? @tr("Ex: -novid -high +fps_max 0") : @tr("Nenhum parâmetro de inicialização configurado");
                        color: CS2Theme.text-dim;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 44px;
                    height: 44px;
                    background: edit-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card;
                    border-radius: CS2Theme.radius-sm;
                    border-width: edit-touch.has-hover ? 2px : 1px;
                    border-color: root.is-editing-launch-args
                        ? (edit-touch.has-hover ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange)
                        : (edit-touch.has-hover ? CS2Theme.accent-orange : CS2Theme.border);

                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    Image {
                        source: root.is-editing-launch-args 
                            ? @image-url("assets/icons/save.svg") 
                            : @image-url("assets/icons/pencil.svg");
                        width: 16px;
                        height: 16px;
                        colorize: edit-touch.has-hover 
                            ? CS2Theme.accent-orange-bright 
                            : (root.is-editing-launch-args ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        animate colorize { duration: 120ms; }
                    }

                    edit-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if !root.is-editing-launch-args {
                                root.is-editing-launch-args = true;
                                root.status-message = @tr("Edição de parâmetros desbloqueada para o perfil '{}'.", root.active-preset);
                                launch-input.focus();
                            } else {
                                root.is-editing-launch-args = false;
                                root.status-message = @tr("Salvando parâmetros no perfil '{}'...", root.active-preset);
                                root.save-launch-args-clicked(root.launch-args-text);
                            }
                        }
                    }
                }
            }

            // Seção Intermediária (Sem Perfis): Botões de Ação Exclusivos (R1)
            if root.presets.length == 0 : HorizontalLayout {
                alignment: center;
                spacing: 16px;

                TacticalButton {
                    text: @tr("OTIMIZAR AUTOMATICAMENTE");
                    badge: @tr("PERFIL RECOMENDADO • BAIXA LATÊNCIA");
                    enabled: !root.is-launching;
                    background-color: CS2Theme.accent-orange;
                    hover-color: #ff771a;
                    custom-border-color: #c2410c;
                    custom-border-hover-color: #ff851b;
                    custom-border-width: 3px;
                    button-width: 320px;
                    text-color: #ffffff;
                    icon-src: @image-url("assets/icons/rocket.svg");
                    clicked => {
                        root.auto-optimize-progress = 0.0;
                        root.auto-optimize-step-name = @tr("Iniciando calibração...");
                        root.auto-optimize-finished = false;
                        root.show-auto-optimize-modal = true;
                        root.auto-optimize-clicked();
                    }
                }

                AddPresetButton {
                    is-empty: true;
                    clicked => {
                        root.create-modal-error = "";
                        root.show-create-modal = true;
                    }
                }
            }

            // Seção Intermediária (Com Perfis): Perfis de Otimização (config/optimzations) - Seleção Única (R4)
            if root.presets.length > 0 : VerticalLayout {
                spacing: 8px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 18px;
                        height: 1px;
                        background: CS2Theme.border;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: @tr("PERFIS DE OTIMIZAÇÃO (CONFIG/OPTIMZATIONS)");
                        font-size: 10px;
                        font-weight: 800;
                        letter-spacing: 0.8px;
                        color: CS2Theme.text-dim;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 18px;
                        height: 1px;
                        background: CS2Theme.border;
                        y: (parent.height - self.height) / 2;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: root.presets.length > 2 ? 10px : 16px;

                    for preset in root.presets : PresetButton {
                        file-name: preset.name;
                        tag: preset.tag == "auto" ? @tr("HARDWARE ADAPTATIVO")
                            : preset.tag == "custom" ? @tr("CUSTOMIZADO / MANUAL")
                            : @tr("PERFIL DO USUÁRIO");
                        is-active: root.active-preset == preset.name;
                        accent-color: preset.name == "AutoDetect" ? CS2Theme.accent-ct-cyan : CS2Theme.accent-orange;
                        active-bg: preset.name == "AutoDetect" ? CS2Theme.accent-ct-soft : CS2Theme.accent-orange-soft;
                        button-width: root.presets.length > 2 ? 250px : 350px;
                        selected => {
                            root.active-preset = preset.name;
                            root.is-editing-launch-args = false;
                            root.status-message = @tr("Perfil ativo: {}", preset.name);
                            root.preset-selected(preset.name);
                        }
                        delete => {
                            root.target-delete-profile = preset.name;
                            root.show-delete-modal = true;
                        }
                    }

                    AddPresetButton {
                        is-empty: false;
                        clicked => {
                            root.create-modal-error = "";
                            root.show-create-modal = true;
                        }
                    }
                }
            }

            // Seção Inferior: Barra de Status HUD Tática
            VerticalLayout {
                spacing: 6px;
                alignment: center;

                // Barra de Status HUD Tática
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - self.height) / 2;
                        background: CS2Theme.status-success;
                    }

                    Text {
                        text: root.status-message;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 0.3px;
                        color: CS2Theme.text-dim;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // 4. Aba de Configurações
        if root.active-tab == 2 : VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 16px;
            alignment: space-between;

            VerticalLayout {
                spacing: 18px;

                // Cabeçalho da Aba
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: @tr("CONFIGURAÇÕES GERAIS");
                        font-size: 16px;
                        font-weight: 900;
                        letter-spacing: 0.6px;
                        color: CS2Theme.text-primary;
                    }
                    Text {
                        text: @tr("Preferências do aplicativo, integração com o sistema e links da comunidade.");
                        font-size: 11px;
                        color: CS2Theme.text-dim;
                    }
                }

                // Seção 1: Idioma da Interface
                VerticalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: @tr("IDIOMA DA INTERFACE");
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            color: CS2Theme.text-cyan;
                        }
                        Text {
                            text: @tr("Selecione o idioma padrão para a interface do CounterRush.");
                            font-size: 10px;
                            color: CS2Theme.text-dim;
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;

                        for lang in root.available-languages : Rectangle {
                            property <bool> is-selected: lang.code == root.active-language;
                            width: 120px;
                            height: 32px;
                            background: is-selected ? CS2Theme.bg-card-selected : (lang-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface);
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: is-selected ? CS2Theme.accent-ct-cyan : (lang-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border);
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                if is-selected : VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: CS2Theme.accent-ct-cyan;
                                    }
                                }

                                Text {
                                    text: lang.display-name;
                                    font-size: 11px;
                                    font-weight: is-selected ? 800 : 600;
                                    color: is-selected ? CS2Theme.text-primary : CS2Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            lang-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.language-selected(lang.code);
                                }
                            }
                        }
                    }
                }

                // Seção 2: Inicialização e Sistema
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: @tr("INICIALIZAÇÃO E SISTEMA");
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        color: CS2Theme.accent-t-gold;
                    }

                    // Linha 1: Iniciar com o Windows
                    Rectangle {
                        height: 42px;
                        background: row1-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                        border-radius: CS2Theme.radius-xs;
                        border-width: 1px;
                        border-color: row1-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: @tr("Iniciar com o Windows");
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: CS2Theme.text-primary;
                                }
                                Text {
                                    text: @tr("Executar o CounterRush automaticamente na inicialização do sistema operacional.");
                                    font-size: 10px;
                                    color: CS2Theme.text-dim;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 76px;
                                    height: 22px;
                                    border-radius: CS2Theme.radius-xs;
                                    background: CS2Theme.accent-t-soft;
                                    border-width: 1px;
                                    border-color: CS2Theme.accent-t-gold;
                                    Text {
                                        text: @tr("EM BREVE");
                                        font-size: 9px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        color: CS2Theme.accent-t-gold;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        row1-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.in-development-feature-name = @tr("Iniciar com o Windows");
                                root.show-in-development-modal = true;
                            }
                        }
                    }

                    // Linha 2: Auto-Otimização Steam
                    Rectangle {
                        height: 42px;
                        background: row2-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                        border-radius: CS2Theme.radius-xs;
                        border-width: 1px;
                        border-color: row2-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: @tr("Auto-Otimização Steam");
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: CS2Theme.text-primary;
                                }
                                Text {
                                    text: @tr("Detectar a execução do Counter-Strike 2 pela Steam e aplicar otimizações em tempo real.");
                                    font-size: 10px;
                                    color: CS2Theme.text-dim;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 76px;
                                    height: 22px;
                                    border-radius: CS2Theme.radius-xs;
                                    background: CS2Theme.accent-t-soft;
                                    border-width: 1px;
                                    border-color: CS2Theme.accent-t-gold;
                                    Text {
                                        text: @tr("EM BREVE");
                                        font-size: 9px;
                                        font-weight: 800;
                                        letter-spacing: 0.5px;
                                        color: CS2Theme.accent-t-gold;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        row2-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.in-development-feature-name = @tr("Auto-Otimização Steam");
                                root.show-in-development-modal = true;
                            }
                        }
                    }
                }

                // Seção 3: Sobre e Comunidade
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: @tr("SOBRE E COMUNIDADE");
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        color: CS2Theme.accent-orange;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        // Ação 1: Compartilhar Projeto
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 58px;
                            background: share-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: share-touch.has-hover ? CS2Theme.accent-orange : CS2Theme.border;
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: @tr("Compartilhar Projeto");
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: share-touch.has-hover ? CS2Theme.accent-orange : CS2Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: @tr("Copiar o link oficial do CounterRush para divulgar o projeto com amigos.");
                                    font-size: 9px;
                                    color: CS2Theme.text-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            share-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.share-project-clicked();
                                }
                            }
                        }

                        // Ação 2: Repositório GitHub
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 58px;
                            background: gh-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: gh-touch.has-hover ? CS2Theme.accent-ct-cyan : CS2Theme.border;
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: @tr("Repositório GitHub");
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: gh-touch.has-hover ? CS2Theme.accent-ct-cyan : CS2Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: @tr("Acessar o código-fonte aberto, notas de versão e novidades no GitHub.");
                                    font-size: 9px;
                                    color: CS2Theme.text-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            gh-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-external-url("https://github.com/ThainanViniciusKatchan/CounterRush");
                                }
                            }
                        }

                        // Ação 3: Website Oficial
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 58px;
                            background: web-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: web-touch.has-hover ? CS2Theme.status-success : CS2Theme.border;
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: @tr("Website Oficial");
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: web-touch.has-hover ? CS2Theme.status-success : CS2Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: @tr("Visitar a página inicial oficial do CounterRush na web.");
                                    font-size: 9px;
                                    color: CS2Theme.text-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            web-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-external-url("https://feitonobrasil.dev.br");
                                }
                            }
                        }
                    }
                }
            }

            // HUD Inferior de Status
            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: CS2Theme.status-success;
                    }
                }

                Text {
                    text: root.status-message;
                    font-size: 10px;
                    font-weight: 600;
                    color: CS2Theme.text-dim;
                }
            }
        }

        // 5. Aba de Ranking
        if root.active-tab == 3 : VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 16px;
            spacing: 16px;
            alignment: space-between;

            Text {
                text: @tr("RANKING CS & TABELA VALVE");
                font-size: 16px;
                font-weight: 900;
                letter-spacing: 0.6px;
                color: CS2Theme.text-primary;
            }

            Rectangle {
                background: CS2Theme.bg-card;
                border-radius: CS2Theme.radius-sm;
                VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                            text: @tr("EM BREVE");
                            font-size: 50px;
                            font-weight: 900;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    y: (parent.height - self.height) / 2;
                    background: CS2Theme.status-success;
                }

                Text {
                    text: root.status-message;
                    font-size: 10px;
                    font-weight: 600;
                    color: CS2Theme.text-dim;
                }
            }
        }
    }

    // Modal Overlay de Criação de Perfil de Otimização (.json)
    if root.show-create-modal : CreateProfileDialog {
        error-message: root.create-modal-error;
        cancel => {
            root.show-create-modal = false;
            root.create-modal-error = "";
        }
        confirmed(data) => {
            root.create-profile-confirmed(data);
        }
    }

    // Modal Overlay de Confirmação de Exclusão de Perfil (.json)
    if root.show-delete-modal : DeleteProfileDialog {
        profile-name: root.target-delete-profile;
        cancel => {
            root.show-delete-modal = false;
            root.target-delete-profile = "";
        }
        confirmed => {
            root.show-delete-modal = false;
            root.delete-profile-confirmed(root.target-delete-profile);
            root.target-delete-profile = "";
        }
    }

    // Modal Overlay de Aviso de Ausência de Perfil ao Jogar CS2
    if root.show-no-profile-modal : NoProfileDialog {
        close => {
            root.show-no-profile-modal = false;
        }
        create-profile => {
            root.show-no-profile-modal = false;
            root.active-tab = 1;
            root.status-message = @tr("Ajustes Avançados de Hardware");
        }
    }

    // Modal Overlay de Recurso em Desenvolvimento
    if root.show-in-development-modal : InDevelopmentDialog {
        feature-name: root.in-development-feature-name;
        close => {
            root.show-in-development-modal = false;
            root.in-development-feature-name = "";
        }
    }

    // Modal Overlay de Animação de Otimização Automática
    if root.show-auto-optimize-modal : AutoOptimizeDialog {
        progress: root.auto-optimize-progress;
        current-step-name: root.auto-optimize-step-name;
        is-finished: root.auto-optimize-finished;
        confirm-cancel => {
            root.show-auto-optimize-modal = false;
            root.cancel-auto-optimize-clicked();
        }
        play-cs2 => {
            root.show-auto-optimize-modal = false;
            root.active-tab = 0;
            root.status-message = @tr("Iniciando Counter-Strike 2 pela Steam com perfil otimizado...");
            root.is-launching = true;
            root.launch-cs2-clicked();
        }
        close => {
            root.show-auto-optimize-modal = false;
        }
    }
}
