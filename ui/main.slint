import { ScrollView } from "std-widgets.slint";
import { CS2Theme } from "theme.slint";
import { Sidebar } from "components/sidebar.slint";
import { TweakSwitch } from "components/tweak_switch.slint";
import { CfgSelectorCard } from "components/cfg_selector_card.slint";
import { TacticalButton } from "components/tactical_button.slint";
import { PresetButton } from "components/preset_button.slint";
import { AddPresetButton } from "components/add_preset_button.slint";
import { CreateProfileDialog, NewProfileData } from "components/create_profile_dialog.slint";
import { DeleteProfileDialog } from "components/delete_profile_dialog.slint";
import { NoProfileDialog } from "components/no_profile_dialog.slint";
import { InDevelopmentDialog } from "components/in_development_dialog.slint";
import { AutoOptimizeDialog } from "components/auto_optimize_dialog.slint";
import { AppTray } from "components/tray.slint";
import { BindsView, BindsState, BindCatalogRow, BindCategoryTab, BindGridCell } from "components/binds_view.slint";

export struct PresetModel {
    name: string,
    tag: string,
}

export struct LanguageItem {
    code: string,
    display_name: string,
}

export { NewProfileData, AppTray, BindsState, BindCatalogRow, BindCategoryTab, BindGridCell }

export component MainWindow inherits Window {
    title: @tr("CounterRush - CS2 Performance");
    icon: @image-url("assets/icons/tray.svg");
    min-width: 980px;
    max-width: 980px;
    min-height: 620px;
    max-height: 620px;
    preferred-width: 980px;
    preferred-height: 620px;
    background: CS2Theme.bg-main;

    // Propriedades e estados reativos
    in-out property <string> app-version: "0.20.0";
    in-out property <int> active-tab: 0;
    in-out property <bool> show-binds-view: false;
    in-out property <string> status-message: @tr("Nenhum perfil de otimização ativo. Crie ou detecte um perfil para começar.");
    in-out property <bool> is-launching: false;
    in-out property <bool> cpu-tweak-active: false;
    in-out property <bool> timer-tweak-active: false;
    in-out property <bool> priority-tweak-active: false;
    in-out property <bool> ram-tweak-active: false;
    in-out property <bool> cpu-tweak-applied: false;
    in-out property <bool> timer-tweak-applied: false;
    in-out property <bool> priority-tweak-applied: false;
    in-out property <bool> ram-tweak-applied: false;
    in-out property <bool> gpu-accel-tweak-active: false;
    in-out property <bool> dpi-tweak-active: false;
    in-out property <bool> mem-compression-tweak-active: false;
    in-out property <bool> mmcss-tweak-active: false;
    in-out property <bool> hpet-tweak-active: false;
    in-out property <bool> game-bar-tweak-active: false;
    in-out property <bool> msi-tweak-active: false;
    in-out property <bool> power-saving-tweak-active: false;
    in-out property <bool> render-queue-tweak-active: false;
    in-out property <string> active-preset: "";
    in-out property <[PresetModel]> presets: [];
    in-out property <bool> show-create-modal: false;
    in-out property <string> create-modal-error: "";
    in-out property <string> launch-args-text: "";
    in-out property <bool> is-editing-launch-args: false;
    in-out property <[string]> available-cfg-files: [];
    in-out property <string> selected-preferred-cfg: "";
    in-out property <bool> cfg-dropdown-open: false;
    property <length> cfg-dropdown-anchor-x: 0px;
    property <length> cfg-dropdown-anchor-y: 0px;
    property <length> cfg-dropdown-anchor-w: 526px;
    property <length> cfg-dropdown-anchor-h: 46px;
    in-out property <bool> show-delete-modal: false;
    in-out property <string> target-delete-profile: "";
    in-out property <bool> show-no-profile-modal: false;
    in-out property <string> active-language: "pt_BR";
    in-out property <[LanguageItem]> available-languages: [
        { code: "pt_BR", display_name: "pt-BR" },
        { code: "ru_RU", display_name: "ru-RU" },
        { code: "en_US", display_name: "en-US" },
    ];
    in-out property <bool> show-in-development-modal: false;
    in-out property <string> in-development-feature-name: "";
    in-out property <bool> show-auto-optimize-modal: false;
    in-out property <float> auto-optimize-progress: 0.0;
    in-out property <string> auto-optimize-step-name: "";
    in-out property <string> auto-optimize-stage-title: "";
    in-out property <string> auto-optimize-stage-subtitle: "";
    in-out property <bool> auto-optimize-finished: false;
    in-out property <bool> auto-optimize-is-launch: false;
    in-out property <bool> auto-optimize-is-restore: false;
    in-out property <bool> minimize-to-tray: false;
    in-out property <bool> start-with-system: false;
    in-out property <bool> optimize-on-steam-launch: false;
    in-out property <bool> content-is-grid-view: false;
    in-out property <bool> is-restoring-defaults: false;

    // Indica se existe um perfil selecionado pronto para edição de tweaks
    property <bool> has-active-profile: root.presets.length > 0 && root.active-preset != "";

    property <int> game-tweaks-active-count:
        (root.cpu-tweak-active ? 1 : 0)
        + (root.priority-tweak-active ? 1 : 0)
        + (root.timer-tweak-active ? 1 : 0)
        + (root.ram-tweak-active ? 1 : 0);

    property <int> system-tweaks-active-count:
        (root.gpu-accel-tweak-active ? 1 : 0)
        + (root.dpi-tweak-active ? 1 : 0)
        + (root.mem-compression-tweak-active ? 1 : 0)
        + (root.mmcss-tweak-active ? 1 : 0)
        + (root.hpet-tweak-active ? 1 : 0)
        + (root.game-bar-tweak-active ? 1 : 0)
        + (root.msi-tweak-active ? 1 : 0)
        + (root.power-saving-tweak-active ? 1 : 0)
        + (root.render-queue-tweak-active ? 1 : 0);

    property <bool> has-any-tweak-active: (root.game-tweaks-active-count + root.system-tweaks-active-count) > 0;

    // Estado do popup flutuante de descrição na aba Otimizações
    property <bool> opt-tooltip-visible: false;
    property <string> opt-tooltip-id: "";
    property <string> opt-tooltip-title: "";
    property <string> opt-tooltip-description: "";
    property <color> opt-tooltip-accent: CS2Theme.accent-orange;
    property <bool> opt-tooltip-prefer-below: false;
    property <length> opt-tooltip-anchor-x: 0px;
    property <length> opt-tooltip-anchor-y: 0px;
    property <length> opt-tooltip-anchor-w: 0px;
    property <length> opt-tooltip-anchor-h: 0px;

    changed active-tab => {
        root.hide-opt-tooltip();
        root.cfg-dropdown-open = false;
        if root.active-tab == 1 {
            root.refresh-cfg-files-requested();
        }
    }

    // Estado reativo geral para o botão mestre
    property <bool> is-all-tweaks-active: 
        root.cpu-tweak-active &&
        root.timer-tweak-active &&
        root.priority-tweak-active &&
        root.ram-tweak-active &&
        root.gpu-accel-tweak-active &&
        root.dpi-tweak-active &&
        root.mem-compression-tweak-active &&
        root.mmcss-tweak-active &&
        root.hpet-tweak-active &&
        root.game-bar-tweak-active &&
        root.msi-tweak-active &&
        root.power-saving-tweak-active &&
        root.render-queue-tweak-active;

    // Callbacks do backend Rust
    callback launch-cs2-clicked();
    callback card-action-clicked(string);
    callback tweak-toggled(string, bool);
    callback tweak-requires-profile();
    callback bulk-tweaks-action(string);
    callback restore-defaults-clicked();
    callback auto-optimize-clicked();
    callback preset-selected(string);
    callback create-profile-confirmed(NewProfileData);
    callback save-launch-args-clicked(string);
    callback preferred-cfg-selected(string);
    callback refresh-cfg-files-requested();
    callback delete-profile-confirmed(string);
    callback language-selected(string);
    callback share-project-clicked();
    callback open-external-url(string);
    callback cancel-auto-optimize-clicked();
    callback minimize-to-tray-toggled(bool);
    callback start-with-system-toggled(bool);
    callback optimize-on-steam-launch-toggled(bool);
    callback content-view-mode-changed(bool);

    function handle-tweak-without-profile() {
        if !root.is-restoring-defaults {
            root.status-message = @tr("Crie ou selecione um perfil para ativar otimizações.");
            root.tweak-requires-profile();
        }
    }

    function close-binds-view() {
        root.show-binds-view = false;
        BindsState.is-listening-key = false;
        BindsState.selector-dropdown-open = false;
        BindsState.tooltip-visible = false;
    }

    function hide-opt-tooltip() {
        root.opt-tooltip-visible = false;
    }

    function handle-opt-tooltip-hover(
        hovered: bool,
        id: string,
        title: string,
        desc: string,
        accent: color,
        prefer-below: bool,
        ax: length,
        ay: length,
        aw: length,
        ah: length
    ) {
        if hovered && !root.cfg-dropdown-open {
            root.opt-tooltip-id = id;
            root.opt-tooltip-title = title;
            root.opt-tooltip-description = desc;
            root.opt-tooltip-accent = accent;
            root.opt-tooltip-prefer-below = prefer-below;
            root.opt-tooltip-anchor-x = ax;
            root.opt-tooltip-anchor-y = ay;
            root.opt-tooltip-anchor-w = aw;
            root.opt-tooltip-anchor-h = ah;
            root.opt-tooltip-visible = true;
        } else if !hovered && root.opt-tooltip-id == id {
            root.opt-tooltip-visible = false;
        }
    }

    HorizontalLayout {
        // 1. Barra Lateral Tática Sólida (Sem Bordas)
        Sidebar {
            active-tab <=> root.active-tab;
            app-version: root.app-version;
            tab-selected(idx) => {
                root.close-binds-view();
                root.hide-opt-tooltip();
                root.cfg-dropdown-open = false;
                if idx == 0 {
                    root.status-message = @tr("Visualizando Painel Geral");
                } else if idx == 1 {
                    root.status-message = @tr("Ajustes Avançados de Hardware");
                } else if idx == 2 {
                    root.status-message = @tr("Configurações Gerais");
                } else {
                    root.status-message = @tr("Tabela de Classificação Valve");
                }
            }
        }

        // 2. Área Central com Distribuição Limpa e Sem Fundos Pesados
        if root.active-tab == 0 && !root.show-binds-view : VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 16px;
            spacing: 16px;
            alignment: space-between;

            // Cabeçalho Minimalista Direto
            Text {
                text: @tr("PAINEL DE CONTROLE");
                font-size: 16px;
                font-weight: 900;
                letter-spacing: 0.6px;
                color: CS2Theme.text-primary;
            }

            // Seção Superior: Ajustes de Hardware (Sem fundo envelopando, botões diretos no canvas com cor sólida)
            VerticalLayout {
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: @tr("AJUSTES DE RÁPIDOS");
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        color: CS2Theme.text-muted;
                          }
                }

                HorizontalLayout {
                    spacing: 10px;

                    TweakSwitch {
                        label: @tr("Núcleo 0 Off");
                        info: @tr("Afinidade de CPU");
                        accent-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        enabled: root.has-active-profile;
                        checked <=> root.cpu-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Afinidade: Núcleo 0 desativado para o CS2.") : @tr("Afinidade: Restaurada ao padrão.");
                            root.tweak-toggled("cpu_core_0", val);
                        }
                        blocked-click => {
                            root.handle-tweak-without-profile();
                        }
                    }

                    TweakSwitch {
                        label: @tr("Timer 0.5ms");
                        info: @tr("Temporizador");
                        accent-color: CS2Theme.status-success;
                        hover-color: #059669;
                        enabled: root.has-active-profile;
                        checked <=> root.timer-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Timer: Definido para 0.5ms de alta precisão.") : @tr("Timer: Restaurado.");
                            root.tweak-toggled("timer_resolution", val);
                        }
                        blocked-click => {
                            root.handle-tweak-without-profile();
                        }
                    }

                    TweakSwitch {
                        label: @tr("Prioridade Alta");
                        info: @tr("Processo CS2");
                        accent-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        enabled: root.has-active-profile;
                        checked <=> root.priority-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Prioridade de processo definida para Alta.") : @tr("Prioridade de processo: Normal.");
                            root.tweak-toggled("process_priority", val);
                        }
                        blocked-click => {
                            root.handle-tweak-without-profile();
                        }
                    }

                    TweakSwitch {
                        label: @tr("Limpar RAM");
                        info: @tr("Empty Standby");
                        accent-color: CS2Theme.accent-ct-blue;
                        hover-color: #0284c7;
                        enabled: root.has-active-profile;
                        checked <=> root.ram-tweak-active;
                        toggled(val) => {
                            root.status-message = val ? @tr("Memória: Páginas em standby liberadas.") : @tr("Limpeza de RAM desativada.");
                            root.tweak-toggled("empty_standby", val);
                        }
                        blocked-click => {
                            root.handle-tweak-without-profile();
                        }
                    }
                }
            }

            // Seção Central: 3 Módulos de Recursos (Sem fundo, integrados diretamente com separação limpa)
            HorizontalLayout {
                spacing: 20px;
                min-height: 120px;
                preferred-height: 140px;

                // Módulo 1: Configs Pro (Ouro T-Side)
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("CONFIGS PRO");
                            font-size: 13px;
                            font-weight: 900;
                            color: CS2Theme.accent-t-amber;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: @tr("Miras, resolução esticada (4:3) e sensibilidade dos principais profissionais.");
                            font-size: 10px;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("EM BREVE");
                            font-size: 20px;
                            font-weight: 900;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    // Botão com Cor Sólida Ouro
                    Rectangle {
                        height: 36px;
                        background: touch1.has-hover ? #b45309 : CS2Theme.accent-t-gold;
                        border-radius: CS2Theme.radius-xs;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: @tr("BAIXAR .CFG PRO");
                                font-size: 10px;
                                font-weight: 900;
                                letter-spacing: 0.5px;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        touch1 := TouchArea {
                            clicked => {
                                root.status-message = @tr("Abrindo catálogo de configs profissionais...");
                                root.card-action-clicked("pro_cfg");
                            }
                        }
                    }
                }

                // Divisor Vertical Fino e Discreto
                Rectangle {
                    width: 1px;
                    background: rgba(36, 51, 74, 0.4);
                }

                // Módulo 2: Binds Táticas (Ciano CT)
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("BINDS TÁTICAS");
                            font-size: 13px;
                            font-weight: 900;
                            color: CS2Theme.accent-ct-cyan;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: @tr("Atalhos rápidos para utilitários e jumpthrow permitidos em servidores oficiais.");
                            font-size: 10px;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    // Botão com Cor Sólida Ciano
                    Rectangle {
                        height: 36px;
                        background: touch2.has-hover ? #0369a1 : #0284c7;
                        border-radius: CS2Theme.radius-xs;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: @tr("GERENCIAR BINDS");
                                font-size: 10px;
                                font-weight: 900;
                                letter-spacing: 0.5px;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        touch2 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.show-binds-view = true;
                                root.status-message = @tr("Abrindo gerador de atalhos e binds táticas...");
                                root.card-action-clicked("binds");
                            }
                        }
                    }
                }

                // Divisor Vertical Fino e Discreto
                Rectangle {
                    width: 1px;
                    background: rgba(36, 51, 74, 0.4);
                }

                // Módulo 3: Treino & Oficina (Laranja CS2)
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("TREINO & MAPAS");
                            font-size: 13px;
                            font-weight: 900;
                            color: CS2Theme.accent-orange-bright;
                            letter-spacing: 0.5px;
                        }

                        Text {
                            text: @tr("Mapas essenciais da Oficina Steam para treino de mira e teste de frametime.");
                            font-size: 10px;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                        Text {
                            text: @tr("EM BREVE");
                            font-size: 20px;
                            font-weight: 900;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                        }
                    }

                    // Botão com Cor Sólida Laranja
                    Rectangle {
                        height: 36px;
                        background: touch3.has-hover ? #c2410c : #ea580c;
                        border-radius: CS2Theme.radius-xs;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: @tr("ACESSAR TREINO");
                                font-size: 10px;
                                font-weight: 900;
                                letter-spacing: 0.5px;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        touch3 := TouchArea {
                            clicked => {
                                root.status-message = @tr("Abrindo oficina de mapas e teste de desempenho...");
                                root.card-action-clicked("workshop_maps");
                            }
                        }
                    }
                }
            }

            // Seção Inferior: Botão JOGAR CS2 Centralizado + Barra de Status HUD
            VerticalLayout {
                spacing: 6px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;
                    padding-bottom: 2px;

                    TacticalButton {
                        text: root.is-launching ? @tr("INICIANDO...") : @tr("JOGAR CS2");
                        badge: root.is-launching ? @tr("APLICANDO TWEAKS & STEAM") : @tr("INICIAR COM ALTA PERFORMANCE");
                        enabled: !root.is-launching;
                        background-color: CS2Theme.accent-orange;
                        hover-color: #ff771a;
                        custom-border-color: #c2410c;
                        custom-border-hover-color: #ff851b;
                        custom-border-width: 3px;
                        text-color: #ffffff;
                        icon-src: @image-url("assets/icons/play.svg");
                        clicked => {
                            if root.presets.length == 0 {
                                root.show-no-profile-modal = true;
                            } else {
                                root.is-launching = true;
                                root.status-message = @tr("Iniciando Counter-Strike 2 pela Steam com perfil otimizado...");
                                root.launch-cs2-clicked();
                            }
                        }
                    }
                }

                // Barra de Status HUD Tática
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - self.height) / 2;
                        background: root.is-launching ? CS2Theme.accent-orange : CS2Theme.status-success;
                    }

                    Text {
                        text: root.status-message;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 0.3px;
                        color: root.is-launching ? CS2Theme.accent-orange-bright : CS2Theme.text-dim;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // 2.1 View Interna: Gerenciador de Binds CS2 (renderizada dentro da janela principal)
        if root.active-tab == 0 && root.show-binds-view : BindsView {
            horizontal-stretch: 1;
            back-clicked => {
                root.close-binds-view();
                root.status-message = @tr("Visualizando Painel Geral");
            }
            view-mode-changed(grid-mode) => {
                root.content-is-grid-view = grid-mode;
            }
        }

        // 3. Aba de Otimizações Completas (Dividida em Em Game e Sistema)
        if root.active-tab == 1 : VerticalLayout {
            padding-left: 19px;
            padding-right: 19px;
            padding-top: 14px;
            padding-bottom: 12px;
            alignment: space-between;

            // Bloco Superior: Cabeçalho + Seção Em Game + Seção Sistema + Aviso
            VerticalLayout {
                spacing: 10px;

                // Cabeçalho da Central de Otimizações com Ações de Confiança
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: @tr("CENTRAL DE OTIMIZAÇÕES");
                            font-size: 16px;
                            font-weight: 900;
                            letter-spacing: 0.6px;
                            color: CS2Theme.text-primary;
                        }

                        Text {
                            text: @tr("{} de 13 aplicadas", root.game-tweaks-active-count + root.system-tweaks-active-count);
                            font-size: 10px;
                            font-weight: 600;
                            color: root.has-any-tweak-active ? CS2Theme.status-success-bright : CS2Theme.text-dim;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Botão Sólido: ATIVAR TUDO (padrão visual dos botões do Painel)
                        Rectangle {
                            property <bool> can-activate-all: root.has-active-profile && !root.is-all-tweaks-active && !root.is-restoring-defaults && !root.is-launching;
                            height: 36px;
                            y: (parent.height - self.height) / 2;
                            opacity: can-activate-all ? 1.0 : 0.55;
                            background: !can-activate-all
                                ? CS2Theme.bg-card
                                : (activate-all-touch.has-hover ? #0369a1 : #0284c7);
                            border-radius: CS2Theme.radius-xs;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;

                                Text {
                                    text: @tr("ATIVAR TUDO");
                                    font-size: 10px;
                                    font-weight: 900;
                                    letter-spacing: 0.5px;
                                    color: can-activate-all ? #ffffff : CS2Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            activate-all-touch := TouchArea {
                                mouse-cursor: can-activate-all ? pointer : default;
                                clicked => {
                                    root.cfg-dropdown-open = false;
                                    if can-activate-all {
                                        root.cpu-tweak-active = true;
                                        root.timer-tweak-active = true;
                                        root.priority-tweak-active = true;
                                        root.ram-tweak-active = true;
                                        root.gpu-accel-tweak-active = true;
                                        root.dpi-tweak-active = true;
                                        root.mem-compression-tweak-active = true;
                                        root.mmcss-tweak-active = true;
                                        root.hpet-tweak-active = true;
                                        root.game-bar-tweak-active = true;
                                        root.msi-tweak-active = true;
                                        root.power-saving-tweak-active = true;
                                        root.render-queue-tweak-active = true;
                                        root.status-message = @tr("Todos os 13 módulos de otimização ativados.");
                                        root.bulk-tweaks-action("activate_all");
                                    } else if !root.has-active-profile && !root.is-restoring-defaults {
                                        root.handle-tweak-without-profile();
                                    }
                                }
                            }
                        }

                        // Botão Sólido: RESTAURAR PADRÃO (1 clique, padrão visual dos botões do Painel)
                        restore-btn := Rectangle {
                            property <bool> can-restore: !root.is-restoring-defaults && !root.is-launching;
                            height: 36px;
                            y: (parent.height - self.height) / 2;
                            opacity: can-restore ? 1.0 : 0.65;
                            background: !can-restore
                                ? CS2Theme.bg-card
                                : (restore-touch.has-hover ? #b45309 : CS2Theme.accent-t-gold);
                            border-radius: CS2Theme.radius-xs;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: center;

                                Text {
                                    text: root.is-restoring-defaults ? @tr("RESTAURANDO...") : @tr("RESTAURAR PADRÃO");
                                    font-size: 10px;
                                    font-weight: 900;
                                    letter-spacing: 0.5px;
                                    color: can-restore ? #ffffff : CS2Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }

                            restore-touch := TouchArea {
                                mouse-cursor: can-restore ? pointer : default;
                                changed has-hover => {
                                    root.handle-opt-tooltip-hover(
                                        self.has-hover,
                                        "restore_defaults",
                                        @tr("Restaurar Padrão"),
                                        @tr("Desfaz todas as otimizações aplicadas em um clique e restaura o padrão do Windows com segurança."),
                                        CS2Theme.accent-t-amber,
                                        true,
                                        restore-btn.absolute-position.x,
                                        restore-btn.absolute-position.y,
                                        restore-btn.width,
                                        restore-btn.height
                                    );
                                }
                                clicked => {
                                    root.cfg-dropdown-open = false;
                                    if can-restore {
                                        root.hide-opt-tooltip();
                                        root.is-restoring-defaults = true;
                                        root.restore-defaults-clicked();
                                    }
                                }
                            }
                        }
                    }
                }

                // Seção 1: Otimizações em Game (4 módulos aplicados quando o processo cs2.exe roda, sem bordas)
                VerticalLayout {
                    spacing: 7px;

                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 7px;
                            alignment: start;

                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: CS2Theme.accent-orange;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("OTIMIZAÇÕES EM GAME");
                                font-size: 10.5px;
                                font-weight: 900;
                                letter-spacing: 0.6px;
                                color: CS2Theme.accent-orange-bright;
                                vertical-alignment: center;
                            }

                            Text {
                                text: @tr("Aplicadas somente com o processo do CS2 em execução");
                                font-size: 9.5px;
                                color: CS2Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: root.game-tweaks-active-count + "/4";
                            font-size: 10px;
                            font-weight: 800;
                            color: root.game-tweaks-active-count > 0 ? CS2Theme.status-success-bright : CS2Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }

                    // Grade 3 colunas alinhada com a seção Sistema (258px x 46px + CFG preferida 526px)
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 10px;

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                awaiting-game: !root.cpu-tweak-applied;
                                show-inline-tooltip: false;
                                label: @tr("Núcleo 0 Off");
                                info: @tr("Afinidade CPU");
                                tooltip-text: @tr("Afinidade de CPU: Desativa o Núcleo 0 para o CS2 mitigando interrupções do SO.");
                                accent-color: CS2Theme.accent-orange;
                                hover-color: #ff771a;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.cpu-tweak-active;
                                toggled(val) => {
                                    if !val {
                                        root.cpu-tweak-applied = false;
                                    }
                                    root.status-message = val ? @tr("Afinidade: Núcleo 0 desativado para o CS2.") : @tr("Afinidade: Restaurada ao padrão.");
                                    root.tweak-toggled("cpu_core_0", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "cpu_core_0", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                awaiting-game: !root.priority-tweak-applied;
                                show-inline-tooltip: false;
                                label: @tr("Prioridade Alta");
                                info: @tr("Processo CS2");
                                tooltip-text: @tr("Prioridade de Processo: Eleva a prioridade do executável cs2.exe para Tempo Real.");
                                accent-color: CS2Theme.accent-orange;
                                hover-color: #ff771a;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.priority-tweak-active;
                                toggled(val) => {
                                    if !val {
                                        root.priority-tweak-applied = false;
                                    }
                                    root.status-message = val ? @tr("Prioridade de processo definida para Alta.") : @tr("Prioridade de processo: Normal.");
                                    root.tweak-toggled("process_priority", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "process_priority", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                awaiting-game: !root.timer-tweak-applied;
                                show-inline-tooltip: false;
                                label: @tr("Timer 0.5ms");
                                info: @tr("Temporizador");
                                tooltip-text: @tr("Temporizador do Sistema: Define resolução de alta precisão de 0.5ms.");
                                accent-color: CS2Theme.status-success;
                                hover-color: #059669;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.timer-tweak-active;
                                toggled(val) => {
                                    if !val {
                                        root.timer-tweak-applied = false;
                                    }
                                    root.status-message = val ? @tr("Timer: Definido para 0.5ms de alta precisão.") : @tr("Timer: Restaurado ao padrão do Windows.");
                                    root.tweak-toggled("timer_resolution", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "timer_resolution", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                awaiting-game: !root.ram-tweak-applied;
                                show-inline-tooltip: false;
                                label: @tr("Limpar RAM");
                                info: @tr("Empty Standby");
                                tooltip-text: @tr("Empty Standby List: Libera páginas de cache em standby na memória RAM.");
                                accent-color: CS2Theme.accent-ct-blue;
                                hover-color: #0284c7;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.ram-tweak-active;
                                toggled(val) => {
                                    if !val {
                                        root.ram-tweak-applied = false;
                                    }
                                    root.status-message = val ? @tr("Memória: Páginas em standby liberadas.") : @tr("Limpeza de RAM desativada.");
                                    root.tweak-toggled("empty_standby", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "empty_standby", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            CfgSelectorCard {
                                card-width: 526px;
                                card-height: 46px;
                                selected-cfg: root.selected-preferred-cfg;
                                dropdown-open: root.cfg-dropdown-open;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                toggle-dropdown(ax, ay, aw, ah) => {
                                    root.hide-opt-tooltip();
                                    root.cfg-dropdown-anchor-x = ax;
                                    root.cfg-dropdown-anchor-y = ay;
                                    root.cfg-dropdown-anchor-w = aw;
                                    root.cfg-dropdown-anchor-h = ah;
                                    if !root.cfg-dropdown-open {
                                        root.refresh-cfg-files-requested();
                                    }
                                    root.cfg-dropdown-open = !root.cfg-dropdown-open;
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(
                                        hovered,
                                        "preferred_cfg",
                                        @tr("CFG preferida"),
                                        @tr("Selecione um arquivo .cfg de binds para executá-lo automaticamente sempre que o CS2 iniciar."),
                                        CS2Theme.accent-ct-cyan,
                                        false,
                                        ax,
                                        ay,
                                        aw,
                                        ah
                                    );
                                }
                            }
                        }
                    }
                }

                // Divisor horizontal fino e discreto entre as duas seções
                Rectangle {
                    height: 1px;
                    background: rgba(36, 51, 74, 0.45);
                }

                // Seção 2: Otimizações do Sistema (9 ajustes permanentes no Windows, sem bordas)
                VerticalLayout {
                    spacing: 7px;

                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 7px;
                            alignment: start;

                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: CS2Theme.accent-ct-cyan;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: @tr("OTIMIZAÇÕES DO SISTEMA");
                                font-size: 10.5px;
                                font-weight: 900;
                                letter-spacing: 0.6px;
                                color: CS2Theme.accent-ct-cyan;
                                vertical-alignment: center;
                            }

                            Text {
                                text: @tr("Ajustes permanentes aplicados no Windows");
                                font-size: 9.5px;
                                color: CS2Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: root.system-tweaks-active-count + "/9";
                            font-size: 10px;
                            font-weight: 800;
                            color: root.system-tweaks-active-count > 0 ? CS2Theme.status-success-bright : CS2Theme.text-dim;
                            vertical-alignment: center;
                        }
                    }

                    // Grade 3x3 (258px x 46px)
                    VerticalLayout {
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 10px;

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("GPU Apps Off");
                                info: @tr("VRAM & Apps");
                                tooltip-text: @tr("Aceleração GPU: Desativa aceleração de hardware em Discord, Steam e navegadores.");
                                accent-color: CS2Theme.accent-orange;
                                hover-color: #ff771a;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.gpu-accel-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("GPU em apps desativada (mais VRAM para CS2).") : @tr("GPU em apps reativada.");
                                    root.tweak-toggled("gpu_acceleration", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "gpu_acceleration", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("Otimização DPI");
                                info: @tr("Tela Cheia CS2");
                                tooltip-text: @tr("Otimização DPI: Aplica flags de tela cheia exclusiva e reduz input lag no CS2.");
                                accent-color: CS2Theme.accent-ct-cyan;
                                hover-color: #0284c7;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.dpi-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("DPI & Tela cheia: Flags de baixa latência aplicadas.") : @tr("DPI: Configuração de compatibilidade removida.");
                                    root.tweak-toggled("dpi_optimization", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "dpi_optimization", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("Compactar RAM");
                                info: @tr("MMAgent Off");
                                tooltip-text: @tr("Compactação de Memória: Desativa compressão de páginas do Windows (>16GB RAM).");
                                accent-color: CS2Theme.accent-ct-blue;
                                hover-color: #0284c7;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.mem-compression-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("Compactação de RAM desativada (menor latência de CPU).") : @tr("Compactação de RAM reativada.");
                                    root.tweak-toggled("memory_compression", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "memory_compression", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("Agendador MMCSS");
                                info: @tr("Agendador Win");
                                tooltip-text: @tr("MMCSS Games: Otimiza prioridade de rede, áudio e GPU para perfis de jogos.");
                                accent-color: CS2Theme.accent-t-gold;
                                hover-color: #b45309;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.mmcss-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("MMCSS: Perfil de jogos otimizado no registro do Windows.") : @tr("MMCSS: Restaurado ao padrão do Windows.");
                                    root.tweak-toggled("mmcss", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "mmcss", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("HPET Off");
                                info: @tr("Timer BCD");
                                tooltip-text: @tr("Desativar HPET: Desativa o relógio de plataforma no BCD priorizando o TSC da CPU.");
                                accent-color: CS2Theme.status-success;
                                hover-color: #059669;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.hpet-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("HPET desativado no BCD (usando TSC da CPU).") : @tr("HPET restaurado ao padrão de boot.");
                                    root.tweak-toggled("hpet", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "hpet", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("Game Bar Off");
                                info: @tr("DVR & Overlay");
                                tooltip-text: @tr("Xbox Game Bar: Desativa sobreposições, modo Xbox e gravações de fundo GameDVR.");
                                accent-color: CS2Theme.accent-orange;
                                hover-color: #ff771a;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.game-bar-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("Xbox Game Bar, GameDVR e capturas desativados.") : @tr("Xbox Game Bar e capturas restaurados.");
                                    root.tweak-toggled("game_bar", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "game_bar", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 10px;

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("Modo MSI");
                                info: @tr("PCIe IRQ Mode");
                                tooltip-text: @tr("Modo MSI: Ativa interrupções baseadas em mensagens para GPU, Rede e portas USB.");
                                accent-color: CS2Theme.accent-ct-cyan;
                                hover-color: #0284c7;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.msi-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("Modo MSI ativado para GPU (Alta prioridade), Rede e USB.") : @tr("Modo MSI desativado (retornado para INTx).");
                                    root.tweak-toggled("msi", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "msi", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("Power Save Off");
                                info: @tr("PCIe & USB");
                                tooltip-text: @tr("Economia de Energia: Desativa PCIe ASPM e suspensão seletiva de portas USB.");
                                accent-color: CS2Theme.accent-t-gold;
                                hover-color: #b45309;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.power-saving-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("Economia de energia desativada (PCIe ASPM e Suspensão USB).") : @tr("Economia de energia restaurada ao padrão.");
                                    root.tweak-toggled("power_saving", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "power_saving", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }

                            TweakSwitch {
                                button-width: 258px;
                                card-height: 46px;
                                status-badge-mode: true;
                                show-inline-tooltip: false;
                                label: @tr("Render Queue");
                                info: @tr("Flip & Persist");
                                tooltip-text: @tr("Fila de Renderização: FlipQueue AMD = 1 e Persistence Mode em placas NVIDIA.");
                                accent-color: CS2Theme.status-success;
                                hover-color: #059669;
                                enabled: root.has-active-profile && !root.is-restoring-defaults;
                                checked <=> root.render-queue-tweak-active;
                                toggled(val) => {
                                    root.status-message = val ? @tr("Render Queue: FlipQueue AMD definido para 1 / NVIDIA PM ativo.") : @tr("Render Queue restaurada ao padrão de fábrica.");
                                    root.tweak-toggled("render_queue", val);
                                }
                                blocked-click => {
                                    root.handle-tweak-without-profile();
                                }
                                hover-changed(hovered, ax, ay, aw, ah) => {
                                    root.handle-opt-tooltip-hover(hovered, "render_queue", self.label, self.tooltip-text, self.accent-color, false, ax, ay, aw, ah);
                                }
                            }
                        }
                    }
                }

                // Aviso destacado de reinicialização de programas em segundo plano
                Rectangle {
                    height: 36px;
                    background: rgba(245, 158, 11, 0.24);
                    border-width: 1.5px;
                    border-color: CS2Theme.accent-t-amber;
                    border-radius: CS2Theme.radius-sm;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 10px;
                        alignment: start;

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: CS2Theme.radius-xs;
                            background: CS2Theme.accent-t-gold;
                            y: (parent.height - self.height) / 2;

                            Image {
                                source: @image-url("assets/icons/info.svg");
                                width: 13px;
                                height: 13px;
                                colorize: #0b0f17;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }

                        Text {
                            text: @tr("ATENÇÃO:");
                            font-size: 10.5px;
                            font-weight: 900;
                            letter-spacing: 0.5px;
                            color: CS2Theme.accent-t-amber;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Algumas otimizações podem reiniciar programas como: Discord, Navegadores e Steam.");
                            font-size: 11px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }

            // Campo de Parâmetros de Inicialização e Botão de Edição/Salvamento (R3)
            if root.active-preset != "" : HorizontalLayout {
                alignment: center;
                spacing: 10px;

                Rectangle {
                    width: 740px;
                    height: 38px;
                    background: root.is-editing-launch-args ? CS2Theme.bg-surface : CS2Theme.bg-card;
                    border-radius: CS2Theme.radius-sm;
                    border-width: root.is-editing-launch-args ? (launch-input.has-focus ? 2px : 1px) : 1px;
                    border-color: root.is-editing-launch-args 
                        ? (launch-input.has-focus ? CS2Theme.accent-orange : CS2Theme.border-hover) 
                        : CS2Theme.border;
                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;

                        Rectangle {
                            width: 88px;
                            height: 20px;
                            border-radius: CS2Theme.radius-xs;
                            background: root.is-editing-launch-args 
                                ? CS2Theme.accent-orange-soft 
                                : CS2Theme.bg-surface;
                            border-width: 1px;
                            border-color: root.is-editing-launch-args 
                                ? CS2Theme.accent-orange 
                                : CS2Theme.border;
                            y: (parent.height - self.height) / 2;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }

                            Text {
                                text: @tr("PARÂMETROS");
                                font-size: 8px;
                                font-weight: 900;
                                letter-spacing: 0.6px;
                                color: root.is-editing-launch-args ? CS2Theme.accent-orange-bright : CS2Theme.text-dim;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        launch-input := TextInput {
                            text <=> root.launch-args-text;
                            read-only: !root.is-editing-launch-args;
                            color: root.is-editing-launch-args ? CS2Theme.text-primary : CS2Theme.text-muted;
                            font-size: 11px;
                            font-weight: 600;
                            single-line: true;
                            vertical-alignment: center;
                            accepted => {
                                if root.is-editing-launch-args {
                                    root.is-editing-launch-args = false;
                                    root.status-message = @tr("Salvando parâmetros no perfil '{}'...", root.active-preset);
                                    root.save-launch-args-clicked(root.launch-args-text);
                                }
                            }
                        }
                    }

                    if root.launch-args-text == "" : Text {
                        x: 114px;
                        y: (parent.height - self.height) / 2;
                        text: root.is-editing-launch-args ? @tr("Ex: -novid -high +fps_max 0") : @tr("Nenhum parâmetro de inicialização configurado");
                        color: CS2Theme.text-dim;
                        font-size: 11px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 44px;
                    height: 38px;
                    background: edit-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card;
                    border-radius: CS2Theme.radius-sm;
                    border-width: edit-touch.has-hover ? 2px : 1px;
                    border-color: root.is-editing-launch-args
                        ? (edit-touch.has-hover ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange)
                        : (edit-touch.has-hover ? CS2Theme.accent-orange : CS2Theme.border);

                    animate background { duration: 120ms; }
                    animate border-color { duration: 120ms; }

                    Image {
                        source: root.is-editing-launch-args 
                            ? @image-url("assets/icons/save.svg") 
                            : @image-url("assets/icons/pencil.svg");
                        width: 16px;
                        height: 16px;
                        colorize: edit-touch.has-hover 
                            ? CS2Theme.accent-orange-bright 
                            : (root.is-editing-launch-args ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange);
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        animate colorize { duration: 120ms; }
                    }

                    edit-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            if !root.is-editing-launch-args {
                                root.is-editing-launch-args = true;
                                root.status-message = @tr("Edição de parâmetros desbloqueada para o perfil '{}'.", root.active-preset);
                                launch-input.focus();
                            } else {
                                root.is-editing-launch-args = false;
                                root.status-message = @tr("Salvando parâmetros no perfil '{}'...", root.active-preset);
                                root.save-launch-args-clicked(root.launch-args-text);
                            }
                        }
                    }
                }
            }

            // Seção Intermediária (Sem Perfis): Botões de Ação Exclusivos (R1)
            if root.presets.length == 0 : HorizontalLayout {
                alignment: center;
                spacing: 16px;

                TacticalButton {
                    text: @tr("OTIMIZAR AUTOMATICAMENTE");
                    badge: @tr("PERFIL RECOMENDADO • BAIXA LATÊNCIA");
                    enabled: !root.is-launching;
                    background-color: CS2Theme.accent-orange;
                    hover-color: #ff771a;
                    custom-border-color: #c2410c;
                    custom-border-hover-color: #ff851b;
                    custom-border-width: 3px;
                    button-width: 320px;
                    text-color: #ffffff;
                    icon-src: @image-url("assets/icons/rocket.svg");
                    clicked => {
                        root.hide-opt-tooltip();
                        root.cfg-dropdown-open = false;
                        root.auto-optimize-is-launch = false;
                        root.auto-optimize-is-restore = false;
                        root.auto-optimize-progress = 0.0;
                        root.auto-optimize-step-name = @tr("Iniciando calibração...");
                        root.auto-optimize-stage-title = "";
                        root.auto-optimize-stage-subtitle = "";
                        root.auto-optimize-finished = false;
                        root.show-auto-optimize-modal = true;
                        root.auto-optimize-clicked();
                    }
                }

                AddPresetButton {
                    is-empty: true;
                    clicked => {
                        root.hide-opt-tooltip();
                        root.cfg-dropdown-open = false;
                        root.create-modal-error = "";
                        root.show-create-modal = true;
                    }
                }
            }

            // Seção Intermediária (Com Perfis): Perfis de Otimização (config/optimzations) - Seleção Única (R4)
            if root.presets.length > 0 : VerticalLayout {
                spacing: 8px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 18px;
                        height: 1px;
                        background: CS2Theme.border;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: @tr("PERFIS DE OTIMIZAÇÃO (CONFIG/OPTIMZATIONS)");
                        font-size: 10px;
                        font-weight: 800;
                        letter-spacing: 0.8px;
                        color: CS2Theme.text-dim;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 18px;
                        height: 1px;
                        background: CS2Theme.border;
                        y: (parent.height - self.height) / 2;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    spacing: root.presets.length > 2 ? 10px : 16px;

                    for preset in root.presets : PresetButton {
                        file-name: preset.name;
                        tag: preset.tag == "auto" ? @tr("HARDWARE ADAPTATIVO")
                            : preset.tag == "custom" ? @tr("CUSTOMIZADO / MANUAL")
                            : @tr("PERFIL DO USUÁRIO");
                        is-active: root.active-preset == preset.name;
                        accent-color: preset.name == "AutoDetect" ? CS2Theme.accent-ct-cyan : CS2Theme.accent-orange;
                        active-bg: preset.name == "AutoDetect" ? CS2Theme.accent-ct-soft : CS2Theme.accent-orange-soft;
                        button-width: root.presets.length > 2 ? 250px : 350px;
                        selected => {
                            root.cfg-dropdown-open = false;
                            root.active-preset = preset.name;
                            root.is-editing-launch-args = false;
                            root.status-message = @tr("Perfil ativo: {}", preset.name);
                            root.preset-selected(preset.name);
                        }
                        delete => {
                            root.hide-opt-tooltip();
                            root.cfg-dropdown-open = false;
                            root.target-delete-profile = preset.name;
                            root.show-delete-modal = true;
                        }
                    }

                    AddPresetButton {
                        is-empty: false;
                        clicked => {
                            root.hide-opt-tooltip();
                            root.cfg-dropdown-open = false;
                            root.create-modal-error = "";
                            root.show-create-modal = true;
                        }
                    }
                }
            }

            // Seção Inferior: Barra de Status HUD Tática
            VerticalLayout {
                spacing: 6px;
                alignment: center;

                // Barra de Status HUD Tática
                HorizontalLayout {
                    alignment: center;
                    spacing: 8px;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - self.height) / 2;
                        background: root.is-restoring-defaults ? CS2Theme.accent-t-amber : CS2Theme.status-success;
                    }

                    Text {
                        text: root.status-message;
                        font-size: 10px;
                        font-weight: 600;
                        letter-spacing: 0.3px;
                        color: root.is-restoring-defaults ? CS2Theme.accent-t-amber : CS2Theme.text-dim;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // 4. Aba de Configurações
        if root.active-tab == 2 : VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 16px;
            alignment: space-between;

            VerticalLayout {
                spacing: 14px;

                // Cabeçalho da Aba
                VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: @tr("CONFIGURAÇÕES GERAIS");
                        font-size: 16px;
                        font-weight: 900;
                        letter-spacing: 0.6px;
                        color: CS2Theme.text-primary;
                    }
                    Text {
                        text: @tr("Preferências do aplicativo, integração com o sistema e links da comunidade.");
                        font-size: 11px;
                        color: CS2Theme.text-dim;
                    }
                }

                // Seção 1: Idioma da Interface
                VerticalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: @tr("IDIOMA DA INTERFACE");
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            color: CS2Theme.text-cyan;
                        }
                        Text {
                            text: @tr("Selecione o idioma padrão para a interface do CounterRush.");
                            font-size: 10px;
                            color: CS2Theme.text-dim;
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;

                        for lang in root.available-languages : Rectangle {
                            property <bool> is-selected: lang.code == root.active-language;
                            width: 120px;
                            height: 32px;
                            background: is-selected ? CS2Theme.bg-card-selected : (lang-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface);
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: is-selected ? CS2Theme.accent-ct-cyan : (lang-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border);
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                if is-selected : VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: CS2Theme.accent-ct-cyan;
                                    }
                                }

                                Text {
                                    text: lang.display-name;
                                    font-size: 11px;
                                    font-weight: is-selected ? 800 : 600;
                                    color: is-selected ? CS2Theme.text-primary : CS2Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            lang-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.language-selected(lang.code);
                                }
                            }
                        }
                    }
                }

                // Seção 2: Visualização de Conteúdo (Padrão Global)
                VerticalLayout {
                    spacing: 8px;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: @tr("VISUALIZAÇÃO DE CONTEÚDO");
                            font-size: 12px;
                            font-weight: 800;
                            letter-spacing: 0.5px;
                            color: CS2Theme.text-cyan;
                        }
                        Text {
                            text: @tr("Defina o modo padrão (Lista ou Grade) para exibir conteúdos em todo o CounterRush.");
                            font-size: 10px;
                            color: CS2Theme.text-dim;
                        }
                    }

                    HorizontalLayout {
                        alignment: start;
                        spacing: 10px;

                        Rectangle {
                            property <bool> is-selected: !root.content-is-grid-view;
                            width: 120px;
                            height: 32px;
                            background: is-selected ? CS2Theme.bg-card-selected : (settings-list-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface);
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: is-selected ? CS2Theme.accent-ct-cyan : (settings-list-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border);
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 12px;
                                        height: 10px;
                                        viewbox-width: 14;
                                        viewbox-height: 12;
                                        stroke: is-selected ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                        stroke-width: 1.7px;
                                        commands: "M 1 2 L 13 2 M 1 6 L 13 6 M 1 10 L 13 10";
                                    }
                                }

                                Text {
                                    text: @tr("Lista");
                                    font-size: 11px;
                                    font-weight: is-selected ? 800 : 600;
                                    color: is-selected ? CS2Theme.text-primary : CS2Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            settings-list-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if root.content-is-grid-view {
                                        root.content-is-grid-view = false;
                                        BindsState.is-grid-view = false;
                                        root.content-view-mode-changed(false);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            property <bool> is-selected: root.content-is-grid-view;
                            width: 120px;
                            height: 32px;
                            background: is-selected ? CS2Theme.bg-card-selected : (settings-grid-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface);
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: is-selected ? CS2Theme.accent-ct-cyan : (settings-grid-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border);
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 11px;
                                        height: 11px;
                                        viewbox-width: 12;
                                        viewbox-height: 12;
                                        stroke: is-selected ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                        stroke-width: 1.4px;
                                        fill: is-selected ? CS2Theme.accent-ct-cyan : transparent;
                                        commands: "M 1 1 L 4.5 1 L 4.5 4.5 L 1 4.5 Z M 7.5 1 L 11 1 L 11 4.5 L 7.5 4.5 Z M 1 7.5 L 4.5 7.5 L 4.5 11 L 1 11 Z M 7.5 7.5 L 11 7.5 L 11 11 L 7.5 11 Z";
                                    }
                                }

                                Text {
                                    text: @tr("Grade");
                                    font-size: 11px;
                                    font-weight: is-selected ? 800 : 600;
                                    color: is-selected ? CS2Theme.text-primary : CS2Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            settings-grid-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if !root.content-is-grid-view {
                                        root.content-is-grid-view = true;
                                        BindsState.is-grid-view = true;
                                        root.content-view-mode-changed(true);
                                    }
                                }
                            }
                        }
                    }
                }

                // Seção 3: Inicialização e Sistema
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: @tr("INICIALIZAÇÃO E SISTEMA");
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        color: CS2Theme.accent-t-gold;
                    }

                    // Linha 1: Iniciar com o Windows
                    Rectangle {
                        height: 42px;
                        background: row1-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                        border-radius: CS2Theme.radius-xs;
                        border-width: 1px;
                        border-color: row1-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: @tr("Iniciar com o Windows");
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: CS2Theme.text-primary;
                                }
                                Text {
                                    text: @tr("Executar o CounterRush automaticamente na inicialização do sistema operacional.");
                                    font-size: 10px;
                                    color: CS2Theme.text-dim;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 44px;
                                    height: 22px;
                                    background: root.start-with-system ? #ffffff : CS2Theme.bg-main;
                                    border-radius: CS2Theme.radius-xs;
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;

                                        Rectangle {
                                            width: 5px;
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: root.start-with-system ? CS2Theme.accent-orange : CS2Theme.text-dim;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: root.start-with-system ? @tr("ON") : @tr("OFF");
                                            font-size: 8px;
                                            font-weight: 900;
                                            letter-spacing: 0.5px;
                                            color: root.start-with-system ? #0b0f17 : CS2Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        row1-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.start-with-system = !root.start-with-system;
                                if (!root.start-with-system) {
                                    root.optimize-on-steam-launch = false;
                                }
                                root.start-with-system-toggled(root.start-with-system);
                            }
                        }
                    }

                    // Linha 2: Auto-Otimização Steam
                    Rectangle {
                        height: 42px;
                        background: row2-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                        border-radius: CS2Theme.radius-xs;
                        border-width: 1px;
                        border-color: row2-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: @tr("Auto-Otimização Steam");
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: CS2Theme.text-primary;
                                }
                                Text {
                                    text: @tr("Detectar a execução do Counter-Strike 2 pela Steam e aplicar otimizações em tempo real.");
                                    font-size: 10px;
                                    color: CS2Theme.text-dim;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 44px;
                                    height: 22px;
                                    background: root.optimize-on-steam-launch ? #ffffff : CS2Theme.bg-main;
                                    border-radius: CS2Theme.radius-xs;
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;

                                        Rectangle {
                                            width: 5px;
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: root.optimize-on-steam-launch ? CS2Theme.accent-orange : CS2Theme.text-dim;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: root.optimize-on-steam-launch ? @tr("ON") : @tr("OFF");
                                            font-size: 8px;
                                            font-weight: 900;
                                            letter-spacing: 0.5px;
                                            color: root.optimize-on-steam-launch ? #0b0f17 : CS2Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        row2-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.optimize-on-steam-launch = !root.optimize-on-steam-launch;
                                if (root.optimize-on-steam-launch) {
                                    root.start-with-system = true;
                                }
                                root.optimize-on-steam-launch-toggled(root.optimize-on-steam-launch);
                            }
                        }
                    }

                    // Linha 3: Minimizar para a Bandeja do Sistema
                    Rectangle {
                        height: 42px;
                        background: row3-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                        border-radius: CS2Theme.radius-xs;
                        border-width: 1px;
                        border-color: row3-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;
                        animate background { duration: 100ms; }
                        animate border-color { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: @tr("Minimizar para a bandeja do sistema");
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: CS2Theme.text-primary;
                                }
                                Text {
                                    text: @tr("Manter o CounterRush em execução em segundo plano ao fechar a janela principal.");
                                    font-size: 10px;
                                    color: CS2Theme.text-dim;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Rectangle {
                                    width: 44px;
                                    height: 22px;
                                    background: root.minimize-to-tray ? #ffffff : CS2Theme.bg-main;
                                    border-radius: CS2Theme.radius-xs;
                                    animate background { duration: 120ms; }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;

                                        Rectangle {
                                            width: 5px;
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: root.minimize-to-tray ? CS2Theme.accent-orange : CS2Theme.text-dim;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        Text {
                                            text: root.minimize-to-tray ? @tr("ON") : @tr("OFF");
                                            font-size: 8px;
                                            font-weight: 900;
                                            letter-spacing: 0.5px;
                                            color: root.minimize-to-tray ? #0b0f17 : CS2Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        row3-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.minimize-to-tray = !root.minimize-to-tray;
                                root.minimize-to-tray-toggled(root.minimize-to-tray);
                            }
                        }
                    }
                }

                // Seção 3: Sobre e Comunidade
                VerticalLayout {
                    spacing: 8px;

                    Text {
                        text: @tr("SOBRE E COMUNIDADE");
                        font-size: 12px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        color: CS2Theme.accent-orange;
                    }

                    HorizontalLayout {
                        spacing: 10px;

                        // Ação 1: Compartilhar Projeto
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 58px;
                            background: share-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: share-touch.has-hover ? CS2Theme.accent-orange : CS2Theme.border;
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: @tr("Compartilhar Projeto");
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: share-touch.has-hover ? CS2Theme.accent-orange : CS2Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: @tr("Copiar o link oficial do CounterRush para divulgar o projeto com amigos.");
                                    font-size: 9px;
                                    color: CS2Theme.text-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            share-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.share-project-clicked();
                                }
                            }
                        }

                        // Ação 2: Repositório GitHub
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 58px;
                            background: gh-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: gh-touch.has-hover ? CS2Theme.accent-ct-cyan : CS2Theme.border;
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: @tr("Repositório GitHub");
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: gh-touch.has-hover ? CS2Theme.accent-ct-cyan : CS2Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: @tr("Acessar o código-fonte aberto, notas de versão e novidades no GitHub.");
                                    font-size: 9px;
                                    color: CS2Theme.text-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            gh-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-external-url("https://github.com/ThainanViniciusKatchan/CounterRush");
                                }
                            }
                        }

                        // Ação 3: Website Oficial
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 58px;
                            background: web-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1px;
                            border-color: web-touch.has-hover ? CS2Theme.status-success : CS2Theme.border;
                            animate background { duration: 100ms; }
                            animate border-color { duration: 100ms; }

                            VerticalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                alignment: center;
                                spacing: 3px;

                                Text {
                                    text: @tr("Website Oficial");
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: web-touch.has-hover ? CS2Theme.status-success : CS2Theme.text-primary;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: @tr("Visitar a página inicial oficial do CounterRush na web.");
                                    font-size: 9px;
                                    color: CS2Theme.text-dim;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }

                            web-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-external-url("https://feitonobrasil.dev.br");
                                }
                            }
                        }
                    }
                }
            }

            // HUD Inferior de Status
            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: CS2Theme.status-success;
                    }
                }

                Text {
                    text: root.status-message;
                    font-size: 10px;
                    font-weight: 600;
                    color: CS2Theme.text-dim;
                }
            }
        }

        // 5. Aba de Ranking
        if root.active-tab == 3 : VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            padding-top: 18px;
            padding-bottom: 16px;
            spacing: 16px;
            alignment: space-between;

            Text {
                text: @tr("RANKING CS & TABELA VALVE");
                font-size: 16px;
                font-weight: 900;
                letter-spacing: 0.6px;
                color: CS2Theme.text-primary;
            }

            Rectangle {
                background: CS2Theme.bg-card;
                border-radius: CS2Theme.radius-sm;
                VerticalLayout {
                    padding: 24px;
                    spacing: 8px;
                    alignment: center;

                    Text {
                            text: @tr("EM BREVE");
                            font-size: 50px;
                            font-weight: 900;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 8px;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    y: (parent.height - self.height) / 2;
                    background: CS2Theme.status-success;
                }

                Text {
                    text: root.status-message;
                    font-size: 10px;
                    font-weight: 600;
                    color: CS2Theme.text-dim;
                }
            }
        }
    }

    // Popup flutuante sólido e adaptativo para descrições da aba Otimizações
    if root.opt-tooltip-visible && !root.cfg-dropdown-open && root.active-tab == 1 && !root.show-binds-view && !root.show-create-modal && !root.show-delete-modal && !root.show-no-profile-modal && !root.show-in-development-modal && !root.show-auto-optimize-modal : Rectangle {
        property <length> content-left-x: 160px;
        property <length> content-right-x: max(content-left-x, root.width - self.width - 12px);
        property <length> local-anchor-x: root.opt-tooltip-anchor-x - root.absolute-position.x;
        property <length> local-anchor-y: root.opt-tooltip-anchor-y - root.absolute-position.y;
        property <length> above-y: local-anchor-y - self.height - 8px;
        property <length> below-y: local-anchor-y + root.opt-tooltip-anchor-h + 8px;

        width: clamp(opt-tooltip-content.preferred-width + 2px, 160px, 320px);
        height: opt-tooltip-content.preferred-height;
        x: clamp(local-anchor-x + (root.opt-tooltip-anchor-w - self.width) / 2, content-left-x, content-right-x);
        y: root.opt-tooltip-prefer-below
            ? (below-y + self.height <= root.height - 12px ? below-y : max(12px, above-y))
            : (above-y >= 12px ? above-y : min(root.height - self.height - 12px, below-y));
        background: #0f172a;
        border-width: 1px;
        border-color: root.opt-tooltip-accent;
        border-radius: CS2Theme.radius-sm;
        drop-shadow-color: rgba(0, 0, 0, 0.65);
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 6px;

        opt-tooltip-content := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;

            Text {
                text: root.opt-tooltip-title;
                font-size: 10.5px;
                font-weight: 800;
                color: root.opt-tooltip-accent;
                wrap: word-wrap;
            }

            Text {
                text: root.opt-tooltip-description;
                font-size: 10px;
                font-weight: 600;
                color: #f8fafc;
                wrap: word-wrap;
            }
        }
    }

    // Overlay do Dropdown de seleção da CFG preferida na aba Otimizações
    if root.cfg-dropdown-open && root.active-tab == 1 && !root.show-binds-view && !root.show-create-modal && !root.show-delete-modal && !root.show-no-profile-modal && !root.show-in-development-modal && !root.show-auto-optimize-modal : TouchArea {
        clicked => {
            root.cfg-dropdown-open = false;
        }
    }

    if root.cfg-dropdown-open && root.active-tab == 1 && !root.show-binds-view && !root.show-create-modal && !root.show-delete-modal && !root.show-no-profile-modal && !root.show-in-development-modal && !root.show-auto-optimize-modal : Rectangle {
        x: clamp(root.cfg-dropdown-anchor-x - root.absolute-position.x, 160px, root.width - self.width - 12px);
        y: root.cfg-dropdown-anchor-y - root.absolute-position.y + root.cfg-dropdown-anchor-h + 6px;
        width: root.cfg-dropdown-anchor-w;
        height: root.available-cfg-files.length == 0
            ? 104px
            : min(226px, 46px + root.available-cfg-files.length * 32px);
        background: CS2Theme.bg-surface-elevated;
        border-radius: CS2Theme.radius-sm;
        border-width: 1px;
        border-color: CS2Theme.accent-ct-cyan;
        drop-shadow-color: rgba(0, 0, 0, 0.58);
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 6px;
        clip: true;

        TouchArea { }

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            Rectangle {
                property <bool> is-none: root.selected-preferred-cfg == "";
                height: 30px;
                border-radius: CS2Theme.radius-xs;
                background: is-none
                    ? CS2Theme.bg-card-selected
                    : (none-cfg-touch.has-hover ? CS2Theme.bg-card-hover : transparent);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: space-between;

                    Text {
                        text: @tr("Nenhuma (desativar)");
                        font-size: 11px;
                        font-weight: is-none ? 800 : 600;
                        color: is-none ? CS2Theme.text-primary : CS2Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                none-cfg-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.selected-preferred-cfg = "";
                        root.cfg-dropdown-open = false;
                        root.is-editing-launch-args = false;
                        root.preferred-cfg-selected("");
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: CS2Theme.border;
            }

            if root.available-cfg-files.length == 0 : VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 2px;

                Text {
                    text: @tr("Nenhum arquivo .cfg encontrado");
                    font-size: 11px;
                    font-weight: 700;
                    color: CS2Theme.text-muted;
                    horizontal-alignment: center;
                }

                Text {
                    text: @tr("Crie arquivos em Painel → Binds Táticas.");
                    font-size: 9.5px;
                    color: #8ea2bc;
                    horizontal-alignment: center;
                }
            }

            if root.available-cfg-files.length > 0 : ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 2px;

                    for cfg-name in root.available-cfg-files : Rectangle {
                        property <bool> is-current: cfg-name == root.selected-preferred-cfg;
                        height: 30px;
                        border-radius: CS2Theme.radius-xs;
                        background: is-current
                            ? CS2Theme.accent-ct-soft
                            : (cfg-opt-touch.has-hover ? CS2Theme.bg-card-hover : transparent);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 8px;
                                horizontal-stretch: 1;

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        source: @image-url("assets/icons/cfg.svg");
                                        width: 13px;
                                        height: 13px;
                                        colorize: is-current ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                    }
                                }

                                Text {
                                    text: cfg-name;
                                    font-size: 11px;
                                    font-weight: is-current ? 800 : 600;
                                    color: is-current ? CS2Theme.text-cyan : CS2Theme.text-primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            if is-current : Text {
                                text: @tr("ATIVO");
                                font-size: 8px;
                                font-weight: 900;
                                color: CS2Theme.text-cyan;
                                vertical-alignment: center;
                            }
                        }

                        cfg-opt-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected-preferred-cfg = cfg-name;
                                root.cfg-dropdown-open = false;
                                root.is-editing-launch-args = false;
                                root.preferred-cfg-selected(cfg-name);
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Overlay de Criação de Perfil de Otimização (.json)
    if root.show-create-modal : CreateProfileDialog {
        error-message: root.create-modal-error;
        is-grid-view <=> root.content-is-grid-view;
        cancel => {
            root.show-create-modal = false;
            root.create-modal-error = "";
        }
        confirmed(data) => {
            root.create-profile-confirmed(data);
        }
        view-mode-changed(grid-mode) => {
            BindsState.is-grid-view = grid-mode;
            root.content-view-mode-changed(grid-mode);
        }
    }

    // Modal Overlay de Confirmação de Exclusão de Perfil (.json)
    if root.show-delete-modal : DeleteProfileDialog {
        profile-name: root.target-delete-profile;
        cancel => {
            root.show-delete-modal = false;
            root.target-delete-profile = "";
        }
        confirmed => {
            root.show-delete-modal = false;
            root.delete-profile-confirmed(root.target-delete-profile);
            root.target-delete-profile = "";
        }
    }

    // Modal Overlay de Aviso de Ausência de Perfil ao Jogar CS2
    if root.show-no-profile-modal : NoProfileDialog {
        close => {
            root.show-no-profile-modal = false;
        }
        create-profile => {
            root.show-no-profile-modal = false;
            root.close-binds-view();
            root.active-tab = 1;
            root.status-message = @tr("Ajustes Avançados de Hardware");
        }
    }

    // Modal Overlay de Recurso em Desenvolvimento
    if root.show-in-development-modal : InDevelopmentDialog {
        feature-name: root.in-development-feature-name;
        close => {
            root.show-in-development-modal = false;
            root.in-development-feature-name = "";
        }
    }

    // Modal Overlay de Animação de Otimização Automática e Inicialização
    if root.show-auto-optimize-modal : AutoOptimizeDialog {
        progress: root.auto-optimize-progress;
        current-step-name: root.auto-optimize-step-name;
        stage-title: root.auto-optimize-stage-title;
        stage-subtitle: root.auto-optimize-stage-subtitle;
        is-finished: root.auto-optimize-finished;
        is-launch-mode: root.auto-optimize-is-launch;
        is-restore-mode: root.auto-optimize-is-restore;
        confirm-cancel => {
            root.show-auto-optimize-modal = false;
            root.auto-optimize-is-restore = false;
            root.cancel-auto-optimize-clicked();
        }
        play-cs2 => {
            root.show-auto-optimize-modal = false;
            root.auto-optimize-is-restore = false;
            root.close-binds-view();
            root.active-tab = 0;
            root.status-message = @tr("Iniciando Counter-Strike 2 pela Steam com perfil otimizado...");
            root.is-launching = true;
            root.launch-cs2-clicked();
        }
        close => {
            root.show-auto-optimize-modal = false;
            root.auto-optimize-is-restore = false;
        }
    }
}
