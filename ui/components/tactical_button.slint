import { CS2Theme } from "../theme.slint";

export component TacticalButton inherits Rectangle {
    in property <string> text: "JOGAR CS2";
    in property <string> badge: "COMPETITIVO • 0.5ms";
    in property <color> background-color: CS2Theme.accent-orange;
    in property <color> hover-color: #ff771a;
    in property <color> custom-border-color: #c2410c;
    in property <color> custom-border-hover-color: #d94e09;
    in property <length> custom-border-width: 3px;
    in property <length> button-width: 280px;
    in property <color> text-color: #ffffff;
    in property <image> icon-src;
    callback clicked();

    width: root.button-width;
    height: 52px;
    background: touch.has-hover ? root.hover-color : root.background-color;
    border-radius: CS2Theme.radius-sm;
    border-width: root.custom-border-width;
    border-color: touch.has-hover ? root.custom-border-hover-color : root.custom-border-color;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 12px;
        alignment: center;

        if root.icon-src.width > 0 : Image {
            source: root.icon-src;
            width: 18px;
            height: 18px;
            colorize: root.text-color;
            y: (parent.height - self.height) / 2;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.text;
                font-size: 13px;
                font-weight: 900;
                letter-spacing: 0.8px;
                color: root.text-color;
                horizontal-alignment: center;
            }

            if root.badge != "" : Text {
                text: root.badge;
                font-size: 8px;
                font-weight: 800;
                letter-spacing: 0.6px;
                color: rgba(255, 255, 255, 0.85);
                horizontal-alignment: center;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}
