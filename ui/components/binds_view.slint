import { ScrollView } from "std-widgets.slint";
import { CS2Theme } from "../theme.slint";
import { BindCommandCard } from "bind_command_card.slint";
import { TweakSwitch } from "tweak_switch.slint";

export struct BindCategoryTab {
    index: int,
    tab-label: string,
    title: string,
    subtitle: string,
    total-count: int,
    selected-count: int,
    match-count: int,
}

export struct BindGridCell {
    present: bool,
    command-index: int,
    title: string,
    info: string,
    description: string,
    command-value: string,
    checked: bool,
}

export struct BindCatalogRow {
    // 0 = Categoria, 1 = Subcategoria, 2 = Comando em lista, 3 = Linha de grade (até 4 botões)
    row-kind: int,
    command-index: int,
    title: string,
    subtitle: string,
    command-value: string,
    checked: bool,
    cell-0: BindGridCell,
    cell-1: BindGridCell,
    cell-2: BindGridCell,
    cell-3: BindGridCell,
}

export global BindsState {
    // Estado da barra superior fixa
    in-out property <string> file-name-input: "";
    in-out property <string> selected-existing-file: "";
    in-out property <[string]> existing-cfg-files: ["autoexec.cfg", "meuexec.cfg"];
    in-out property <bool> selector-dropdown-open: false;
    in-out property <string> bound-key: "";
    in-out property <bool> is-listening-key: false;
    in-out property <string> save-mode-badge: @tr("NOVO ARQUIVO");
    in-out property <bool> is-creating-new-file: true;

    // Estado da listagem, navegação, visualização, pesquisa e prévia
    in-out property <bool> backend-connected: false;
    in-out property <int> active-category-index: 1;
    in-out property <bool> is-grid-view: false;
    in-out property <string> search-query: "";
    in-out property <int> filtered-commands-count: 5;
    in-out property <int> selected-commands-count: 0;
    in-out property <string> bind-preview-line: "";
    in-out property <string> status-message: @tr("Selecione ou digite um arquivo .cfg, capture uma tecla e marque os comandos desejados.");
    in-out property <string> status-kind: "info";
    in-out property <bool> show-conflict-prompt: false;
    in-out property <string> conflict-message: "";

    // Estado do popup flutuante de descrição da grade
    in-out property <bool> tooltip-visible: false;
    in-out property <int> tooltip-command-index: -1;
    in-out property <string> tooltip-title: "";
    in-out property <string> tooltip-description: "";
    in-out property <bool> tooltip-checked: false;
    in-out property <length> tooltip-anchor-x: 0px;
    in-out property <length> tooltip-anchor-y: 0px;
    in-out property <length> tooltip-anchor-w: 0px;
    in-out property <length> tooltip-anchor-h: 0px;

    in-out property <[BindCategoryTab]> category-tabs: [
        { index: 0, tab-label: "Movimentação", title: "1. Movimentação", subtitle: "Deslocamento, saltos, postura e controle de câmera (Source 2)", total-count: 13, selected-count: 0, match-count: 0 },
        { index: 1, tab-label: "Treinamento", title: "2. Treinamento", subtitle: "Exigem sv_cheats 1", total-count: 23, selected-count: 0, match-count: 0 },
        { index: 2, tab-label: "Jogabilidade", title: "3. Jogabilidade", subtitle: "Permitidos em partidas competitivas", total-count: 18, selected-count: 0, match-count: 0 },
        { index: 3, tab-label: "Comunicação", title: "4. Comunicação", subtitle: "Voz, clutch binds, pings 3D, rodas e rádio", total-count: 33, selected-count: 0, match-count: 0 },
        { index: 4, tab-label: "Armas e Granadas", title: "5. Armas e Granadas", subtitle: "Seleção via slots e compras rápidas Source 2", total-count: 64, selected-count: 0, match-count: 0 },
        { index: 5, tab-label: "Monitoramento", title: "6. Monitoramento (FPS, Telemetria e Rede)", subtitle: "Telemetria nativa do HUD CS2 e diagnósticos", total-count: 10, selected-count: 0, match-count: 0 },
        { index: 6, tab-label: "Outros", title: "7. Outros (Áudio, Demos/Replays, HUD e Sistema)", subtitle: "Som, análise de demos GOTV, HUD e manutenção", total-count: 25, selected-count: 0, match-count: 0 },
    ];

    in-out property <[BindCatalogRow]> catalog-rows: [
        { row-kind: 0, command-index: -1, title: "2. Treinamento", subtitle: "Exigem sv_cheats 1", command-value: "", checked: false },
        { row-kind: 1, command-index: -1, title: "Movimentação Livre e Teleporte de Precisão", subtitle: "", command-value: "", checked: false },
        { row-kind: 2, command-index: 13, title: "noclip", subtitle: "Liga/desliga o voo livre atravessando paredes e objetos.", command-value: "noclip", checked: false },
        { row-kind: 2, command-index: 14, title: "getpos", subtitle: "Imprime no console as coordenadas exatas (setpos e setang) da posição e mira atuais.", command-value: "getpos", checked: false },
        { row-kind: 1, command-index: -1, title: "Treino Avançado de Granadas", subtitle: "", command-value: "", checked: false },
        { row-kind: 2, command-index: 16, title: "sv_rethrow_last_grenade", subtitle: "Arremessa novamente a última granada jogada no servidor.", command-value: "sv_rethrow_last_grenade", checked: false },
        { row-kind: 2, command-index: 19, title: "ent_fire smokegrenade_projectile kill; ent_fire molotov_projectile kill; ent_fire inferno kill; ent_fire flashbang_projectile kill; ent_fire hegrenade_projectile kill; ent_fire decoy_projectile kill; stopsound", subtitle: "Apaga instantaneamente todas as smokes, Molotovs, granadas no ar e corta efeitos sonoros ativos.", command-value: "ent_fire smokegrenade_projectile kill; ent_fire molotov_projectile kill; ent_fire inferno kill; ent_fire flashbang_projectile kill; ent_fire hegrenade_projectile kill; ent_fire decoy_projectile kill; stopsound", checked: false },
        { row-kind: 2, command-index: 20, title: "bot_place", subtitle: "Posiciona um bot imediatamente no local onde sua mira aponta.", command-value: "bot_place", checked: false },
    ];

    // Callbacks para integração com o backend Rust
    pure callback resolve-cs2-key(string) -> string;
    callback existing-file-selected(string);
    callback file-name-edited(string);
    callback key-captured(string);
    callback category-tab-selected(int);
    callback view-mode-changed(bool);
    callback search-query-changed(string);
    callback command-toggled(int, bool);
    callback clear-selected-commands();
    callback save-bind-clicked();
    callback confirm-conflict-overwrite();
    callback cancel-conflict-overwrite();
}

component BindGridSwitchSlot inherits Rectangle {
    in property <BindGridCell> cell;
    in property <length> slot-width;
    callback toggled(int, bool);
    callback hover-changed(bool, int, string, string, bool, length, length, length, length);

    width: root.slot-width;
    height: 50px;

    if root.cell.present : TweakSwitch {
        width: parent.width;
        button-width: parent.width;
        label: root.cell.title;
        info: root.cell.info;
        checked: root.cell.checked;
        accent-color: CS2Theme.accent-ct-blue;
        hover-color: #0284c7;
        show-inline-tooltip: false;
        auto-toggle: false;
        toggled(new-val) => {
            root.toggled(root.cell.command-index, new-val);
        }
        hover-changed(hovered, ax, ay, aw, ah) => {
            root.hover-changed(
                hovered,
                root.cell.command-index,
                root.cell.title,
                root.cell.description,
                root.cell.checked,
                ax,
                ay,
                aw,
                ah
            );
        }
    }
}

export component BindsView inherits Rectangle {
    background: CS2Theme.bg-main;
    clip: true;

    callback back-clicked();
    callback view-mode-changed(bool);

    // Função dedicada de ativação da escuta da próxima tecla
    public function activate-key-listener() {
        BindsState.selector-dropdown-open = false;
        BindsState.show-conflict-prompt = false;
        root.hide-grid-tooltip();
        BindsState.is-listening-key = true;
        key-listener-scope.focus();
    }

    function hide-grid-tooltip() {
        BindsState.tooltip-visible = false;
    }

    function handle-grid-hover(
        hovered: bool,
        cmd-idx: int,
        title: string,
        desc: string,
        checked: bool,
        ax: length,
        ay: length,
        aw: length,
        ah: length
    ) {
        if hovered && !BindsState.selector-dropdown-open {
            BindsState.tooltip-command-index = cmd-idx;
            BindsState.tooltip-title = title;
            BindsState.tooltip-description = desc;
            BindsState.tooltip-checked = checked;
            BindsState.tooltip-anchor-x = ax;
            BindsState.tooltip-anchor-y = ay;
            BindsState.tooltip-anchor-w = aw;
            BindsState.tooltip-anchor-h = ah;
            BindsState.tooltip-visible = true;
        } else if !hovered && BindsState.tooltip-command-index == cmd-idx {
            BindsState.tooltip-visible = false;
        }
    }

    function sync-grid-toggle-state(cmd-idx: int, new-val: bool) {
        BindsState.selector-dropdown-open = false;
        if BindsState.tooltip-command-index == cmd-idx {
            BindsState.tooltip-checked = new-val;
        }
        if !BindsState.backend-connected {
            if new-val {
                BindsState.selected-commands-count += 1;
            } else {
                BindsState.selected-commands-count = max(0, BindsState.selected-commands-count - 1);
            }
        }
        BindsState.command-toggled(cmd-idx, new-val);
    }

    pure function fallback-resolve-key(text: string) -> string {
        if text == Key.Space || text == " " {
            return "space";
        }
        if text == Key.Return {
            return "enter";
        }
        if text == Key.Escape {
            return "escape";
        }
        if text == Key.Tab {
            return "tab";
        }
        if text == Key.Backspace {
            return "backspace";
        }
        if text == Key.Delete {
            return "del";
        }
        if text == Key.Insert {
            return "ins";
        }
        if text == Key.Home {
            return "home";
        }
        if text == Key.End {
            return "end";
        }
        if text == Key.PageUp {
            return "pgup";
        }
        if text == Key.PageDown {
            return "pgdn";
        }
        if text == Key.UpArrow {
            return "uparrow";
        }
        if text == Key.DownArrow {
            return "downarrow";
        }
        if text == Key.LeftArrow {
            return "leftarrow";
        }
        if text == Key.RightArrow {
            return "rightarrow";
        }
        if text == Key.Shift {
            return "shift";
        }
        if text == Key.ShiftR {
            return "rshift";
        }
        if text == Key.Control {
            return "ctrl";
        }
        if text == Key.ControlR {
            return "rctrl";
        }
        if text == Key.Alt {
            return "alt";
        }
        if text == Key.AltGr {
            return "ralt";
        }
        if text == Key.CapsLock {
            return "capslock";
        }
        if text == Key.F1 { return "f1"; }
        if text == Key.F2 { return "f2"; }
        if text == Key.F3 { return "f3"; }
        if text == Key.F4 { return "f4"; }
        if text == Key.F5 { return "f5"; }
        if text == Key.F6 { return "f6"; }
        if text == Key.F7 { return "f7"; }
        if text == Key.F8 { return "f8"; }
        if text == Key.F9 { return "f9"; }
        if text == Key.F10 { return "f10"; }
        if text == Key.F11 { return "f11"; }
        if text == Key.F12 { return "f12"; }
        if text == ";" {
            return "semicolon";
        }
        if text == "" || text == "\"" {
            return "";
        }
        return text;
    }

    function apply-captured-key(key-name: string) {
        BindsState.bound-key = key-name;
        BindsState.is-listening-key = false;
        BindsState.key-captured(BindsState.bound-key);
    }

    function sync-local-save-mode() {
        if BindsState.selected-existing-file == "" {
            BindsState.is-creating-new-file = true;
            BindsState.save-mode-badge = @tr("NOVO ARQUIVO");
        } else if BindsState.file-name-input == "" {
            BindsState.is-creating-new-file = true;
            BindsState.save-mode-badge = @tr("DIGITE O NOME");
        } else if BindsState.file-name-input == BindsState.selected-existing-file {
            BindsState.is-creating-new-file = false;
            BindsState.save-mode-badge = @tr("ATUALIZAR ATUAL");
        } else {
            BindsState.is-creating-new-file = true;
            BindsState.save-mode-badge = @tr("CRIAR NOVO");
        }
    }

    // Função dedicada que escuta e associa automaticamente a próxima tecla pressionada
    function capture-next-key(event: KeyEvent) -> EventResult {
        if !BindsState.is-listening-key {
            return reject;
        }

        let mapped-from-backend = BindsState.resolve-cs2-key(event.text);
        let mapped-key = mapped-from-backend != "" ? mapped-from-backend : root.fallback-resolve-key(event.text);
        if mapped-key == "" {
            return accept;
        }

        root.apply-captured-key(mapped-key);
        return accept;
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;

        // =====================================================================
        // 1. BARRA SUPERIOR FIXA (HEADER)
        // =====================================================================
        Rectangle {
            background: CS2Theme.bg-surface;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 8px;

                // Linha superior: botão voltar para o Painel + título do módulo
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;

                    Rectangle {
                        height: 26px;
                        border-radius: CS2Theme.radius-sm;
                        background: back-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card;
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 9px;
                            padding-right: 10px;
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Path {
                                    width: 10px;
                                    height: 10px;
                                    viewbox-width: 12;
                                    viewbox-height: 12;
                                    stroke: back-touch.has-hover ? CS2Theme.accent-ct-cyan : CS2Theme.text-primary;
                                    stroke-width: 1.9px;
                                    commands: "M 7.5 1.5 L 3 6 L 7.5 10.5 M 3.5 6 L 11 6";
                                }
                            }

                            Text {
                                text: @tr("Voltar");
                                font-size: 11px;
                                font-weight: 700;
                                color: back-touch.has-hover ? #ffffff : CS2Theme.text-primary;
                                vertical-alignment: center;
                            }
                        }

                        back-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                BindsState.is-listening-key = false;
                                BindsState.selector-dropdown-open = false;
                                root.hide-grid-tooltip();
                                root.back-clicked();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 1px;
                            height: 16px;
                            background: CS2Theme.border;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("../assets/icons/cfg.svg");
                                width: 16px;
                                height: 16px;
                                colorize: CS2Theme.accent-ct-cyan;
                            }
                        }

                        Text {
                            text: @tr("GERADOR DE BINDS CS2");
                            font-size: 13px;
                            font-weight: 900;
                            letter-spacing: 0.7px;
                            color: CS2Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }

                // Controles do Header lado a lado (fluxo 1 → 2 → Salvar, inputs sem borda em repouso)
                HorizontalLayout {
                    spacing: 10px;

                    // 1. Campo Composto de Arquivo (.cfg): nome editável + seletor acoplado de existentes
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 2;
                        min-width: 280px;

                        HorizontalLayout {
                            height: 16px;
                            alignment: space-between;

                            Text {
                                text: @tr("1. ARQUIVO .CFG");
                                font-size: 10px;
                                font-weight: 800;
                                letter-spacing: 0.6px;
                                color: file-name-field.has-focus || BindsState.selector-dropdown-open
                                    ? CS2Theme.text-cyan
                                    : CS2Theme.text-muted;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                height: 16px;
                                border-radius: CS2Theme.radius-xs;
                                background: BindsState.is-creating-new-file ? CS2Theme.accent-t-soft : CS2Theme.accent-ct-soft;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: BindsState.save-mode-badge;
                                        font-size: 8px;
                                        font-weight: 900;
                                        letter-spacing: 0.5px;
                                        color: BindsState.is-creating-new-file ? CS2Theme.text-gold : CS2Theme.text-cyan;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        file-control-box := Rectangle {
                            property <bool> is-highlighted: file-name-field.has-focus || BindsState.selector-dropdown-open;

                            height: 36px;
                            background: is-highlighted
                                ? CS2Theme.bg-main
                                : (file-area-touch.has-hover || selector-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card);
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1.5px;
                            border-color: is-highlighted ? CS2Theme.accent-ct-cyan : transparent;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 4px;
                                spacing: 6px;

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Image {
                                        source: @image-url("../assets/icons/cfg.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: is-highlighted ? CS2Theme.accent-ct-cyan : CS2Theme.text-dim;
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    clip: true;

                                    file-area-touch := TouchArea {
                                        mouse-cursor: text;
                                        clicked => {
                                            BindsState.is-listening-key = false;
                                            BindsState.selector-dropdown-open = false;
                                            root.hide-grid-tooltip();
                                            file-name-field.focus();
                                        }
                                    }

                                    file-name-field := TextInput {
                                        width: parent.width;
                                        height: parent.height;
                                        text <=> BindsState.file-name-input;
                                        color: CS2Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                        edited => {
                                            BindsState.is-listening-key = false;
                                            BindsState.selector-dropdown-open = false;
                                            BindsState.show-conflict-prompt = false;
                                            root.hide-grid-tooltip();
                                            root.sync-local-save-mode();
                                            BindsState.file-name-edited(self.text);
                                        }
                                    }

                                    if BindsState.file-name-input == "" : Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: @tr("Ex: minhas_binds.cfg");
                                        color: CS2Theme.text-muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        opacity: 0.78;
                                    }
                                }

                                if BindsState.file-name-input != "" : Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: CS2Theme.radius-xs;
                                    background: clear-file-touch.has-hover ? CS2Theme.bg-card-selected : transparent;

                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-width: 10;
                                        viewbox-height: 10;
                                        stroke: clear-file-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted;
                                        stroke-width: 1.8px;
                                        commands: "M 1.5 1.5 L 8.5 8.5 M 8.5 1.5 L 1.5 8.5";
                                    }

                                    clear-file-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            BindsState.is-listening-key = false;
                                            BindsState.selector-dropdown-open = false;
                                            BindsState.show-conflict-prompt = false;
                                            root.hide-grid-tooltip();
                                            BindsState.file-name-input = "";
                                            BindsState.selected-existing-file = "";
                                            root.sync-local-save-mode();
                                            BindsState.existing-file-selected("");
                                            BindsState.file-name-edited("");
                                        }
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    Rectangle {
                                        width: 1px;
                                        height: 18px;
                                        background: CS2Theme.border;
                                        opacity: 0.7;
                                    }
                                }

                                selector-anchor := Rectangle {
                                    horizontal-stretch: 0;
                                    height: 28px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: CS2Theme.radius-xs;
                                    background: BindsState.selector-dropdown-open
                                        ? CS2Theme.accent-ct-soft
                                        : (selector-touch.has-hover ? CS2Theme.bg-card-selected : CS2Theme.bg-surface);
                                    animate background { duration: 100ms; }

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;

                                        Text {
                                            text: BindsState.existing-cfg-files.length > 0
                                                ? @tr("Existentes ({})", BindsState.existing-cfg-files.length)
                                                : @tr("Existentes");
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            color: BindsState.selector-dropdown-open || BindsState.selected-existing-file != ""
                                                ? CS2Theme.text-cyan
                                                : CS2Theme.text-muted;
                                            vertical-alignment: center;
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            Path {
                                                width: 9px;
                                                height: 5px;
                                                viewbox-width: 10;
                                                viewbox-height: 6;
                                                stroke: BindsState.selector-dropdown-open ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                                stroke-width: 1.8px;
                                                commands: BindsState.selector-dropdown-open ? "M 1 5 L 5 1 L 9 5" : "M 1 1 L 5 5 L 9 1";
                                            }
                                        }
                                    }

                                    selector-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            BindsState.is-listening-key = false;
                                            root.hide-grid-tooltip();
                                            BindsState.selector-dropdown-open = !BindsState.selector-dropdown-open;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 2. Captura de Tecla de Atalho (sem borda em repouso; borda apenas quando em escuta)
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        min-width: 190px;
                        max-width: 225px;

                        HorizontalLayout {
                            height: 16px;

                            Text {
                                text: @tr("2. TECLA DE ATALHO");
                                font-size: 10px;
                                font-weight: 800;
                                letter-spacing: 0.6px;
                                color: BindsState.is-listening-key ? CS2Theme.text-cyan : CS2Theme.text-muted;
                                vertical-alignment: center;
                            }
                        }

                        key-listener-box := Rectangle {
                            height: 36px;
                            background: BindsState.is-listening-key
                                ? CS2Theme.accent-ct-soft
                                : (key-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card);
                            border-radius: CS2Theme.radius-sm;
                            border-width: 1.5px;
                            border-color: BindsState.is-listening-key ? CS2Theme.accent-ct-cyan : transparent;
                            animate background { duration: 120ms; }
                            animate border-color { duration: 120ms; }

                            key-listener-scope := FocusScope {
                                changed has-focus => {
                                    if !self.has-focus && BindsState.is-listening-key {
                                        BindsState.is-listening-key = false;
                                    }
                                }
                                key-pressed(event) => {
                                    return root.capture-next-key(event);
                                }
                            }

                            key-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.activate-key-listener();
                                }
                                pointer-event(ev) => {
                                    if BindsState.is-listening-key && ev.kind == PointerEventKind.down {
                                        if ev.button == PointerEventButton.right {
                                            root.apply-captured-key("mouse2");
                                        } else if ev.button == PointerEventButton.middle {
                                            root.apply-captured-key("mouse3");
                                        } else if ev.button == PointerEventButton.back {
                                            root.apply-captured-key("mouse4");
                                        } else if ev.button == PointerEventButton.forward {
                                            root.apply-captured-key("mouse5");
                                        }
                                    }
                                }
                                scroll-event(ev) => {
                                    if BindsState.is-listening-key {
                                        if ev.delta-y > 0px {
                                            root.apply-captured-key("mwheelup");
                                            return accept;
                                        } else if ev.delta-y < 0px {
                                            root.apply-captured-key("mwheeldown");
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: 8px;
                                    horizontal-stretch: 1;

                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 7px;
                                            height: 7px;
                                            border-radius: 3.5px;
                                            background: BindsState.is-listening-key
                                                ? CS2Theme.accent-ct-cyan
                                                : (BindsState.bound-key != "" ? CS2Theme.status-success : CS2Theme.text-dim);
                                        }
                                    }

                                    if BindsState.is-listening-key : Text {
                                        text: @tr("Aguardando tecla/scroll...");
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: CS2Theme.text-cyan;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }

                                    if !BindsState.is-listening-key && BindsState.bound-key != "" : HorizontalLayout {
                                        spacing: 8px;
                                        horizontal-stretch: 1;

                                        Rectangle {
                                            height: 24px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: CS2Theme.radius-xs;
                                            background: key-touch.has-hover ? CS2Theme.accent-ct-soft : CS2Theme.bg-card-selected;

                                            HorizontalLayout {
                                                padding-left: 9px;
                                                padding-right: 9px;
                                                Text {
                                                    text: BindsState.bound-key;
                                                    font-size: 12px;
                                                    font-weight: 900;
                                                    color: CS2Theme.text-primary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: @tr("Alterar");
                                            font-size: 10px;
                                            font-weight: 600;
                                            color: key-touch.has-hover ? CS2Theme.text-cyan : CS2Theme.text-dim;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }

                                    if !BindsState.is-listening-key && BindsState.bound-key == "" : Text {
                                        text: @tr("Clique e pressione...");
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: CS2Theme.text-muted;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                    }
                                }

                                if BindsState.bound-key != "" && !BindsState.is-listening-key : Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: CS2Theme.radius-xs;
                                    background: clear-key-touch.has-hover ? CS2Theme.bg-card-selected : transparent;

                                    Path {
                                        width: 8px;
                                        height: 8px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        viewbox-width: 10;
                                        viewbox-height: 10;
                                        stroke: clear-key-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted;
                                        stroke-width: 1.8px;
                                        commands: "M 1.5 1.5 L 8.5 8.5 M 8.5 1.5 L 1.5 8.5";
                                    }

                                    clear-key-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            BindsState.bound-key = "";
                                            BindsState.key-captured("");
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 3. CTA Primário Salvar Bind (alinhado pela base dos inputs, sem rótulo redundante)
                    VerticalLayout {
                        alignment: end;
                        horizontal-stretch: 0;
                        min-width: 148px;

                        Rectangle {
                            height: 36px;
                            background: save-touch.has-hover ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange;
                            border-radius: CS2Theme.radius-sm;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 7px;
                                alignment: center;

                                Image {
                                    source: @image-url("../assets/icons/save.svg");
                                    width: 14px;
                                    height: 14px;
                                    colorize: #ffffff;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: @tr("SALVAR BIND");
                                    font-size: 11px;
                                    font-weight: 900;
                                    letter-spacing: 0.6px;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }

                                if BindsState.selected-commands-count > 0 : Rectangle {
                                    height: 18px;
                                    min-width: 18px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: CS2Theme.radius-xs;
                                    background: rgba(0, 0, 0, 0.28);

                                    HorizontalLayout {
                                        padding-left: 5px;
                                        padding-right: 5px;
                                        Text {
                                            text: BindsState.selected-commands-count;
                                            font-size: 10px;
                                            font-weight: 900;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }

                            save-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    BindsState.selector-dropdown-open = false;
                                    BindsState.is-listening-key = false;
                                    BindsState.save-bind-clicked();
                                }
                            }
                        }
                    }
                }

                // Linha secundária: Faixa tática de Prévia da bind / Status + Limpar marcados
                Rectangle {
                    height: 28px;
                    border-radius: CS2Theme.radius-sm;
                    background: CS2Theme.bg-main;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 6px;
                        spacing: 10px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;

                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    border-radius: 3px;
                                    background: BindsState.status-kind == "success"
                                        ? CS2Theme.status-success
                                        : (BindsState.status-kind == "warning"
                                            ? CS2Theme.accent-t-gold
                                            : (BindsState.status-kind == "error" ? CS2Theme.status-danger : CS2Theme.accent-ct-cyan));
                                }
                            }

                            if BindsState.bind-preview-line != "" && BindsState.status-kind == "info" : Rectangle {
                                height: 17px;
                                y: (parent.height - self.height) / 2;
                                border-radius: CS2Theme.radius-xs;
                                background: CS2Theme.accent-ct-soft;

                                HorizontalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    Text {
                                        text: @tr("PRÉVIA");
                                        font-size: 8px;
                                        font-weight: 900;
                                        letter-spacing: 0.5px;
                                        color: CS2Theme.text-cyan;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if BindsState.bind-preview-line != "" && BindsState.status-kind == "info" : Text {
                                text: BindsState.bind-preview-line;
                                font-size: 11px;
                                font-weight: 700;
                                color: CS2Theme.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            if !(BindsState.bind-preview-line != "" && BindsState.status-kind == "info") : Text {
                                text: BindsState.status-message;
                                font-size: 11px;
                                font-weight: 600;
                                color: BindsState.status-kind == "success"
                                    ? CS2Theme.text-green
                                    : (BindsState.status-kind == "warning"
                                        ? CS2Theme.text-gold
                                        : (BindsState.status-kind == "error" ? CS2Theme.status-danger : CS2Theme.text-muted));
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }

                        if BindsState.selected-commands-count > 0 : Rectangle {
                            height: 20px;
                            y: (parent.height - self.height) / 2;
                            border-radius: CS2Theme.radius-xs;
                            background: clear-cmds-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: @tr("Limpar marcados ({})", BindsState.selected-commands-count);
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: clear-cmds-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted;
                                    vertical-alignment: center;
                                }
                            }

                            clear-cmds-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    BindsState.selected-commands-count = 0;
                                    BindsState.clear-selected-commands();
                                }
                            }
                        }
                    }
                }

                // Confirmação inline quando a tecla já existe no arquivo selecionado
                if BindsState.show-conflict-prompt : Rectangle {
                    background: CS2Theme.accent-t-soft;
                    border-radius: CS2Theme.radius-sm;
                    border-width: 1px;
                    border-color: CS2Theme.accent-t-gold;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 12px;
                        alignment: space-between;

                        Text {
                            text: BindsState.conflict-message;
                            font-size: 11px;
                            font-weight: 700;
                            color: CS2Theme.text-primary;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            Rectangle {
                                height: 28px;
                                background: conflict-cancel-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-main;
                                border-radius: CS2Theme.radius-xs;
                                border-width: 1px;
                                border-color: CS2Theme.border-hover;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: @tr("CANCELAR");
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: CS2Theme.text-primary;
                                        vertical-alignment: center;
                                    }
                                }

                                conflict-cancel-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        BindsState.show-conflict-prompt = false;
                                        BindsState.cancel-conflict-overwrite();
                                    }
                                }
                            }

                            Rectangle {
                                height: 28px;
                                background: conflict-ok-touch.has-hover ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange;
                                border-radius: CS2Theme.radius-xs;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: @tr("SUBSTITUIR TECLA");
                                        font-size: 10px;
                                        font-weight: 900;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                conflict-ok-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        BindsState.show-conflict-prompt = false;
                                        BindsState.confirm-conflict-overwrite();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Separador estrutural do Header Fixo
        Rectangle {
            height: 1px;
            background: CS2Theme.border;
        }

        // =====================================================================
        // 2. PESQUISA, VISUALIZAÇÃO (LISTA/GRADE) E ABAS DE CATEGORIAS
        // =====================================================================
        Rectangle {
            background: CS2Theme.bg-surface;

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 0px;
                spacing: 8px;

                // Barra de ferramentas: Pesquisa (borda apenas quando destacada) + Alternador Lista/Grade
                HorizontalLayout {
                    spacing: 10px;

                    Rectangle {
                        property <bool> is-highlighted: search-field.has-focus || BindsState.search-query != "";

                        horizontal-stretch: 1;
                        height: 34px;
                        background: is-highlighted
                            ? CS2Theme.bg-main
                            : (search-area-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card);
                        border-radius: CS2Theme.radius-sm;
                        border-width: 1.5px;
                        border-color: is-highlighted ? CS2Theme.accent-ct-cyan : transparent;
                        animate background { duration: 120ms; }
                        animate border-color { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;

                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;

                                Path {
                                    width: 14px;
                                    height: 14px;
                                    viewbox-width: 16;
                                    viewbox-height: 16;
                                    stroke: is-highlighted ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                    stroke-width: 1.7px;
                                    commands: "M 6.5 2 C 8.984 2 11 4.016 11 6.5 C 11 8.984 8.984 11 6.5 11 C 4.016 11 2 8.984 2 6.5 C 2 4.016 4.016 2 6.5 2 M 9.8 9.8 L 14 14";
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;

                                search-area-touch := TouchArea {
                                    mouse-cursor: text;
                                    clicked => {
                                        BindsState.is-listening-key = false;
                                        BindsState.selector-dropdown-open = false;
                                        root.hide-grid-tooltip();
                                        search-field.focus();
                                    }
                                }

                                search-field := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    text <=> BindsState.search-query;
                                    color: CS2Theme.text-primary;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    edited => {
                                        BindsState.is-listening-key = false;
                                        BindsState.selector-dropdown-open = false;
                                        root.hide-grid-tooltip();
                                        catalog-scroll.content-y = 0px;
                                        BindsState.search-query-changed(self.text);
                                    }
                                }

                                if BindsState.search-query == "" : Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: @tr("Pesquisar por comando ou descrição (ex: smoke, radar, +jump)...");
                                    color: CS2Theme.text-muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            if BindsState.search-query != "" : Rectangle {
                                height: 20px;
                                y: (parent.height - self.height) / 2;
                                border-radius: CS2Theme.radius-xs;
                                background: CS2Theme.accent-ct-soft;

                                HorizontalLayout {
                                    padding-left: 7px;
                                    padding-right: 7px;
                                    Text {
                                        text: BindsState.filtered-commands-count == 1
                                            ? @tr("{} resultado", BindsState.filtered-commands-count)
                                            : @tr("{} resultados", BindsState.filtered-commands-count);
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: CS2Theme.text-cyan;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if BindsState.search-query != "" : Rectangle {
                                width: 22px;
                                height: 22px;
                                y: (parent.height - self.height) / 2;
                                border-radius: CS2Theme.radius-xs;
                                background: search-clear-touch.has-hover ? CS2Theme.bg-card-selected : transparent;

                                Path {
                                    width: 8px;
                                    height: 8px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    stroke: search-clear-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted;
                                    stroke-width: 1.8px;
                                    commands: "M 1.5 1.5 L 8.5 8.5 M 8.5 1.5 L 1.5 8.5";
                                }

                                search-clear-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        BindsState.is-listening-key = false;
                                        BindsState.selector-dropdown-open = false;
                                        root.hide-grid-tooltip();
                                        BindsState.search-query = "";
                                        catalog-scroll.content-y = 0px;
                                        BindsState.search-query-changed("");
                                    }
                                }
                            }
                        }
                    }

                    // Alternador Lista / Grade (sem bordas fixas)
                    Rectangle {
                        horizontal-stretch: 0;
                        height: 34px;
                        background: CS2Theme.bg-main;
                        border-radius: CS2Theme.radius-sm;

                        HorizontalLayout {
                            padding: 3px;
                            spacing: 3px;

                            Rectangle {
                                height: 28px;
                                border-radius: CS2Theme.radius-xs;
                                background: !BindsState.is-grid-view
                                    ? CS2Theme.accent-ct-soft
                                    : (list-mode-touch.has-hover ? CS2Theme.bg-card : transparent);
                                animate background { duration: 100ms; }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Path {
                                            width: 12px;
                                            height: 10px;
                                            viewbox-width: 14;
                                            viewbox-height: 12;
                                            stroke: !BindsState.is-grid-view ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                            stroke-width: 1.7px;
                                            commands: "M 1 2 L 13 2 M 1 6 L 13 6 M 1 10 L 13 10";
                                        }
                                    }

                                    Text {
                                        text: @tr("Lista");
                                        font-size: 11px;
                                        font-weight: !BindsState.is-grid-view ? 800 : 600;
                                        color: !BindsState.is-grid-view ? #ffffff : CS2Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                list-mode-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        BindsState.is-listening-key = false;
                                        BindsState.selector-dropdown-open = false;
                                        root.hide-grid-tooltip();
                                        if BindsState.is-grid-view {
                                            BindsState.is-grid-view = false;
                                            catalog-scroll.content-y = 0px;
                                            root.view-mode-changed(false);
                                            BindsState.view-mode-changed(false);
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: 28px;
                                border-radius: CS2Theme.radius-xs;
                                background: BindsState.is-grid-view
                                    ? CS2Theme.accent-ct-soft
                                    : (grid-mode-touch.has-hover ? CS2Theme.bg-card : transparent);
                                animate background { duration: 100ms; }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    VerticalLayout {
                                        alignment: center;
                                        Path {
                                            width: 11px;
                                            height: 11px;
                                            viewbox-width: 12;
                                            viewbox-height: 12;
                                            stroke: BindsState.is-grid-view ? CS2Theme.accent-ct-cyan : CS2Theme.text-muted;
                                            stroke-width: 1.4px;
                                            fill: BindsState.is-grid-view ? CS2Theme.accent-ct-cyan : transparent;
                                            commands: "M 1 1 L 4.5 1 L 4.5 4.5 L 1 4.5 Z M 7.5 1 L 11 1 L 11 4.5 L 7.5 4.5 Z M 1 7.5 L 4.5 7.5 L 4.5 11 L 1 11 Z M 7.5 7.5 L 11 7.5 L 11 11 L 7.5 11 Z";
                                        }
                                    }

                                    Text {
                                        text: @tr("Grade");
                                        font-size: 11px;
                                        font-weight: BindsState.is-grid-view ? 800 : 600;
                                        color: BindsState.is-grid-view ? #ffffff : CS2Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }

                                grid-mode-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        BindsState.is-listening-key = false;
                                        BindsState.selector-dropdown-open = false;
                                        root.hide-grid-tooltip();
                                        if !BindsState.is-grid-view {
                                            BindsState.is-grid-view = true;
                                            catalog-scroll.content-y = 0px;
                                            root.view-mode-changed(true);
                                            BindsState.view-mode-changed(true);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Abas de Categorias (1 aba por categoria)
                HorizontalLayout {
                    spacing: 3px;

                    for tab in BindsState.category-tabs : Rectangle {
                        property <bool> is-searching: BindsState.search-query != "";
                        property <bool> is-active: !is-searching && tab.index == BindsState.active-category-index;

                        horizontal-stretch: 1;
                        height: 32px;
                        border-top-left-radius: CS2Theme.radius-sm;
                        border-top-right-radius: CS2Theme.radius-sm;
                        background: is-active
                            ? CS2Theme.bg-card
                            : (tab-touch.has-hover ? CS2Theme.bg-card-hover : transparent);
                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: tab.tab-label;
                                font-size: 10.5px;
                                font-weight: is-active ? 800 : 600;
                                color: is-active
                                    ? #ffffff
                                    : (is-searching && tab.match-count == 0
                                        ? CS2Theme.text-dim
                                        : (tab-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted));
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            if !is-searching && tab.selected-count > 0 : Rectangle {
                                height: 15px;
                                min-width: 15px;
                                y: (parent.height - self.height) / 2;
                                border-radius: CS2Theme.radius-xs;
                                background: CS2Theme.accent-ct-soft;
                                border-width: 1px;
                                border-color: CS2Theme.accent-ct-blue;

                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    Text {
                                        text: tab.selected-count;
                                        font-size: 8.5px;
                                        font-weight: 900;
                                        color: CS2Theme.text-cyan;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            if is-searching && tab.match-count > 0 : Rectangle {
                                height: 15px;
                                min-width: 15px;
                                y: (parent.height - self.height) / 2;
                                border-radius: CS2Theme.radius-xs;
                                background: CS2Theme.bg-main;
                                border-width: 1px;
                                border-color: CS2Theme.border-hover;

                                HorizontalLayout {
                                    padding-left: 3px;
                                    padding-right: 3px;
                                    Text {
                                        text: tab.match-count;
                                        font-size: 8.5px;
                                        font-weight: 800;
                                        color: CS2Theme.text-primary;
                                        vertical-alignment: center;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        if is-active : Rectangle {
                            x: 0px;
                            y: parent.height - 2px;
                            width: parent.width;
                            height: 2px;
                            background: CS2Theme.accent-ct-cyan;
                        }

                        tab-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                BindsState.is-listening-key = false;
                                BindsState.selector-dropdown-open = false;
                                root.hide-grid-tooltip();
                                BindsState.search-query = "";
                                BindsState.active-category-index = tab.index;
                                catalog-scroll.content-y = 0px;
                                BindsState.category-tab-selected(tab.index);
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: CS2Theme.border;
        }

        // =====================================================================
        // 3. LISTAGEM / GRADE ROLÁVEL DE COMANDOS
        // =====================================================================
        catalog-scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            changed content-y => {
                root.hide-grid-tooltip();
            }

            VerticalLayout {
                width: catalog-scroll.visible-width;
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 18px;
                spacing: BindsState.is-grid-view ? 10px : 8px;
                alignment: start;

                if BindsState.search-query != "" && BindsState.catalog-rows.length > 0 : Rectangle {
                    background: CS2Theme.bg-surface;
                    border-radius: CS2Theme.radius-sm;
                    border-width: 1px;
                    border-color: CS2Theme.border;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 7px;
                        padding-bottom: 7px;
                        spacing: 10px;
                        alignment: space-between;

                        Text {
                            text: BindsState.filtered-commands-count == 1
                                ? @tr("Exibindo {} comando encontrado para \"{}\" em todas as categorias", BindsState.filtered-commands-count, BindsState.search-query)
                                : @tr("Exibindo {} comandos encontrados para \"{}\" em todas as categorias", BindsState.filtered-commands-count, BindsState.search-query);
                            font-size: 11px;
                            font-weight: 600;
                            color: CS2Theme.text-muted;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        Rectangle {
                            height: 22px;
                            border-radius: CS2Theme.radius-xs;
                            background: banner-clear-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-main;
                            border-width: 1px;
                            border-color: banner-clear-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: @tr("Limpar pesquisa");
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: CS2Theme.text-cyan;
                                    vertical-alignment: center;
                                }
                            }

                            banner-clear-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.hide-grid-tooltip();
                                    BindsState.search-query = "";
                                    catalog-scroll.content-y = 0px;
                                    BindsState.search-query-changed("");
                                }
                            }
                        }
                    }
                }

                if BindsState.search-query != "" && BindsState.catalog-rows.length == 0 : Rectangle {
                    vertical-stretch: 0;
                    background: CS2Theme.bg-surface;
                    border-radius: CS2Theme.radius-sm;
                    border-width: 1px;
                    border-color: CS2Theme.border;

                    VerticalLayout {
                        padding: 28px;
                        spacing: 10px;
                        alignment: center;

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: CS2Theme.radius-sm;
                                background: CS2Theme.bg-card;
                                border-width: 1px;
                                border-color: CS2Theme.border;

                                Path {
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 16;
                                    viewbox-height: 16;
                                    stroke: CS2Theme.accent-ct-cyan;
                                    stroke-width: 1.7px;
                                    commands: "M 6.5 2 C 8.984 2 11 4.016 11 6.5 C 11 8.984 8.984 11 6.5 11 C 4.016 11 2 8.984 2 6.5 C 2 4.016 4.016 2 6.5 2 M 9.8 9.8 L 14 14";
                                }
                            }
                        }

                        Text {
                            text: @tr("Nenhum comando encontrado para \"{}\"", BindsState.search-query);
                            font-size: 13px;
                            font-weight: 800;
                            color: CS2Theme.text-primary;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: @tr("Tente buscar pelo nome do comando (ex: noclip, slot8, buy) ou por palavras da descrição (ex: fumaça, radar, recuo).");
                            font-size: 11px;
                            color: CS2Theme.text-muted;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                height: 30px;
                                border-radius: CS2Theme.radius-xs;
                                background: empty-clear-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.accent-ct-soft;
                                border-width: 1px;
                                border-color: CS2Theme.accent-ct-cyan;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    Text {
                                        text: @tr("Limpar pesquisa");
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                empty-clear-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.hide-grid-tooltip();
                                        BindsState.search-query = "";
                                        catalog-scroll.content-y = 0px;
                                        BindsState.search-query-changed("");
                                    }
                                }
                            }
                        }
                    }
                }

                for row[idx] in BindsState.catalog-rows : VerticalLayout {
                    // 3.1 Cabeçalho de Categoria (subtítulo abaixo do título, sem caixa)
                    if row.row-kind == 0 : VerticalLayout {
                        padding-top: idx == 0 ? 4px : 16px;
                        padding-bottom: 4px;
                        spacing: 6px;

                        VerticalLayout {
                            spacing: 3px;

                            Text {
                                text: row.title;
                                font-size: 15px;
                                font-weight: 800;
                                letter-spacing: 0.3px;
                                color: CS2Theme.text-primary;
                            }

                            if row.subtitle != "" : Text {
                                text: row.subtitle;
                                font-size: 11.5px;
                                font-weight: 400;
                                color: CS2Theme.text-muted;
                                wrap: word-wrap;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: CS2Theme.border;
                        }
                    }

                    // 3.2 Cabeçalho de Subcategoria
                    if row.row-kind == 1 : VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 2px;

                        Text {
                            text: row.title;
                            font-size: 11px;
                            font-weight: 800;
                            letter-spacing: 0.4px;
                            color: CS2Theme.text-cyan;
                        }
                    }

                    // 3.3 Item de Comando (Modo Lista)
                    if row.row-kind == 2 : BindCommandCard {
                        command-title: row.title;
                        description: row.subtitle;
                        checked: row.checked;
                        toggled(new-val) => {
                            BindsState.selector-dropdown-open = false;
                            row.checked = new-val;
                            if !BindsState.backend-connected {
                                if new-val {
                                    BindsState.selected-commands-count += 1;
                                } else {
                                    BindsState.selected-commands-count = max(0, BindsState.selected-commands-count - 1);
                                }
                            }
                            BindsState.command-toggled(row.command-index, new-val);
                        }
                    }

                    // 3.4 Grade estilo Otimizações (4 colunas com popup de descrição no hover)
                    if row.row-kind == 3 : HorizontalLayout {
                        property <length> col-width: max(165px, (catalog-scroll.visible-width - 72px) / 4);
                        spacing: 10px;

                        BindGridSwitchSlot {
                            cell: row.cell-0;
                            slot-width: parent.col-width;
                            toggled(cmd-idx, new-val) => {
                                row.cell-0.checked = new-val;
                                root.sync-grid-toggle-state(cmd-idx, new-val);
                            }
                            hover-changed(hovered, cmd-idx, title, desc, checked, ax, ay, aw, ah) => {
                                root.handle-grid-hover(hovered, cmd-idx, title, desc, checked, ax, ay, aw, ah);
                            }
                        }

                        BindGridSwitchSlot {
                            cell: row.cell-1;
                            slot-width: parent.col-width;
                            toggled(cmd-idx, new-val) => {
                                row.cell-1.checked = new-val;
                                root.sync-grid-toggle-state(cmd-idx, new-val);
                            }
                            hover-changed(hovered, cmd-idx, title, desc, checked, ax, ay, aw, ah) => {
                                root.handle-grid-hover(hovered, cmd-idx, title, desc, checked, ax, ay, aw, ah);
                            }
                        }

                        BindGridSwitchSlot {
                            cell: row.cell-2;
                            slot-width: parent.col-width;
                            toggled(cmd-idx, new-val) => {
                                row.cell-2.checked = new-val;
                                root.sync-grid-toggle-state(cmd-idx, new-val);
                            }
                            hover-changed(hovered, cmd-idx, title, desc, checked, ax, ay, aw, ah) => {
                                root.handle-grid-hover(hovered, cmd-idx, title, desc, checked, ax, ay, aw, ah);
                            }
                        }

                        BindGridSwitchSlot {
                            cell: row.cell-3;
                            slot-width: parent.col-width;
                            toggled(cmd-idx, new-val) => {
                                row.cell-3.checked = new-val;
                                root.sync-grid-toggle-state(cmd-idx, new-val);
                            }
                            hover-changed(hovered, cmd-idx, title, desc, checked, ax, ay, aw, ah) => {
                                root.handle-grid-hover(hovered, cmd-idx, title, desc, checked, ax, ay, aw, ah);
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // 4. POPUP DE DESCRIÇÃO NO HOVER DA GRADE (COORDENADAS LOCAIS)
    // =========================================================================
    if BindsState.tooltip-visible && BindsState.is-grid-view && !BindsState.selector-dropdown-open : Rectangle {
        property <length> local-anchor-x: BindsState.tooltip-anchor-x - root.absolute-position.x;
        property <length> local-anchor-y: BindsState.tooltip-anchor-y - root.absolute-position.y;
        property <length> scroll-top-y: catalog-scroll.absolute-position.y - root.absolute-position.y;
        property <length> above-y: local-anchor-y - self.height - 8px;
        property <length> below-y: local-anchor-y + BindsState.tooltip-anchor-h + 8px;

        width: min(340px, root.width - 24px);
        height: tooltip-content.preferred-height;
        x: clamp(local-anchor-x + (BindsState.tooltip-anchor-w - self.width) / 2, 12px, root.width - self.width - 12px);
        y: above-y >= scroll-top-y ? above-y : clamp(below-y, 12px, max(12px, root.height - self.height - 12px));
        background: #0f172a;
        border-width: 1px;
        border-color: BindsState.tooltip-checked ? CS2Theme.accent-ct-cyan : CS2Theme.accent-ct-blue;
        border-radius: CS2Theme.radius-xs;
        drop-shadow-color: rgba(0, 0, 0, 0.55);
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 6px;

        tooltip-content := VerticalLayout {
            width: parent.width;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;

            Text {
                text: BindsState.tooltip-title;
                font-size: 11px;
                font-weight: 800;
                color: CS2Theme.accent-ct-cyan;
                wrap: word-wrap;
            }

            Text {
                text: BindsState.tooltip-description;
                font-size: 11px;
                font-weight: 500;
                color: #f8fafc;
                wrap: word-wrap;
            }
        }
    }

    // =========================================================================
    // 5. OVERLAY DO SELETOR DE ARQUIVOS EXISTENTES (.CFG) (COORDENADAS LOCAIS)
    // =========================================================================
    if BindsState.selector-dropdown-open : TouchArea {
        clicked => {
            BindsState.selector-dropdown-open = false;
        }
    }

    if BindsState.selector-dropdown-open : Rectangle {
        x: clamp(selector-anchor.absolute-position.x - root.absolute-position.x + selector-anchor.width - self.width, 12px, root.width - self.width - 12px);
        y: selector-anchor.absolute-position.y - root.absolute-position.y + selector-anchor.height + 6px;
        width: 264px;
        height: min(260px, 46px + max(1, BindsState.existing-cfg-files.length) * 32px);
        background: CS2Theme.bg-surface-elevated;
        border-radius: CS2Theme.radius-sm;
        border-width: 1px;
        border-color: CS2Theme.accent-ct-cyan;
        drop-shadow-color: rgba(0, 0, 0, 0.55);
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 6px;
        clip: true;

        // Bloqueia propagação de cliques no fundo do menu
        TouchArea { }

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            // Opção para limpar seleção e criar um novo arquivo
            Rectangle {
                height: 30px;
                border-radius: CS2Theme.radius-xs;
                background: clear-sel-touch.has-hover ? CS2Theme.bg-card-hover : transparent;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    Text {
                        text: @tr("+ Novo arquivo (limpar seleção)");
                        font-size: 11px;
                        font-weight: 700;
                        color: CS2Theme.text-gold;
                        vertical-alignment: center;
                    }
                }

                clear-sel-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        BindsState.selected-existing-file = "";
                        BindsState.selector-dropdown-open = false;
                        root.sync-local-save-mode();
                        BindsState.existing-file-selected("");
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: CS2Theme.border;
            }

            if BindsState.existing-cfg-files.length == 0 : Rectangle {
                height: 32px;
                Text {
                    text: @tr("Nenhum arquivo .cfg encontrado");
                    font-size: 11px;
                    color: CS2Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if BindsState.existing-cfg-files.length > 0 : ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    spacing: 2px;

                    for cfg-name in BindsState.existing-cfg-files : Rectangle {
                        property <bool> is-current: cfg-name == BindsState.selected-existing-file;
                        height: 30px;
                        border-radius: CS2Theme.radius-xs;
                        background: is-current
                            ? CS2Theme.accent-ct-soft
                            : (cfg-item-touch.has-hover ? CS2Theme.bg-card-hover : transparent);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;

                            Text {
                                text: cfg-name;
                                font-size: 11px;
                                font-weight: is-current ? 800 : 600;
                                color: is-current ? CS2Theme.text-cyan : CS2Theme.text-primary;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            if is-current : Text {
                                text: @tr("ATIVO");
                                font-size: 8px;
                                font-weight: 900;
                                color: CS2Theme.text-cyan;
                                vertical-alignment: center;
                            }
                        }

                        cfg-item-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                BindsState.selected-existing-file = cfg-name;
                                BindsState.file-name-input = cfg-name;
                                BindsState.selector-dropdown-open = false;
                                BindsState.show-conflict-prompt = false;
                                root.sync-local-save-mode();
                                BindsState.existing-file-selected(cfg-name);
                            }
                        }
                    }
                }
            }
        }
    }
}
