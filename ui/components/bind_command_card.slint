import { CS2Theme } from "../theme.slint";

export component BindCommandCard inherits Rectangle {
    in property <string> command-title;
    in property <string> description;
    in property <bool> checked: false;
    in property <bool> featured: false;
    callback toggled(bool);

    height: max(50px, card-layout.preferred-height);
    background: root.checked
        ? (root.featured
            ? (card-touch.has-hover ? #ff771a : CS2Theme.accent-orange)
            : (card-touch.has-hover ? #0284c7 : CS2Theme.accent-ct-blue))
        : (root.featured
            ? (card-touch.has-hover ? #1e293b : CS2Theme.bg-surface-elevated)
            : (card-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card));
    border-radius: CS2Theme.radius-sm;
    border-width: root.featured ? 1.5px : 0px;
    border-color: root.featured
        ? (root.checked ? CS2Theme.accent-t-amber : CS2Theme.accent-t-gold)
        : transparent;
    clip: true;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    if root.featured : Rectangle {
        x: 0px;
        y: 0px;
        width: 4px;
        height: parent.height;
        background: root.checked ? #ffffff : CS2Theme.accent-t-amber;
    }

    card-layout := HorizontalLayout {
        width: parent.width;
        padding-left: root.featured ? 16px : 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;

        VerticalLayout {
            width: max(120px, root.width - 84px);
            spacing: 4px;

            Text {
                width: parent.width;
                text: root.command-title;
                font-size: 12px;
                font-weight: 800;
                color: root.checked ? #ffffff : (root.featured ? CS2Theme.accent-t-amber : CS2Theme.text-primary);
                wrap: word-wrap;
            }

            Text {
                width: parent.width;
                text: root.description;
                font-size: 12px;
                font-weight: 400;
                color: root.checked ? rgba(255, 255, 255, 0.92) : CS2Theme.text-muted;
                wrap: word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            width: 44px;

            Rectangle {
                width: 44px;
                height: 22px;
                background: root.checked ? #ffffff : CS2Theme.bg-surface;
                border-radius: CS2Theme.radius-xs;
                animate background { duration: 120ms; }

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    Rectangle {
                        width: 5px;
                        height: 5px;
                        border-radius: 2.5px;
                        background: root.checked
                            ? (root.featured ? CS2Theme.accent-orange : CS2Theme.accent-ct-blue)
                            : (root.featured ? CS2Theme.accent-t-amber : CS2Theme.text-dim);
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: root.checked ? @tr("ON") : @tr("OFF");
                        font-size: 8px;
                        font-weight: 900;
                        letter-spacing: 0.5px;
                        color: root.checked ? #0b0f17 : CS2Theme.text-dim;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    card-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}
