import { CS2Theme } from "../theme.slint";

export component NoProfileDialog inherits Rectangle {
    callback create-profile();
    callback close();

    width: 980px;
    height: 620px;
    background: rgba(11, 15, 23, 0.88);

    // Bloqueador de cliques de fundo para não interagir com a janela principal
    TouchArea {
        mouse-cursor: default;
    }

    // Card Centralizado Compacto
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 460px;
        height: 190px;
        background: CS2Theme.bg-card;
        border-radius: CS2Theme.radius-md;
        border-width: 1px;
        border-color: CS2Theme.accent-orange;
        clip: true;

        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            alignment: space-between;

            // Cabeçalho com Título Tático e Botão Fechar
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: CS2Theme.accent-orange;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: @tr("AVISO DE PERFIL");
                        font-size: 13px;
                        font-weight: 900;
                        letter-spacing: 0.8px;
                        color: CS2Theme.accent-orange;
                        vertical-alignment: center;
                    }
                }

                // Botão Fechar (✕)
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: CS2Theme.radius-xs;
                    background: close-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                    border-width: 1px;
                    border-color: close-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;

                    Text {
                        text: "X";
                        font-size: 11px;
                        font-weight: 800;
                        color: close-touch.has-hover ? #ffffff : CS2Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    close-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.close();
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: CS2Theme.border;
            }

            // Mensagem de Aviso Exigida
            VerticalLayout {
                spacing: 4px;

                Text {
                    text: @tr("Nenhum Perfil de Otimização encontrado, Deseja criar um?");
                    font-size: 12px;
                    font-weight: 700;
                    color: CS2Theme.text-primary;
                    wrap: word-wrap;
                }

                Text {
                    text: @tr("Configure ajustes de desempenho antes de inicializar o jogo com alta performance.");
                    font-size: 10px;
                    color: CS2Theme.text-dim;
                }
            }

            // Rodapé com os botões Sair e Criar Perfil
            HorizontalLayout {
                alignment: end;
                spacing: 12px;

                // Botão Sair (Secundário)
                Rectangle {
                    width: 100px;
                    height: 34px;
                    background: exit-touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-surface;
                    border-radius: CS2Theme.radius-sm;
                    border-width: 1px;
                    border-color: exit-touch.has-hover ? CS2Theme.border-hover : CS2Theme.border;

                    Text {
                        text: @tr("Sair");
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        color: exit-touch.has-hover ? CS2Theme.text-primary : CS2Theme.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    exit-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.close();
                        }
                    }
                }

                // Botão Criar Perfil (Primário)
                Rectangle {
                    width: 130px;
                    height: 34px;
                    background: create-touch.has-hover ? CS2Theme.accent-orange-bright : CS2Theme.accent-orange;
                    border-radius: CS2Theme.radius-sm;
                    border-width: 1px;
                    border-color: #c2410c;

                    Text {
                        text: @tr("Criar Perfil");
                        font-size: 11px;
                        font-weight: 900;
                        letter-spacing: 0.5px;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    create-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.create-profile();
                        }
                    }
                }
            }
        }
    }
}
