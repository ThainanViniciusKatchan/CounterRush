import { CS2Theme } from "../theme.slint";

export component TweakSwitch inherits Rectangle {
    in property <string> label: @tr("Otimização");
    in property <string> info: @tr("CPU Affinity");
    in property <string> tooltip-text: "";
    in property <length> tooltip-width: 215px;
    in property <color> accent-color: CS2Theme.accent-orange;
    in property <color> hover-color: #ff771a;
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <length> button-width: 0px;
    in property <length> card-height: 50px;
    in property <bool> show-inline-tooltip: true;
    in property <bool> auto-toggle: true;
    in property <bool> status-badge-mode: false;
    callback toggled(bool);
    callback blocked-click();
    callback hover-changed(bool, length, length, length, length);

    height: root.card-height;
    min-width: root.button-width > 0px ? root.button-width : 0px;
    max-width: root.button-width > 0px ? root.button-width : 10000px;
    horizontal-stretch: root.button-width > 0px ? 0 : 1;
    background: !root.enabled
        ? CS2Theme.bg-surface
        : (root.checked
            ? (touch.has-hover ? root.hover-color : root.accent-color)
            : (touch.has-hover ? CS2Theme.bg-card-hover : CS2Theme.bg-card));
    border-radius: CS2Theme.radius-sm;
    animate background { duration: 120ms; }

    HorizontalLayout {
        opacity: root.enabled ? 1.0 : 0.65;
        animate opacity { duration: 150ms; }
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                font-size: 11px;
                font-weight: 800;
                overflow: elide;
                color: root.checked ? #ffffff : CS2Theme.text-muted;
            }

            Text {
                text: root.info;
                font-size: 9px;
                overflow: elide;
                color: root.checked ? rgba(255, 255, 255, 0.85) : CS2Theme.text-dim;
            }
        }

        // Pílula Indicadora de Estado (Modo Padrão ON/OFF)
        if !root.status-badge-mode : Rectangle {
            width: 44px;
            height: 22px;
            background: root.checked ? #ffffff : CS2Theme.bg-surface;
            border-radius: CS2Theme.radius-xs;
            y: (parent.height - self.height) / 2;
            animate background { duration: 120ms; }

            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: root.checked ? root.accent-color : CS2Theme.text-dim;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.checked ? @tr("ON") : @tr("OFF");
                    font-size: 8px;
                    font-weight: 900;
                    letter-spacing: 0.5px;
                    color: root.checked ? #0b0f17 : CS2Theme.text-dim;
                    vertical-alignment: center;
                }
            }
        }

        // Selo Indicador de Estado (Modo Otimizações: Aplicado / Desativado)
        if root.status-badge-mode : Rectangle {
            min-width: 78px;
            height: 22px;
            background: root.checked ? #065f46 : CS2Theme.bg-surface;
            border-radius: CS2Theme.radius-xs;
            border-width: root.checked ? 1px : 0px;
            border-color: root.checked ? #34d399 : transparent;
            y: (parent.height - self.height) / 2;
            animate background { duration: 120ms; }
            animate border-color { duration: 120ms; }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 5px;
                alignment: center;

                Rectangle {
                    width: 5.5px;
                    height: 5.5px;
                    border-radius: 2.75px;
                    background: root.checked ? #6ee7b7 : CS2Theme.text-dim;
                    y: (parent.height - self.height) / 2;
                    animate background { duration: 120ms; }
                }

                Text {
                    text: root.checked ? @tr("Aplicado") : @tr("Desativado");
                    font-size: 8.5px;
                    font-weight: root.checked ? 900 : 800;
                    letter-spacing: 0.4px;
                    color: root.checked ? #ffffff : CS2Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Balão informativo flutuante (Tooltip) com fundo sólido e dimensionamento adaptativo
    if root.show-inline-tooltip && touch.has-hover : Rectangle {
        x: (parent.width - self.width) / 2;
        y: - self.height - 8px;
        width: clamp(inline-tooltip-content.preferred-width + 2px, 160px, max(root.tooltip-width, 280px));
        height: inline-tooltip-content.preferred-height;
        background: #0f172a;
        border-width: 1px;
        border-color: root.accent-color;
        border-radius: CS2Theme.radius-sm;
        drop-shadow-color: rgba(0, 0, 0, 0.65);
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 6px;
        z: 100;

        inline-tooltip-content := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;

            Text {
                text: root.label;
                font-size: 10px;
                font-weight: 800;
                color: root.accent-color;
                wrap: word-wrap;
            }

            Text {
                text: root.tooltip-text != "" ? root.tooltip-text : root.info;
                font-size: 9px;
                font-weight: 600;
                color: #f8fafc;
                wrap: word-wrap;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        changed has-hover => {
            root.hover-changed(
                self.has-hover,
                root.absolute-position.x,
                root.absolute-position.y,
                root.width,
                root.height
            );
        }
        clicked => {
            if root.enabled {
                if root.auto-toggle {
                    root.checked = !root.checked;
                    root.toggled(root.checked);
                } else {
                    root.toggled(!root.checked);
                }
            } else {
                root.blocked-click();
            }
        }
    }
}

export component MasterToggleSwitch inherits Rectangle {
    in-out property <bool> all-active: false;
    in property <bool> enabled: true;
    in property <length> button-width: 188px;
    in property <length> tooltip-width: 220px;
    callback toggled(bool);
    callback blocked-click();

    height: 50px;
    min-width: root.button-width;
    max-width: root.button-width;
    horizontal-stretch: 0;

    // Alternância de cor conforme o status
    property <color> active-color: CS2Theme.status-success;
    property <color> active-hover: #059669;
    property <color> inactive-color: CS2Theme.accent-orange;
    property <color> inactive-hover: #ff771a;

    background: !root.enabled
        ? root.inactive-color
        : (root.all-active
            ? (touch.has-hover ? root.active-hover : root.active-color)
            : (touch.has-hover ? root.inactive-hover : root.inactive-color));
    border-radius: CS2Theme.radius-sm;
    animate background { duration: 150ms; }

    HorizontalLayout {
        opacity: root.enabled ? 1.0 : 0.65;
        animate opacity { duration: 150ms; }
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.all-active ? @tr("Desativar Tudo") : @tr("Ativar Tudo");
                font-size: 11px;
                font-weight: 900;
                overflow: elide;
                color: #ffffff;
            }

            Text {
                text: root.all-active ? @tr("13 Módulos On") : @tr("Padrão Windows");
                font-size: 9px;
                overflow: elide;
                color: rgba(255, 255, 255, 0.9);
            }
        }

        // Pílula Indicadora de Estado Mestre
        Rectangle {
            width: 44px;
            height: 22px;
            background: #ffffff;
            border-radius: CS2Theme.radius-xs;
            y: (parent.height - self.height) / 2;
            animate background { duration: 150ms; }

            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                Rectangle {
                    width: 5px;
                    height: 5px;
                    border-radius: 2.5px;
                    background: root.all-active ? root.active-color : root.inactive-color;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.all-active ? @tr("ALL") : @tr("OFF");
                    font-size: 8px;
                    font-weight: 900;
                    letter-spacing: 0.5px;
                    color: #0b0f17;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Balão informativo flutuante (Tooltip) com fundo sólido e dimensionamento adaptativo
    if touch.has-hover : Rectangle {
        x: (parent.width - self.width) / 2;
        y: - self.height - 8px;
        width: clamp(master-tooltip-content.preferred-width + 2px, 160px, max(root.tooltip-width, 280px));
        height: master-tooltip-content.preferred-height;
        background: #0f172a;
        border-width: 1px;
        border-color: root.all-active ? root.active-color : root.inactive-color;
        border-radius: CS2Theme.radius-sm;
        drop-shadow-color: rgba(0, 0, 0, 0.65);
        drop-shadow-blur: 14px;
        drop-shadow-offset-y: 6px;
        z: 100;

        master-tooltip-content := VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 4px;

            Text {
                text: root.all-active ? @tr("Desativar Todas as Otimizações") : @tr("Ativar Todas as Otimizações");
                font-size: 10px;
                font-weight: 800;
                color: root.all-active ? root.active-color : root.inactive-color;
                wrap: word-wrap;
            }

            Text {
                text: root.all-active ? @tr("Clique para desativar todas as 13 otimizações e restaurar o padrão de fábrica do Windows.") : @tr("Clique para ativar simultaneamente todos os 13 ajustes de alta performance e baixa latência.");
                font-size: 9px;
                font-weight: 600;
                color: #f8fafc;
                wrap: word-wrap;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.all-active = !root.all-active;
                root.toggled(root.all-active);
            } else {
                root.blocked-click();
            }
        }
    }
}
