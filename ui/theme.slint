export global CS2Theme {
    // Fundos Escuros Táticos Profundos
    out property <color> bg-main: #0b0f17;
    out property <color> bg-surface: #111824;
    out property <color> bg-surface-elevated: #152030;
    out property <color> bg-card: #162132;
    out property <color> bg-card-hover: #1e2c42;
    out property <color> bg-card-selected: #24354e;

    // Bordas Táticas e Divisores
    out property <color> border: #24334a;
    out property <color> border-hover: #3b5275;
    out property <color> border-accent-orange: #ff6a00;
    out property <color> border-accent-cyan: #00a3ff;
    out property <color> border-accent-gold: #f59e0b;

    // Cores Principais CS2 (Vibrantes)
    out property <color> accent-orange: #ff6a00;
    out property <color> accent-orange-bright: #ff851b;
    out property <color> accent-orange-soft: rgba(255, 106, 0, 0.20);
    out property <color> accent-orange-glow: rgba(255, 106, 0, 0.35);

    // Contra-Terrorista (CT) Neon / Ciano
    out property <color> accent-ct-blue: #00a3ff;
    out property <color> accent-ct-cyan: #38bdf8;
    out property <color> accent-ct-soft: rgba(0, 163, 255, 0.18);

    // Terrorista (T) Ouro / Âmbar
    out property <color> accent-t-gold: #f59e0b;
    out property <color> accent-t-amber: #fbbf24;
    out property <color> accent-t-soft: rgba(245, 158, 11, 0.18);

    // Radar / Desempenho / Sucesso
    out property <color> status-success: #10b981;
    out property <color> status-success-bright: #34d399;
    out property <color> status-success-soft: rgba(16, 185, 129, 0.18);

    // Alerta / Perigo
    out property <color> status-danger: #ef4444;

    // Tipografia com Contraste
    out property <color> text-primary: #f8fafc;
    out property <color> text-muted: #94a3b8;
    out property <color> text-dim: #64748b;
    out property <color> text-orange: #ff851b;
    out property <color> text-cyan: #38bdf8;
    out property <color> text-gold: #fbbf24;
    out property <color> text-green: #34d399;

    // Espaçamentos
    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;

    // Raios Angulares Táticos
    out property <length> radius-xs: 2px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 6px;
}
